diff --git a/include/rex/graphics/gpu_stats.h b/include/rex/graphics/gpu_stats.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/gpu_stats.h
@@ -0,0 +1,67 @@
+/**
+ * @file        rex/graphics/gpu_stats.h
+ *
+ * @brief       Running totals of the GPU emulation's work, for a performance
+ *              readout in Release builds.
+ *
+ * The counters only ever grow; a reader takes two snapshots some time apart
+ * and divides the difference by the number of frames in between. Adding is a
+ * relaxed atomic increment, cheap enough for every draw. (A function, not an
+ * inline access to the counters: the totals live in the runtime library and
+ * Windows DLLs export functions, not data.)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::graphics::stats {
+
+enum class Counter : uint32_t {
+  kFrames,               // guest frames presented (swaps)
+  kDraws,                // guest draw calls
+  kResolves,             // guest resolves (EDRAM -> memory copies)
+  kReadbacks,            // resolves copied back to guest memory (readback_resolve)
+  kReadbackBytes,        //   bytes copied
+  kOcclusionQueries,     // guest occlusion queries completed
+  kGpuWaits,             // times the GPU thread blocked waiting for the host GPU
+  kGpuWaitMicros,        //   time spent blocked
+  kSubmissions,          // host command buffer submissions
+  kRenderTargetTransfers,// EDRAM ownership transfers between render targets
+  kUploadBytes,          // guest memory uploaded to the GPU's copy
+  kTextureLoads,         // textures (re)loaded from guest memory
+  kWatchFaults,          // CPU writes caught by the GPU memory write watch
+  kCount
+};
+
+struct Snapshot {
+  uint64_t values[size_t(Counter::kCount)] = {};
+  uint64_t time_us = 0;  // steady clock
+  uint64_t operator[](Counter c) const { return values[size_t(c)]; }
+};
+
+void Add(Counter counter, uint64_t amount = 1);
+
+// The current totals.
+Snapshot Read();
+
+// "draws", "resolves" ...
+const char* Name(Counter counter);
+
+// Measures how long the GPU thread blocks on the host GPU (kGpuWaits,
+// kGpuWaitMicros) for the lifetime of the object.
+class ScopedGpuWait {
+ public:
+  ScopedGpuWait();
+  ~ScopedGpuWait();
+  ScopedGpuWait(const ScopedGpuWait&) = delete;
+  ScopedGpuWait& operator=(const ScopedGpuWait&) = delete;
+
+ private:
+  uint64_t start_us_;
+};
+
+}  // namespace rex::graphics::stats
diff --git a/src/core/gpu_stats.cpp b/src/core/gpu_stats.cpp
new file mode 100644
--- /dev/null
+++ b/src/core/gpu_stats.cpp
@@ -0,0 +1,64 @@
+/**
+ * @file        core/gpu_stats.cpp
+ * @brief       See rex/graphics/gpu_stats.h.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#include <rex/graphics/gpu_stats.h>
+
+#include <atomic>
+#include <chrono>
+
+namespace rex::graphics::stats {
+
+namespace {
+std::atomic<uint64_t> g_counters[size_t(Counter::kCount)];
+
+uint64_t NowMicros() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+}  // namespace
+
+void Add(Counter counter, uint64_t amount) {
+  g_counters[size_t(counter)].fetch_add(amount, std::memory_order_relaxed);
+}
+
+Snapshot Read() {
+  Snapshot snapshot;
+  for (size_t i = 0; i < size_t(Counter::kCount); ++i)
+    snapshot.values[i] = g_counters[i].load(std::memory_order_relaxed);
+  snapshot.time_us = NowMicros();
+  return snapshot;
+}
+
+const char* Name(Counter counter) {
+  switch (counter) {
+    case Counter::kFrames: return "frames";
+    case Counter::kDraws: return "draws";
+    case Counter::kResolves: return "resolves";
+    case Counter::kReadbacks: return "readbacks";
+    case Counter::kReadbackBytes: return "readback_bytes";
+    case Counter::kOcclusionQueries: return "occlusion_queries";
+    case Counter::kGpuWaits: return "gpu_waits";
+    case Counter::kGpuWaitMicros: return "gpu_wait_us";
+    case Counter::kSubmissions: return "submissions";
+    case Counter::kRenderTargetTransfers: return "rt_transfers";
+    case Counter::kUploadBytes: return "upload_bytes";
+    case Counter::kTextureLoads: return "texture_loads";
+    case Counter::kWatchFaults: return "watch_faults";
+    case Counter::kCount: break;
+  }
+  return "?";
+}
+
+ScopedGpuWait::ScopedGpuWait() : start_us_(NowMicros()) {}
+
+ScopedGpuWait::~ScopedGpuWait() {
+  Add(Counter::kGpuWaits);
+  Add(Counter::kGpuWaitMicros, NowMicros() - start_us_);
+}
+
+}  // namespace rex::graphics::stats
