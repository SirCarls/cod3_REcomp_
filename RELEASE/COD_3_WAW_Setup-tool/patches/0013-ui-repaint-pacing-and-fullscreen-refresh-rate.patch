+  }
+  const auto period =
+      std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double>(1.0 / rate));
+  const auto next = ui_tick_last_paint_ + period;
+  auto now = Clock::now();
+  if (now < next && next - now < std::chrono::seconds(1)) {
+    std::this_thread::sleep_until(next);
