+void Window::SetFullscreenRefreshRate(double hz) {
+  hz = hz > 0.0 ? hz : 0.0;
+  if (fullscreen_refresh_rate_ == hz) {
+    return;
+  }
+  fullscreen_refresh_rate_ = hz;
+  if (!fullscreen_ || !CanApplyState()) {
+    return;
+  }
+  WindowDestructionReceiver destruction_receiver(this);
+  ApplyNewFullscreen();
+}
