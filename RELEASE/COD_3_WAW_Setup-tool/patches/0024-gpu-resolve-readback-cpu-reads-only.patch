+                      uint32_t system_page_first, uint32_t system_page_last,
+                      bool guest_can_access) {
+  std::vector<uint64_t>& pages = ReadWatchedPages(heap_base);
+  for (uint32_t i = system_page_first; i <= system_page_last && (i >> 6) < pages.size(); ++i) {
