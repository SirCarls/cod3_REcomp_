+bool IsReadWatchedPage(uint32_t heap_base, uint32_t system_page) {
+  const std::vector<uint64_t>& pages = ReadWatchedPages(heap_base);
+  return (system_page >> 6) < pages.size() &&
+         ((pages[system_page >> 6] >> (system_page & 63)) & 1) != 0;
