+  for (uint32_t view_base : {0xA0000000u, 0xC0000000u, 0xE0000000u}) {
+    const BaseHeap* heap = memory.LookupHeap(view_base);
+    if (!heap || heap->heap_type() != memory::HeapType::kGuestPhysical) {
+      continue;
