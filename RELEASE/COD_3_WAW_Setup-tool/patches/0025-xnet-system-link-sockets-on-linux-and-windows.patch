+object_ref<XSocket> LookupSocket(uint32_t socket_handle) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    SetError(wsa::kEnotsock);
+  }
+  return socket;
