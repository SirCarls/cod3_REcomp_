+uint32_t wsa_error_from_errno(int err) {
+  switch (err) {
+    case 0:
+      return 0;
+    case EINTR:
+      return wsa::kEintr;
+    case EBADF:
+      return wsa::kEbadf;
+    case EACCES:
+    case EPERM:
+      return wsa::kEacces;
+    case EFAULT:
+      return wsa::kEfault;
+    case EINVAL:
+      return wsa::kEinval;
+    case EMFILE:
+    case ENFILE:
+      return wsa::kEmfile;
+#if EWOULDBLOCK != EAGAIN
+    case EWOULDBLOCK:
+#endif
+    case EAGAIN:
+      return wsa::kEwouldblock;
+    case EINPROGRESS:
+      return wsa::kEinprogress;
+    case EALREADY:
+      return wsa::kEalready;
+    case ENOTSOCK:
+      return wsa::kEnotsock;
+    case EDESTADDRREQ:
+      return wsa::kEdestaddrreq;
+    case EMSGSIZE:
+      return wsa::kEmsgsize;
+    case EPROTOTYPE:
+      return wsa::kEprototype;
+    case ENOPROTOOPT:
+      return wsa::kEnoprotoopt;
+    case EPROTONOSUPPORT:
+      return wsa::kEprotonosupport;
+    case ESOCKTNOSUPPORT:
