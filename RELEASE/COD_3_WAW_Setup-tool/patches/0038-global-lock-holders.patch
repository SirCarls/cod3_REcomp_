@@ -60,6 +61,27 @@ size_t Read(ThreadTotals* out, size_t max_threads);
 // "guest wait", "guest sleep", "spinlock", "global lock".
 const char* Name(Wait kind);
 
+// The global lock waits of one thread, by the thread that held the lock when
+// the wait began: a thread that waits a lot says who to look at. The holder
+// is read from the lock itself, which only Linux (glibc) shows; elsewhere,
+// and past kMaxHoldersPerThread holders, it is 0 (not known).
+struct LockHolderTotals {
+  uint32_t waiter_id = 0;  // OS thread id of the thread that waited
+  uint32_t holder_id = 0;  // OS thread id of the thread holding the lock, 0 = not known
+  uint64_t wait_us = 0;
+  uint64_t waits = 0;
+};
+
+inline constexpr size_t kMaxHoldersPerThread = 12;
+
+// Adds a finished global lock wait of the calling thread (the time is also
+// added with AddWait(Wait::kGlobalLock, ...) by the caller).
+void AddLockHolderWait(uint32_t holder_id, uint64_t micros);
+
+// Copies every (waiter, holder) total so far into `out`, up to `max_pairs`;
+// returns how many were written.
+size_t ReadLockHolders(LockHolderTotals* out, size_t max_pairs);
+
 // Steady clock in microseconds (the clock these totals use).
 uint64_t NowMicros();
 
diff --git a/src/core/mutex.cpp b/src/core/mutex.cpp
index 9ecd639..038dde8 100644
--- a/src/core/mutex.cpp
+++ b/src/core/mutex.cpp
@@ -19,9 +19,36 @@ std::recursive_mutex& global_critical_region::mutex() {
   return global_mutex;
 }
 
+namespace {
+
+// The OS thread id of the thread holding the global lock, 0 if none or not
+// known. glibc keeps the owner's id in the mutex itself (it needs it for
+// recursion), so knowing it costs nothing on the uncontended path; it may
+// change before a waiter blocks, which a statistic can live with.
+uint32_t Holder() {
+#if defined(__GLIBC__)
+  return uint32_t(__atomic_load_n(&global_critical_region::mutex().native_handle()->__data.__owner,
+                                  __ATOMIC_RELAXED));
+#else
+  return 0;
+#endif
+}
+
+}  // namespace
+
 void global_critical_region::LockContended(std::unique_lock<std::recursive_mutex>& lock) {
-  thread_stats::ScopedWait waited(thread_stats::Wait::kGlobalLock);
+  uint32_t holder = Holder();
+  if (holder == 0) {
+    // Released since the first try: take it now if nobody else did, without
+    // counting a wait; else see who did.
+    if (lock.try_lock()) return;
+    holder = Holder();
+  }
+  const uint64_t start = thread_stats::NowMicros();
   lock.lock();
+  const uint64_t waited = thread_stats::NowMicros() - start;
+  thread_stats::AddWait(thread_stats::Wait::kGlobalLock, waited);
+  thread_stats::AddLockHolderWait(holder, waited);
 }
 
 }  // namespace rex::thread
