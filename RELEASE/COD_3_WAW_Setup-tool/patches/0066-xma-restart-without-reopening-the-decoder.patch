+// [cod3 0066] Restarts compared with a reopened decoder this session (each for
+// up to kRestartCheckPackets packets), and whether a difference was ever seen:
+// then every restart reopens the decoder again, as before.
+constexpr int kRestartChecks = 24;
+constexpr uint32_t kRestartCheckPackets = 8;
