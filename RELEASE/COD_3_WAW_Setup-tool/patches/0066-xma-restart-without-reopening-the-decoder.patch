+// The decoder's frames are planar float (decode_init sets AV_SAMPLE_FMT_FLTP);
+// anything else counts as different.
+bool SameFrame(const AVFrame* a, const AVFrame* b, int channels) {
+  if (a->nb_samples != b->nb_samples || a->format != b->format || a->format != AV_SAMPLE_FMT_FLTP ||
+      channels < 1 || channels > AV_NUM_DATA_POINTERS) {
+    return false;
+  }
+  const size_t bytes = static_cast<size_t>(a->nb_samples) * sizeof(float);
+  for (int c = 0; c < channels; ++c) {
+    if (!a->data[c] || !b->data[c]) {
+      return false;
+    }
+    if (std::memcmp(a->data[c], b->data[c], bytes) != 0) {
+      return false;
+    }
+  }
+  return true;
+}
