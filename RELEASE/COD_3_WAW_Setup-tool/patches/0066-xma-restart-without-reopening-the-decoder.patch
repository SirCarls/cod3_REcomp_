+// [cod3 0066] The codec's private data just after avcodec_open2, as its
+// non-zero runs of 8-byte words (zero gaps under 4 words stay inside a run;
+// the tail past the last whole word is a run of its own). Only kept while
+// restarts may use it: with xma_restart_without_reopen off (or a difference
+// seen) nothing is kept, and RestoreDecoder then leaves the restart to a reopen.
+void XmaContext::SnapshotDecoder() {
+  pristine_runs_.clear();
+  pristine_bytes_.clear();
+  pristine_size_ = 0;
+  if (!REXCVAR_GET(xma_restart_without_reopen) || restart_differs.load(std::memory_order_relaxed) ||
+      !av_context_ || !av_context_->priv_data || !av_codec_ || av_codec_->priv_data_size <= 0) {
+    return;
+  }
+  const size_t size = static_cast<size_t>(av_codec_->priv_data_size);
+  const auto* priv = static_cast<const uint8_t*>(av_context_->priv_data);
+  const size_t words = size / 8;
+  const auto nonzero = [priv](size_t w) {
+    uint64_t v;
+    std::memcpy(&v, priv + w * 8, sizeof(v));
+    return v != 0;
+  };
+  const auto add_run = [&](size_t begin, size_t end) {
+    pristine_runs_.emplace_back(static_cast<uint32_t>(begin), static_cast<uint32_t>(end - begin));
+    pristine_bytes_.insert(pristine_bytes_.end(), priv + begin, priv + end);
+  };
+  constexpr size_t kJoinGapWords = 4;
+  size_t w = 0;
+  while (w < words) {
+    if (!nonzero(w)) {
+      ++w;
+      continue;
+    }
+    const size_t start = w;
+    size_t end = w + 1;  // one past the run's last non-zero word
+    size_t j = end;
+    while (j < words) {
+      if (nonzero(j)) {
+        end = ++j;
+      } else if (j - end >= kJoinGapWords) {
+        break;
+      } else {
+        ++j;
+      }
+    }
+    add_run(start * 8, end * 8);
+    w = j;
+  }
+  if (words * 8 < size) {
+    add_run(words * 8, size);
+  }
+  pristine_size_ = size;
+}
+
+// [cod3 0066] libavcodec's own buffers flushed and the codec's private data
+// put back exactly as SnapshotDecoder saw it. Its pointers (the MDCT tables,
+// the float DSP functions, the bit writer into its own frame buffer) are the
+// same allocations, still owned by this open context, and decoding only reads
+// them (the FFT's tmp_buf is scratch, written before it is read).
+bool XmaContext::RestoreDecoder() {
+  if (!pristine_size_ || !av_context_ || !av_context_->priv_data || !av_codec_ ||
+      static_cast<size_t>(av_codec_->priv_data_size) != pristine_size_ ||
+      !avcodec_is_open(av_context_)) {
+    return false;
+  }
+  avcodec_flush_buffers(av_context_);
+  auto* priv = static_cast<uint8_t*>(av_context_->priv_data);
+  std::memset(priv, 0, pristine_size_);
+  const uint8_t* src = pristine_bytes_.data();
+  for (const auto& [offset, length] : pristine_runs_) {
+    std::memcpy(priv + offset, src, length);
+    src += length;
+  }
+  return true;
+}
+
+// [cod3 0066] For the first restarts of a session: a decoder opened afresh,
+// the way PrepareDecoder opens one, decodes the same packets beside the
+// restored one (CheckRestartedDecode).
+void XmaContext::StartRestartCheck() {
+  if (check_context_ || !av_context_ || restart_differs.load(std::memory_order_relaxed) ||
+      restart_checks_left.load(std::memory_order_relaxed) <= 0) {
+    return;
+  }
+  AVCodecContext* context = avcodec_alloc_context3(av_codec_);
+  AVFrame* frame = av_frame_alloc();
+  if (context && frame) {
+    context->sample_rate = av_context_->sample_rate;
+    context->channels = av_context_->channels;
+    context->flags2 |= AV_CODEC_FLAG2_SKIP_MANUAL;
+    if (avcodec_open2(context, av_codec_, NULL) >= 0) {
+      check_context_ = context;
+      check_frame_ = frame;
+      check_packets_left_ = kRestartCheckPackets;
+      check_compared_ = 0;
+      return;
+    }
+  }
+  if (context) {
+    avcodec_free_context(&context);
+  }
+  if (frame) {
+    av_frame_free(&frame);
+  }
+}
+
+void XmaContext::EndRestartCheck() {
+  if (check_context_ && check_compared_ > 0) {
+    const int left = restart_checks_left.fetch_sub(1, std::memory_order_relaxed) - 1;
+    const int passed = restart_checks_passed.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (left == 0 && !restart_differs.load(std::memory_order_relaxed)) {
+      REXAPU_INFO("XMA: {} restarted decoders gave the same frames as reopened ones ({} packets "
+                  "each at most); restarts put the decoder back instead of reopening it "
+                  "(xma_restart_without_reopen)",
+                  passed, kRestartCheckPackets);
+    }
+  }
+  if (check_context_) {
+    avcodec_free_context(&check_context_);
+  }
+  if (check_frame_) {
+    av_frame_free(&check_frame_);
+  }
+  check_packets_left_ = 0;
+  check_compared_ = 0;
+}
+
+// [cod3 0066] The packet just decoded by the restored decoder, decoded again by
+// the reopened one and compared bit for bit. A difference ends restarts
+// without reopening for the session, and the game gets the reopened decoder's
+// frame (and keeps that decoder), as before 0066.
+bool XmaContext::CheckRestartedDecode(bool decoded) {
+  const bool check_decoded = DecodePacket(check_context_, av_packet_, check_frame_);
+  const bool same = decoded == check_decoded &&
+                    (!decoded || SameFrame(av_frame_, check_frame_, av_context_->channels));
+  if (!same) {
+    restart_differs.store(true, std::memory_order_relaxed);
+    REXAPU_ERROR("XmaContext {}: a restarted decoder's frame differs from a reopened decoder's "
+                 "(packet {} after the restart); restarts reopen the decoder from now on "
+                 "(xma_restart_without_reopen)",
+                 id(), check_compared_ + 1);
+    std::swap(av_context_, check_context_);
+    std::swap(av_frame_, check_frame_);
+    pristine_runs_.clear();
+    pristine_bytes_.clear();
+    pristine_size_ = 0;
+    check_compared_ = 0;  // not counted as passed
+    EndRestartCheck();
+    return check_decoded;
+  }
+  ++check_compared_;
+  if (--check_packets_left_ == 0) {
+    EndRestartCheck();
+  }
+  return decoded;
+}
