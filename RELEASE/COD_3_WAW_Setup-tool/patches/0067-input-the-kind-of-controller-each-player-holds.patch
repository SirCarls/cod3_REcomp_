   return nullptr;
 }
 
+void InputSystem::UpdatePadFamily(uint32_t user_index, const std::vector<DeviceId>& ids) {
+  if (user_index >= kMaxGuestUsers) {
+    return;
+  }
+  // Pads only: a physical device, or a synthetic one that says what it is
+  // (a scripted test pad). The keyboard/mouse emulation and the NOP stand-in
+  // have no buttons of their own to show.
+  const DeviceId active = active_devices_.Active(user_index);
+  ControllerFamily family = ControllerFamily::kUnknown;
+  bool found = false;
+  for (DeviceId id : ids) {
+    const DeviceInfo* info = DeviceInfoFor(id);
+    if (!info || info->family == ControllerFamily::kKeyboardMouse ||
+        (info->synthetic && info->family == ControllerFamily::kUnknown)) {
+      continue;
+    }
+    if (!found || id == active) {
+      family = info->family;
+      found = true;
+    }
+    if (id == active) {
+      break;
+    }
+  }
+  pad_family_[user_index].store(static_cast<uint8_t>(family), std::memory_order_relaxed);
+}
+
+ControllerFamily InputSystem::PadFamily(uint32_t user_index) const {
+  if (user_index >= kMaxGuestUsers) {
+    return ControllerFamily::kUnknown;
+  }
+  return static_cast<ControllerFamily>(pad_family_[user_index].load(std::memory_order_relaxed));
+}
