@@ -22,12 +22,24 @@ constexpr uint32_t kMaxGuestUsers = 4;
 /// device took the freed slot.
 enum class DeviceId : uint64_t { kInvalid = 0 };
 
+/// What a device's buttons are labeled, so a title can show each player the
+/// glyphs of the controller in their hands. Buttons are always read by
+/// position (the bottom face button is A), whatever the label.
+enum class ControllerFamily : uint8_t {
+  kUnknown = 0,    // a generic pad, or one the backend can't name
+  kXbox,           // A B X Y, LB RB, LT RT, START BACK
+  kPlayStation,    // cross circle square triangle, L1 R1, L2 R2
+  kNintendo,       // Switch: B A Y X in Xbox's A B X Y places, L R, ZL ZR, + -
+  kKeyboardMouse,  // the keyboard and mouse emulation
+};
+
 struct DeviceInfo {
   DeviceId id = DeviceId::kInvalid;
   uint32_t ordinal = 0;  // connection order, assigned by InputSystem
   std::string name;
   std::string guid;
   bool synthetic = false;  // keyboard/mouse emulation or the NOP stand-in
+  ControllerFamily family = ControllerFamily::kUnknown;
 };
 
 }  // namespace rex::input
