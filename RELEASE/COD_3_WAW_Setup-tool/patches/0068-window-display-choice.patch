+// The displays in the system's order (empty if SDL can't list them).
+std::vector<SDL_DisplayID> DisplayIds() {
+  std::vector<SDL_DisplayID> ids;
+  int count = 0;
+  SDL_DisplayID* displays = SDL_GetDisplays(&count);
+  if (displays) {
+    ids.assign(displays, displays + std::max(count, 0));
+    SDL_free(displays);
+  }
+  return ids;
+}
+
+// A display's desktop mode in physical pixels (Wayland gives the mode in
+// logical pixels with a pixel density).
+bool DesktopSizeInPixels(SDL_DisplayID display, uint32_t* width, uint32_t* height) {
+  const SDL_DisplayMode* mode = display ? SDL_GetDesktopDisplayMode(display) : nullptr;
+  if (!mode || mode->w <= 0 || mode->h <= 0) {
+    return false;
+  }
+  const float density = mode->pixel_density > 0.0f ? mode->pixel_density : 1.0f;
+  *width = uint32_t(float(mode->w) * density + 0.5f);
+  *height = uint32_t(float(mode->h) * density + 0.5f);
+  return true;
+}
+
+// The display ListDisplays() calls index (1-based), or 0.
+SDL_DisplayID DisplayIdAt(int32_t index) {
+  const std::vector<SDL_DisplayID> ids = DisplayIds();
+  return index > 0 && size_t(index) <= ids.size() ? ids[size_t(index) - 1] : 0;
+}
+
+// One line per display, for the log (once per program, and when a choice
+// can't be found).
+std::string DescribeDisplays(const std::vector<Window::DisplayInfo>& displays) {
+  std::string text;
+  for (size_t i = 0; i < displays.size(); ++i) {
+    const Window::DisplayInfo& d = displays[i];
+    text += fmt::format("{}{} \"{}\" {}x{} at {:.2f} Hz{}", text.empty() ? "" : "; ", i + 1, d.name,
+                        d.width, d.height, d.refresh_rate, d.primary ? " (primary)" : "");
+  }
+  return text.empty() ? std::string("none listed") : text;
+}
