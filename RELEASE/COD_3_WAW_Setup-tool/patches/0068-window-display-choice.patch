+void WindowSDL::ApplyNewDisplayChoice() {
+  if (!sdl_window_) {
+    return;
+  }
+  const std::vector<DisplayInfo> displays = ListDisplays();
+  const DisplayChoice& choice = GetDisplayChoice();
+  const int32_t index = FindDisplay(choice, displays);
+  if (index <= 0) {
+    if (!choice.IsAutomatic()) {
+      REXLOG_WARN("window: display \"{}\" (number {}) isn't connected; staying on this one ({})",
+                  choice.name, choice.index, DescribeDisplays(displays));
+    }
+    return;  // automatic: stays where it is
+  }
+  const SDL_DisplayID display = DisplayIdAt(index);
+  if (!display || SDL_GetDisplayForWindow(sdl_window_) == display) {
+    return;
+  }
+  // SDL puts a fullscreen window on the display it is on: leave fullscreen,
+  // move, and go fullscreen again there (the refresh rate is looked up again
+  // for the new display). A window still waiting for its first focus
+  // (start_in_background) just moves.
+  const bool fullscreen = IsFullscreen() && !fullscreen_waits_for_focus_;
+  if (fullscreen) {
+    SDL_SetWindowFullscreen(sdl_window_, false);
+    SDL_SyncWindow(sdl_window_);
+  }
+  SDL_SetWindowPosition(sdl_window_, SDL_WINDOWPOS_CENTERED_DISPLAY(display),
+                        SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+  if (fullscreen) {
+    SDL_SyncWindow(sdl_window_);
+    ApplyFullscreenDisplayMode();
+    SDL_SetWindowFullscreen(sdl_window_, true);
+  }
+  SDL_SyncWindow(sdl_window_);
+  REXLOG_INFO("window: moved to display {} \"{}\"{}", index, displays[size_t(index) - 1].name,
+              fullscreen ? " (fullscreen there)" : "");
+}
+
+int32_t WindowSDL::GetCurrentDisplay() const {
+  const SDL_DisplayID display = sdl_window_ ? SDL_GetDisplayForWindow(sdl_window_) : 0;
+  if (!display) {
+    return 0;
+  }
+  const std::vector<SDL_DisplayID> ids = DisplayIds();
+  for (size_t i = 0; i < ids.size(); ++i) {
+    if (ids[i] == display) {
+      return int32_t(i + 1);
+    }
+  }
+  return 0;
+}
+
+bool WindowSDL::GetCurrentDisplaySize(uint32_t* width, uint32_t* height) const {
+  const SDL_DisplayID display = sdl_window_ ? SDL_GetDisplayForWindow(sdl_window_) : 0;
+  return DesktopSizeInPixels(display, width, height);
+}
