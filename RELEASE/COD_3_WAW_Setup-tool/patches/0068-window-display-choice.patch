+std::vector<Window::DisplayInfo> Window::ListDisplays() {
+  std::vector<DisplayInfo> displays;
+  const SDL_DisplayID primary = SDL_GetPrimaryDisplay();
+  for (SDL_DisplayID id : DisplayIds()) {
+    DisplayInfo info;
+    const char* name = SDL_GetDisplayName(id);
+    info.name = name && *name ? name : fmt::format("Display {}", displays.size() + 1);
+    // Two screens of the same model share a name: " #2" tells them apart.
+    int same = 1;
+    for (const DisplayInfo& earlier : displays) {
+      const std::string& n = earlier.name;
+      same += n == info.name || n.rfind(info.name + " #", 0) == 0;
+    }
+    if (same > 1) {
+      info.name += fmt::format(" #{}", same);
+    }
+    DesktopSizeInPixels(id, &info.width, &info.height);
+    if (const SDL_DisplayMode* mode = SDL_GetDesktopDisplayMode(id)) {
+      info.refresh_rate = double(mode->refresh_rate);
+    }
+    info.primary = id == primary;
+    displays.push_back(std::move(info));
+  }
+  return displays;
+}
