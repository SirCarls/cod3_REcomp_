+int32_t Window::FindDisplay(const DisplayChoice& choice, const std::vector<DisplayInfo>& displays) {
+  if (!choice.name.empty()) {
+    for (size_t i = 0; i < displays.size(); ++i) {
+      if (displays[i].name == choice.name) {
+        return int32_t(i + 1);
+      }
+    }
+    // That screen isn't connected: the system's choice, not whatever screen
+    // took its place in the order.
+    return 0;
+  }
+  // Only an index (a setting from before names): that place in the order.
+  if (choice.index > 0 && size_t(choice.index) <= displays.size()) {
+    return choice.index;
+  }
+  return 0;
+}
+
+void Window::SetDisplayChoice(const DisplayChoice& choice) {
+  if (display_choice_.name == choice.name && display_choice_.index == choice.index) {
+    return;
+  }
+  display_choice_ = choice;
+  if (!CanApplyState()) {
+    return;
+  }
+  WindowDestructionReceiver destruction_receiver(this);
+  ApplyNewDisplayChoice();
+}
 
