diff --git a/include/rex/graphics/gpu_census.h b/include/rex/graphics/gpu_census.h
new file mode 100644
index 0000000..68f5479
--- /dev/null
+++ b/include/rex/graphics/gpu_census.h
@@ -0,0 +1,55 @@
+/**
+ * @file        rex/graphics/gpu_census.h
+ *
+ * @brief       Diagnostics for replacing the GPU emulation with a host
+ *              renderer: what the game's GPU commands use (gpu_census), and
+ *              running them without drawing anything (gpu_skip_drawing).
+ *
+ * gpu_census counts, on the GPU command thread, every command packet by
+ * kind, every draw by primitive type and by the render targets it draws to,
+ * every resolve by its source and destination formats, and every shader a
+ * draw uses (its microcode hash and size, how many draws use it, and once the
+ * shader is analyzed, whether it exports to memory, kills pixels or writes
+ * depth). A summary line goes to the log every gpu_census_interval seconds;
+ * the tables at the end, and every minute into gpu_census_path if set.
+ *
+ * gpu_skip_drawing reads and answers every command as usual (registers,
+ * constants, shaders, fences, interrupts, swaps) but issues no draw and no
+ * resolve. The picture stays black. What the game then runs at is the
+ * ceiling of a host renderer that keeps the command stream but replaces the
+ * emulated GPU's drawing: the game's own threads, Direct3D's command buffer
+ * building and the stream's decoding are all that is left.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics {
+class RegisterFile;
+class Shader;
+}  // namespace rex::graphics
+
+namespace rex::graphics::census {
+
+// gpu_census or gpu_skip_drawing is on: the calls below count.
+bool Active();
+// gpu_skip_drawing is on: the command processor issues no draws or resolves.
+bool SkipDrawing();
+
+// All of these are for the GPU command thread only.
+void Type0(uint32_t registers);
+void Type3(uint32_t opcode, bool predicated, bool skipped_by_predicate);
+// A draw packet that reached the backend (RB_MODECONTROL kCopy is a resolve).
+void Draw(const RegisterFile& regs, uint32_t prim_type, bool indexed, uint32_t index_count,
+          const Shader* vertex_shader, const Shader* pixel_shader);
+// A draw dropped because a visibility query killed it.
+void KilledDraw();
+// A swap: the periodic summary line and table file.
+void Frame();
+// After the GPU command thread has stopped: the whole run's tables.
+void Report();
+
+}  // namespace rex::graphics::census
