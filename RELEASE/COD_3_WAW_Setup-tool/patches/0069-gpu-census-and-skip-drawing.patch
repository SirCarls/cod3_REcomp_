+    case xenos::PrimitiveType::kNone: return "none";
+    case xenos::PrimitiveType::kPointList: return "point list";
+    case xenos::PrimitiveType::kLineList: return "line list";
+    case xenos::PrimitiveType::kLineStrip: return "line strip";
+    case xenos::PrimitiveType::kTriangleList: return "triangle list";
+    case xenos::PrimitiveType::kTriangleFan: return "triangle fan";
+    case xenos::PrimitiveType::kTriangleStrip: return "triangle strip";
+    case xenos::PrimitiveType::kTriangleWithWFlags: return "triangle with W flags";
+    case xenos::PrimitiveType::kRectangleList: return "rectangle list";
+    case xenos::PrimitiveType::kLineLoop: return "line loop";
+    case xenos::PrimitiveType::kQuadList: return "quad list";
+    case xenos::PrimitiveType::kQuadStrip: return "quad strip";
+    case xenos::PrimitiveType::kPolygon: return "polygon";
+    case xenos::PrimitiveType::k2DCopyRectListV0: return "2D copy rect list v0";
+    case xenos::PrimitiveType::k2DCopyRectListV1: return "2D copy rect list v1";
+    case xenos::PrimitiveType::k2DCopyRectListV2: return "2D copy rect list v2";
+    case xenos::PrimitiveType::k2DCopyRectListV3: return "2D copy rect list v3";
+    case xenos::PrimitiveType::k2DFillRectList: return "2D fill rect list";
+    case xenos::PrimitiveType::k2DLineStrip: return "2D line strip";
+    case xenos::PrimitiveType::k2DTriStrip: return "2D tri strip";
+    default: return nullptr;
+  }
+}
+
+std::string PrimLabel(uint32_t prim) {
+  const char* name = PrimName(prim);
+  return name ? std::string(name) : fmt::format("prim 0x{:02X}", prim);
+}
+
