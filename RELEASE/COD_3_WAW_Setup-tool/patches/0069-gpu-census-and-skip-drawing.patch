+
+std::string OpLabel(uint32_t op) {
+  const char* name = OpName(op);
+  return name ? std::string(name) : fmt::format("type-3 0x{:02X}", op);
+}
+
+const char* EdramModeName(uint32_t mode) {
+  switch (xenos::EdramMode(mode)) {
+    case xenos::EdramMode::kNoOperation: return "no operation";
+    case xenos::EdramMode::kColorDepth: return "color+depth";
+    case xenos::EdramMode::kDepthOnly: return "depth only";
+    case xenos::EdramMode::kCopy: return "copy";
+    default: return "mode ?";
+  }
+}
+
+const char* MsaaName(uint32_t msaa) {
+  switch (msaa & 3) {
+    case 0: return "1x";
+    case 1: return "2x";
+    case 2: return "4x";
+    default: return "msaa ?";
+  }
+}
+
+Register ColorInfoRegister(uint32_t rt) { return reg::RB_COLOR_INFO::rt_register_indices[rt & 3]; }
+
+// Bits 0-1 MSAA, 2-4 EDRAM mode, then 5 bits per color target (enabled,
+// format), 25 depth/stencil used, 26 the depth format.
+uint32_t TargetKey(const RegisterFile& regs, xenos::EdramMode mode) {
+  uint32_t key = uint32_t(regs.Get<reg::RB_SURFACE_INFO>().msaa_samples) & 3;
+  key |= (uint32_t(mode) & 7) << 2;
+  if (mode == xenos::EdramMode::kColorDepth) {
+    const uint32_t mask = regs.Get<reg::RB_COLOR_MASK>().value;
+    for (uint32_t rt = 0; rt < 4; ++rt) {
+      if (!((mask >> (4 * rt)) & 0xF)) {
+        continue;
+      }
+      const auto info = regs.Get<reg::RB_COLOR_INFO>(ColorInfoRegister(rt));
+      key |= (0x10u | (uint32_t(info.color_format) & 0xF)) << (5 + 5 * rt);
+    }
+  }
+  const auto depth = regs.Get<reg::RB_DEPTHCONTROL>();
+  if (depth.z_enable || depth.stencil_enable) {
+    key |= 1u << 25;
+    key |= (uint32_t(regs.Get<reg::RB_DEPTH_INFO>().depth_format) & 1) << 26;
+  }
+  return key;
+}
+
+std::string TargetLabel(uint32_t key) {
+  std::string s = fmt::format("{} {}", MsaaName(key & 3), EdramModeName((key >> 2) & 7));
+  for (uint32_t rt = 0; rt < 4; ++rt) {
+    const uint32_t bits = (key >> (5 + 5 * rt)) & 0x1F;
+    if (bits & 0x10) {
+      s += fmt::format(" rt{} {}", rt,
+                       xenos::GetColorRenderTargetFormatName(
+                           xenos::ColorRenderTargetFormat(bits & 0xF)));
+    }
+  }
+  if (key & (1u << 25)) {
+    s += fmt::format(" depth {}", xenos::GetDepthRenderTargetFormatName(
+                                      xenos::DepthRenderTargetFormat((key >> 26) & 1)));
+  } else {
+    s += " no depth";
+  }
+  return s;
+}
+
+// Bits 0-2 the source (0-3 color target, 4 depth), 3-6 its format, 7-12 the
+// destination format, 13-15 its endianness, 16-17 MSAA, 18 color clear,
+// 19 depth clear, 20-21 the copy command, 22 red/blue swap, 23 exp bias.
+uint32_t ResolveKey(const RegisterFile& regs) {
+  const auto control = regs.Get<reg::RB_COPY_CONTROL>();
+  const auto dest = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const uint32_t source = control.copy_src_select & 7;
+  uint32_t source_format;
+  if (source < 4) {
+    source_format = uint32_t(regs.Get<reg::RB_COLOR_INFO>(ColorInfoRegister(source)).color_format);
+  } else {
+    source_format = uint32_t(regs.Get<reg::RB_DEPTH_INFO>().depth_format);
+  }
+  uint32_t key = source;
+  key |= (source_format & 0xF) << 3;
+  key |= (uint32_t(dest.copy_dest_format) & 0x3F) << 7;
+  key |= (uint32_t(dest.copy_dest_endian) & 7) << 13;
+  key |= (uint32_t(regs.Get<reg::RB_SURFACE_INFO>().msaa_samples) & 3) << 16;
+  key |= uint32_t(control.color_clear_enable) << 18;
+  key |= uint32_t(control.depth_clear_enable) << 19;
+  key |= (uint32_t(control.copy_command) & 3) << 20;
+  key |= uint32_t(dest.copy_dest_swap) << 22;
+  key |= uint32_t(dest.copy_dest_exp_bias != 0) << 23;
+  return key;
+}
+
+std::string ResolveLabel(uint32_t key) {
+  const uint32_t source = key & 7;
+  const uint32_t source_format = (key >> 3) & 0xF;
+  std::string s;
+  if (source < 4) {
+    s = fmt::format("rt{} {}", source,
+                    xenos::GetColorRenderTargetFormatName(
+                        xenos::ColorRenderTargetFormat(source_format)));
+  } else {
+    s = fmt::format("depth {}", xenos::GetDepthRenderTargetFormatName(
+                                    xenos::DepthRenderTargetFormat(source_format & 1)));
+  }
+  static constexpr const char* kCommands[] = {"raw", "convert", "constant one", "null"};
+  s += fmt::format(" -> format {} endian {} {} {}", (key >> 7) & 0x3F, (key >> 13) & 7,
+                   MsaaName((key >> 16) & 3), kCommands[(key >> 20) & 3]);
+  if (key & (1u << 18)) s += " +clear color";
+  if (key & (1u << 19)) s += " +clear depth";
+  if (key & (1u << 22)) s += " +swap";
+  if (key & (1u << 23)) s += " +exp bias";
+  return s;
+}
+
+void Note(State& s, uint32_t stage, const Shader* shader) {
+  if (!shader) {
+    return;
+  }
+  const uint64_t hash = shader->ucode_data_hash();
+  ShaderInfo* info;
+  if (shader == s.last_shader[stage] && hash == s.last_hash[stage] && s.last_info[stage]) {
+    info = s.last_info[stage];
+  } else {
+    const uint64_t key = hash ^ (uint64_t(stage) << 63);
+    auto [it, fresh] = s.shaders.try_emplace(key);
+    info = &it->second;
+    if (fresh) {
+      info->hash = hash;
+      info->stage = stage;
+      info->dwords = uint32_t(shader->ucode_dword_count());
+      info->first_frame = s.total.frames;
+      ++(stage ? s.pixel_shaders : s.vertex_shaders);
+    }
+    s.last_shader[stage] = shader;
+    s.last_hash[stage] = hash;
+    s.last_info[stage] = info;  // elements of an unordered_map keep their address
+  }
+  ++info->draws;
+  if (!info->analyzed && shader->is_ucode_analyzed()) {
+    info->analyzed = true;
+    info->memexport = shader->memexport_eM_written();
+    info->kills_pixels = shader->kills_pixels();
+    info->writes_depth = shader->writes_depth();
+  }
+}
+
+template <typename Array>
+std::vector<std::pair<uint32_t, uint64_t>> Top(const Array& now, const Array& before) {
+  std::vector<std::pair<uint32_t, uint64_t>> out;
+  for (uint32_t i = 0; i < uint32_t(now.size()); ++i) {
+    if (now[i] > before[i]) {
+      out.emplace_back(i, now[i] - before[i]);
+    }
+  }
+  std::sort(out.begin(), out.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+  return out;
+}
+
+uint64_t MemexportShaders(const State& s) {
+  uint64_t n = 0;
+  for (const auto& [key, info] : s.shaders) {
+    n += info.memexport != 0;
+  }
+  return n;
+}
+
+std::string Summary(const State& s, const Counts& before, double seconds) {
+  const Counts& now = s.total;
+  const double frames = double(std::max<uint64_t>(1, now.frames - before.frames));
+  const uint64_t draws = now.draws - before.draws;
+  auto per_frame = [&](uint64_t a, uint64_t b) { return double(a - b) / frames; };
+  std::string prims;
+  for (const auto& [prim, n] : Top(now.prims, before.prims)) {
+    if (!prims.empty()) prims += ", ";
+    prims += fmt::format("{} {:.0f}%", PrimLabel(prim), draws ? 100.0 * double(n) / double(draws) : 0.0);
+    if (prims.size() > 160) break;
+  }
+  std::string ops;
+  int shown = 0;
+  for (const auto& [op, n] : Top(now.opcodes, before.opcodes)) {
+    if (shown++ == 6) break;
+    if (!ops.empty()) ops += ", ";
+    ops += fmt::format("{} {:.0f}", OpLabel(op), double(n) / frames);
+  }
+  return fmt::format(
+      "{} frames in {:.1f} s ({:.0f} a second){}: per frame {:.0f} draws ({:.0f}% indexed, "
+      "{:.0f} indices each; {}), {:.1f} depth-only, {:.1f} resolves, {:.1f} dropped by visibility "
+      "queries, {:.0f} registers written, {:.0f} other packets ({}), {:.0f} predicated ({:.0f} of "
+      "them skipped); shaders so far {} vertex, {} pixel, {} exporting to memory",
+      now.frames - before.frames, seconds, seconds > 0 ? double(now.frames - before.frames) / seconds : 0.0,
+      SkipDrawing() ? ", drawing skipped (gpu_skip_drawing)" : "", per_frame(now.draws, before.draws),
+      draws ? 100.0 * double(now.indexed - before.indexed) / double(draws) : 0.0,
+      draws ? double(now.indices - before.indices) / double(draws) : 0.0, prims.empty() ? "none" : prims,
+      per_frame(now.depth_only, before.depth_only), per_frame(now.resolves, before.resolves),
+      per_frame(now.killed, before.killed), per_frame(now.registers, before.registers),
+      per_frame(now.type3, before.type3), ops.empty() ? "none" : ops,
+      per_frame(now.predicated, before.predicated),
+      per_frame(now.predicated_skipped, before.predicated_skipped), s.vertex_shaders,
+      s.pixel_shaders, MemexportShaders(s));
+}
+
+// The tables: draw targets, resolves, primitive types, packets, and with
+// with_shaders every shader.
+std::string Tables(const State& s, bool with_shaders) {
+  const Counts& t = s.total;
+  std::string out = fmt::format("gpu census tables: {} frames, {} draws, {} resolves\n", t.frames,
+                                t.draws, t.resolves);
+  auto sorted = [](const std::unordered_map<uint32_t, uint64_t>& map) {
+    std::vector<std::pair<uint32_t, uint64_t>> v(map.begin(), map.end());
+    std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+    return v;
+  };
+  out += "draw targets (MSAA, mode, color targets, depth): draws\n";
+  for (const auto& [key, n] : sorted(s.targets)) {
+    out += fmt::format("  {}: {} ({:.1f}%)\n", TargetLabel(key), n,
+                       t.draws ? 100.0 * double(n) / double(t.draws) : 0.0);
+  }
+  out += "resolves (source -> destination format, endianness, MSAA, command, clears): count\n";
+  for (const auto& [key, n] : sorted(s.resolves)) {
+    out += fmt::format("  {}: {} ({:.1f}%)\n", ResolveLabel(key), n,
+                       t.resolves ? 100.0 * double(n) / double(t.resolves) : 0.0);
+  }
+  Counts zero;
+  out += "primitive types: draws\n";
+  for (const auto& [prim, n] : Top(t.prims, zero.prims)) {
+    out += fmt::format("  {}: {}\n", PrimLabel(prim), n);
+  }
+  out += fmt::format("packets: {} registers written by type-0 packets; type-3 packets:\n", t.registers);
+  for (const auto& [op, n] : Top(t.opcodes, zero.opcodes)) {
+    out += fmt::format("  {}: {}\n", OpLabel(op), n);
+  }
+  out += fmt::format("  predicated: {} ({} skipped by the bin mask)\n", t.predicated,
+                     t.predicated_skipped);
+  out += fmt::format("shaders: {} vertex, {} pixel, {} exporting to memory\n", s.vertex_shaders,
+                     s.pixel_shaders, MemexportShaders(s));
+  if (with_shaders) {
+    std::vector<const ShaderInfo*> list;
+    list.reserve(s.shaders.size());
+    for (const auto& [key, info] : s.shaders) {
+      list.push_back(&info);
+    }
+    std::sort(list.begin(), list.end(), [](const ShaderInfo* a, const ShaderInfo* b) {
+      return a->draws > b->draws;
+    });
+    out += "  stage\thash\tdwords\tdraws\tfirst frame\tanalyzed\tmemexport\tkills pixels\twrites depth\n";
+    for (const ShaderInfo* info : list) {
+      out += fmt::format("  {}\t{:016X}\t{}\t{}\t{}\t{}\t{:#x}\t{}\t{}\n",
+                         info->stage ? "pixel" : "vertex", info->hash, info->dwords, info->draws,
+                         info->first_frame, info->analyzed ? "yes" : "no", info->memexport,
+                         info->kills_pixels ? "yes" : "no", info->writes_depth ? "yes" : "no");
+    }
+  }
+  return out;
+}
+
+void WriteFile(const State& s, const std::string& path_text) {
+  const std::filesystem::path path(path_text);
+  std::error_code ec;
+  if (path.has_parent_path()) {
+    std::filesystem::create_directories(path.parent_path(), ec);
+  }
+  const std::string text = Tables(s, true);
+  std::FILE* file = std::fopen(path.string().c_str(), "wb");
+  if (!file) {
+    REXGPU_WARN("gpu census: can't write {}", path.string());
+    return;
+  }
+  std::fwrite(text.data(), 1, text.size(), file);
+  std::fclose(file);
+}
+
+}  // namespace
+
+bool Active() { return REXCVAR_GET(gpu_census) || REXCVAR_GET(gpu_skip_drawing); }
+
+bool SkipDrawing() { return REXCVAR_GET(gpu_skip_drawing); }
+
+void Type0(uint32_t registers) { S().total.registers += registers; }
+
+void Type3(uint32_t opcode, bool predicated, bool skipped_by_predicate) {
+  Counts& t = S().total;
+  ++t.type3;
+  ++t.opcodes[opcode & 127];
+  if (predicated) {
+    ++t.predicated;
+    t.predicated_skipped += skipped_by_predicate;
+  }
+}
+
+void Draw(const RegisterFile& regs, uint32_t prim_type, bool indexed, uint32_t index_count,
+          const Shader* vertex_shader, const Shader* pixel_shader) {
+  State& s = S();
+  const xenos::EdramMode mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (mode == xenos::EdramMode::kCopy) {
+    ++s.total.resolves;
+    ++s.resolves[ResolveKey(regs)];
+    return;
+  }
+  ++s.total.draws;
+  s.total.indexed += indexed;
+  s.total.indices += index_count;
+  ++s.total.prims[prim_type & 63];
+  s.total.depth_only += mode == xenos::EdramMode::kDepthOnly;
+  ++s.targets[TargetKey(regs, mode)];
+  Note(s, 0, vertex_shader);
+  if (mode == xenos::EdramMode::kColorDepth) {
+    Note(s, 1, pixel_shader);
+  }
+}
+
+void KilledDraw() { ++S().total.killed; }
+
+void Frame() {
+  State& s = S();
+  ++s.total.frames;
+  const Clock::time_point now = Clock::now();
+  if (s.start == Clock::time_point{}) {
+    s.start = s.last_report = s.last_file = now;
+    s.at_report = s.total;
+    REXGPU_INFO("gpu census: counting{}", SkipDrawing() ? "; drawing skipped (gpu_skip_drawing)" : "");
+    return;
+  }
+  const auto interval = std::chrono::seconds(std::max(1, int(REXCVAR_GET(gpu_census_interval))));
+  if (now - s.last_report >= interval) {
+    const double seconds = std::chrono::duration<double>(now - s.last_report).count();
+    REXGPU_INFO("gpu census: {}", Summary(s, s.at_report, seconds));
+    s.at_report = s.total;
+    s.last_report = now;
+  }
+  const std::string path = REXCVAR_GET(gpu_census_path);
+  if (!path.empty() && now - s.last_file >= std::chrono::minutes(1)) {
+    WriteFile(s, path);
+    s.last_file = now;
+  }
+}
+
+void Report() {
+  State& s = S();
+  if (s.start == Clock::time_point{}) {
+    return;  // never counted
+  }
+  const double seconds = std::chrono::duration<double>(Clock::now() - s.start).count();
+  Counts zero;
+  REXGPU_INFO("gpu census, the whole run: {}", Summary(s, zero, seconds));
+  const std::string path = REXCVAR_GET(gpu_census_path);
+  if (!path.empty()) {
+    WriteFile(s, path);
+    REXGPU_INFO("gpu census: tables and {} shaders written to {}", s.shaders.size(), path);
+    return;
+  }
+  const std::string tables = Tables(s, false);
+  size_t begin = 0;
+  while (begin < tables.size()) {
+    size_t end = tables.find('\n', begin);
+    if (end == std::string::npos) end = tables.size();
+    REXGPU_INFO("{}", tables.substr(begin, end - begin));
+    begin = end + 1;
+  }
+}
+
+}  // namespace rex::graphics::census
