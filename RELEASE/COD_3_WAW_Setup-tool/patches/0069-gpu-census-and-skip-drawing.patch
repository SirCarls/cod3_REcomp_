+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(gpu_census, false, "GPU",
+                    "Diagnostics: count what the game's GPU commands use (packets, draws by "
+                    "primitive, render target and resolve formats, shaders). A summary line in "
+                    "the log every gpu_census_interval seconds, the tables at the end")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(gpu_skip_drawing, false, "GPU",
+                    "Diagnostics: read and answer the game's GPU commands (registers, constants, "
+                    "shaders, fences, interrupts, swaps) but draw and resolve nothing. The picture "
+                    "stays black; the frame rate is what the game runs at without the GPU "
+                    "emulation's drawing. Also counts like gpu_census")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_INT32(gpu_census_interval, 10, "GPU",
+                     "gpu_census: seconds between the summary lines in the log")
+    .range(1, 3600)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_STRING(gpu_census_path, "", "GPU",
+                      "gpu_census: a file the tables (with every shader) are written to, every "
+                      "minute and at the end; empty: the tables go to the log at the end, "
+                      "without the shader list")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace rex::graphics::census {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+struct ShaderInfo {
+  uint64_t hash = 0;
+  uint32_t stage = 0;  // 0 vertex, 1 pixel
+  uint32_t dwords = 0;
+  uint64_t draws = 0;
+  uint64_t first_frame = 0;
+  bool analyzed = false;
+  uint8_t memexport = 0;  // eM# written (a mask)
+  bool kills_pixels = false;
+  bool writes_depth = false;
+};
+
+struct Counts {
+  uint64_t frames = 0;
+  uint64_t draws = 0;
+  uint64_t indexed = 0;
+  uint64_t indices = 0;
+  uint64_t depth_only = 0;
+  uint64_t resolves = 0;
+  uint64_t killed = 0;
+  uint64_t registers = 0;
+  uint64_t type3 = 0;
+  uint64_t predicated = 0;
+  uint64_t predicated_skipped = 0;
+  std::array<uint64_t, 128> opcodes{};
+  std::array<uint64_t, 64> prims{};
+};
+
+struct State {
+  Counts total;
+  Counts at_report;
+  Clock::time_point start{};
+  Clock::time_point last_report{};
+  Clock::time_point last_file{};
+  std::unordered_map<uint32_t, uint64_t> targets;   // TargetKey -> draws
+  std::unordered_map<uint32_t, uint64_t> resolves;  // ResolveKey -> resolves
+  std::unordered_map<uint64_t, ShaderInfo> shaders;  // hash, stage in the top bit
+  std::array<const Shader*, 2> last_shader{};
+  std::array<uint64_t, 2> last_hash{};
+  std::array<ShaderInfo*, 2> last_info{};
+  uint64_t vertex_shaders = 0;
+  uint64_t pixel_shaders = 0;
+};
+
+State& S() {
+  static State state;
+  return state;
+}
+
