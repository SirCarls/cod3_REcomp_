 REXCVAR_DEFINE_UINT32(user_language, 1, "Kernel", "User's language ID");
+REXCVAR_DEFINE_STRING(user_name, "", "Kernel",
+                      "Player 1's gamertag as the game sees it (up to 15 characters); empty = the "
+                      "profile's own (\"User\")");
 
 namespace rex {
 namespace kernel {
 namespace xam {
 using namespace rex::system;
 using namespace rex::system::xam;
+
+// The name the game is given for the signed-in player: user_name when set (its first 15
+// characters, the gamertag's room), else the profile's.
+static std::string PlayerName() {
+  std::string name = REXCVAR_GET(user_name);
+  while (!name.empty() && (name.back() == ' ' || name.back() == '\t')) name.pop_back();
+  while (!name.empty() && (name.front() == ' ' || name.front() == '\t')) name.erase(name.begin());
+  if (name.empty()) return REX_KERNEL_STATE()->user_profile()->name();
+  if (name.size() > 15) name.resize(15);
+  return name;
+}
 
