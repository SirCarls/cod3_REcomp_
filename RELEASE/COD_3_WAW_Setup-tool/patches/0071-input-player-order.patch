 #include <rex/input/device_assignment.h>
 
+#include <array>
+#include <string>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_STRING(input_player_order, "", "Input",
+                      "Which player each controller plays as, in the order the controllers "
+                      "connected: up to 4 digits, the first controller's player first (\"2134\": "
+                      "the first controller is player 2, the second player 1). Controllers past "
+                      "the digits take the players left, in order. Empty or not an order (a digit "
+                      "twice, not 1-4): the connection order. The keyboard and mouse stay player 1");
+
 namespace rex::input {
 
+namespace {
+
+// The guest user of each controller ordinal: input_player_order, else the ordinal itself. Read
+// at every lookup, so a change applies at once.
+std::array<uint32_t, kMaxGuestUsers> PlayerOrder() {
+  std::array<uint32_t, kMaxGuestUsers> order{};
+  for (uint32_t i = 0; i < kMaxGuestUsers; i++) {
+    order[i] = i;
+  }
+  const std::string text = REXCVAR_GET(input_player_order);
+  std::array<uint32_t, kMaxGuestUsers> parsed = order;
+  std::array<bool, kMaxGuestUsers> used{};
+  uint32_t count = 0;
+  for (char c : text) {
+    if (c == ' ' || c == ',') {
+      continue;
+    }
+    if (c < '1' || c > '0' + static_cast<char>(kMaxGuestUsers) || count >= kMaxGuestUsers) {
+      return order;
+    }
+    const uint32_t user = static_cast<uint32_t>(c - '1');
+    if (used[user]) {
+      return order;
+    }
+    used[user] = true;
+    parsed[count++] = user;
+  }
+  for (uint32_t i = count; i < kMaxGuestUsers; i++) {
+    uint32_t user = 0;
+    while (used[user]) {
+      user++;
+    }
+    used[user] = true;
+    parsed[i] = user;
+  }
+  return parsed;
+}
