+    void Observe(uint16_t now_buttons, uint8_t left, uint8_t right, uint64_t now_ns);
+  };
+  void StartPolling();
+  void PollLoop(int rate);
+  std::mutex poll_mutex_;
+  std::array<SlotPoll, 4> slots_{};
+  std::once_flag poll_once_;
+  std::atomic<bool> polling_{false};
+  std::thread poller_;
 };
 
 }  // namespace rex::input::xinput
