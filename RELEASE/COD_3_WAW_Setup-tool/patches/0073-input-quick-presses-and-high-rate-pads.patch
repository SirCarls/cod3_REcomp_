+void XinputInputDriver::SlotPoll::Observe(uint16_t now_buttons, uint8_t left, uint8_t right,
+                                         uint64_t now_ns) {
+  latch.Buttons(buttons, now_buttons, now_ns);
+  latch.Trigger(0, left_trigger, left, now_ns);
+  latch.Trigger(1, right_trigger, right, now_ns);
+  buttons = now_buttons;
+  left_trigger = left;
+  right_trigger = right;
+}
+
+void XinputInputDriver::StartPolling() {
+  const int rate = std::clamp(REXCVAR_GET(xinput_poll_rate), 0, 8000);
+  if (rate <= 0) {
+    return;
+  }
+  std::call_once(poll_once_, [this, rate]() {
+    polling_ = true;
+    poller_ = std::thread([this, rate]() { PollLoop(rate); });
+    REXLOG_INFO("XInput: controllers read {} times a second between the game's reads.", rate);
+  });
+}
+
+void XinputInputDriver::PollLoop(int rate) {
+  const auto period = std::chrono::nanoseconds(1'000'000'000LL / rate);
+  auto next = std::chrono::steady_clock::now();
+  while (polling_) {
+    auto xigs = REXCVAR_GET(guide_button) ? (decltype(&XInputGetState))XInputGetStateEx_
+                                          : (decltype(&XInputGetState))XInputGetState_;
+    for (uint32_t i = 0; i < kXinputSlotCount && xigs; ++i) {
+      {
+        // Only the slots the game reads: an empty slot costs milliseconds.
+        std::lock_guard<std::mutex> lock(poll_mutex_);
+        if (!slots_[i].live) {
+          continue;
+        }
+      }
+      struct {
+        XINPUT_STATE state;
+        unsigned int dwPaddingReserved;
+      } native_state;
+      if (xigs(i, &native_state.state) != ERROR_SUCCESS) {
+        continue;  // the game's next read sees it and marks the slot
+      }
+      std::lock_guard<std::mutex> lock(poll_mutex_);
+      if (slots_[i].live) {
+        slots_[i].Observe(native_state.state.Gamepad.wButtons,
+                          native_state.state.Gamepad.bLeftTrigger,
+                          native_state.state.Gamepad.bRightTrigger, NowNs());
+      }
+    }
+    // A steady cadence; after a stall (the PC asleep, a debugger) start again
+    // from now instead of catching up.
+    next += period;
+    const auto now = std::chrono::steady_clock::now();
+    if (next < now) {
+      next = now + period;
+    }
+    std::this_thread::sleep_until(next);
+  }
+}
