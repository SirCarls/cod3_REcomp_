+#pragma once
+/**
+ * @file        rex/input/press_latch.h
+ * @brief       Presses that start and end between two reads of a pad.
+ *
+ * A pad that reports 1000 times a second (or a quick thumb at any rate) can
+ * press and release a button, or pull and let go of a trigger, inside the
+ * time between two of the game's reads. The state the game reads then never
+ * shows it and the press is lost. PressLatch remembers such a press and adds
+ * it to the next read, so each press is seen at least once.
+ *
+ * - A press is a button going down, or a trigger rising from below
+ *   kTriggerThreshold; a trigger's latch keeps the highest value it reached.
+ * - The first read after the press shows it, and so does every read within
+ *   kHoldNs of the press (a game that reads a pad twice in one frame sees it
+ *   both times). After that it is gone.
+ * - A press still held at a read is simply the pad's state: the latch drops it.
+ * - Nothing is delayed: a read never shows less than the pad as it is.
+ *
+ * Plain values only (no SDK types), so the drivers and a unit test share it.
+ * Not thread safe: the driver calls it under its own lock.
+ */
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace rex::input {
+
+class PressLatch {
+ public:
+  // Reads closer together than this after a press all show it.
+  static constexpr uint64_t kHoldNs = 4'000'000;
+  // XInput's trigger threshold (rex/input/state_merge.h's kTriggerThreshold).
+  static constexpr uint8_t kTriggerPressed = 30;
+
+  // The pad's buttons changed from `before` to `after` at `now_ns`.
+  void Buttons(uint16_t before, uint16_t after, uint64_t now_ns) {
+    const uint16_t down = static_cast<uint16_t>(after & ~before);
+    for (int i = 0; i < 16; ++i) {
+      if (down & (1u << i)) {
+        buttons_[i] = {now_ns, false, true};
+      }
+    }
+  }
+
+  // Trigger `which` (0 left, 1 right) moved from `before` to `after` at `now_ns`.
+  void Trigger(int which, uint8_t before, uint8_t after, uint64_t now_ns) {
+    if (which < 0 || which > 1 || after <= before) {
+      return;
+    }
+    Entry& e = triggers_[which];
+    if (e.on) {
+      peak_[which] = std::max(peak_[which], after);
+    } else if (before < kTriggerPressed) {
+      e = {now_ns, false, true};
+      peak_[which] = after;
+    }
+  }
+
+  // A read at `now_ns` of a pad that is now `buttons`, `left`, `right`:
+  // adds the presses it should still show. True when it added anything (the
+  // pad itself no longer shows it, so the next read will differ).
+  bool Apply(uint16_t& buttons, uint8_t& left, uint8_t& right, uint64_t now_ns) {
+    bool added = false;
+    for (int i = 0; i < 16; ++i) {
+      Entry& e = buttons_[i];
+      if (!e.on) {
+        continue;
+      }
+      const uint16_t bit = static_cast<uint16_t>(1u << i);
+      if (buttons & bit) {
+        e.on = false;  // still held: the pad shows it
+        continue;
+      }
+      if (Show(e, now_ns)) {
+        buttons = static_cast<uint16_t>(buttons | bit);
+        added = true;
+      }
+    }
+    uint8_t* value[2] = {&left, &right};
+    for (int t = 0; t < 2; ++t) {
+      Entry& e = triggers_[t];
+      if (!e.on) {
+        continue;
+      }
+      if (*value[t] >= peak_[t]) {
+        e.on = false;  // the pad shows as much
+        continue;
+      }
+      if (Show(e, now_ns)) {
+        *value[t] = peak_[t];
+        added = true;
+      }
+    }
+    return added;
+  }
+
+  // Forget everything (the pad was disconnected, or input went inactive).
+  void Clear() {
+    buttons_ = {};
+    triggers_ = {};
+    peak_ = {};
+  }
+
+  bool Pending() const {
+    for (const Entry& e : buttons_) {
+      if (e.on) return true;
+    }
+    return triggers_[0].on || triggers_[1].on;
+  }
+
+ private:
+  struct Entry {
+    uint64_t at_ns = 0;
+    bool shown = false;
+    bool on = false;
+  };
+
+  // Whether a read at `now_ns` shows the press; ends it once it has been
+  // shown and its hold has passed.
+  static bool Show(Entry& e, uint64_t now_ns) {
+    const bool within = now_ns < e.at_ns + kHoldNs;
+    const bool show = !e.shown || within;
+    e.shown = true;
+    if (!within) {
+      e.on = false;
+    }
+    return show;
+  }
+
+  std::array<Entry, 16> buttons_{};
+  std::array<Entry, 2> triggers_{};
+  std::array<uint8_t, 2> peak_{};
+};
+
+}  // namespace rex::input
