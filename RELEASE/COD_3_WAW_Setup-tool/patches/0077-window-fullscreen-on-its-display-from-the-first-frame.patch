+
+// A window that starts fullscreen, on X11 (0077): SDL asks the window manager
+// for fullscreen with a message once the window is mapped, so the window was
+// first shown as a window and became fullscreen a moment later.
+// _NET_WM_STATE_FULLSCREEN set on the window before it's mapped (EWMH: the
+// window manager reads the state of a window when it maps it) makes it
+// fullscreen from its first frame, on the display its position is on; SDL's
+// own request after the map then changes nothing. Added to what SDL set there.
+// False when the window isn't an X11 one.
+bool AskX11FullscreenOnMap(SDL_Window* window) {
+  SDL_PropertiesID props = SDL_GetWindowProperties(window);
+  auto* display = static_cast<Display*>(
+      SDL_GetPointerProperty(props, SDL_PROP_WINDOW_X11_DISPLAY_POINTER, nullptr));
+  auto x11_window = static_cast<::Window>(
+      SDL_GetNumberProperty(props, SDL_PROP_WINDOW_X11_WINDOW_NUMBER, 0));
+  if (!display || !x11_window) {
+    return false;
+  }
+  const Atom state = XInternAtom(display, "_NET_WM_STATE", False);
+  const Atom fullscreen = XInternAtom(display, "_NET_WM_STATE_FULLSCREEN", False);
+  if (state == None || fullscreen == None) {
+    return false;
+  }
+  Atom type = None;
+  int format = 0;
+  unsigned long count = 0;
+  unsigned long bytes_after = 0;
+  unsigned char* data = nullptr;
+  bool present = false;
+  if (XGetWindowProperty(display, x11_window, state, 0, 64, False, XA_ATOM, &type, &format, &count,
+                         &bytes_after, &data) == Success &&
+      data) {
+    const Atom* atoms = reinterpret_cast<const Atom*>(data);
+    for (unsigned long i = 0; i < count; ++i) {
+      present |= atoms[i] == fullscreen;
+    }
+    XFree(data);
+  }
+  if (!present) {
+    XChangeProperty(display, x11_window, state, XA_ATOM, 32, PropModeAppend,
+                    reinterpret_cast<const unsigned char*>(&fullscreen), 1);
+  }
   XFlush(display);
   return true;
 }
