+// A path as SDL takes it: UTF-8 (on Windows from the wide name, so a folder
+// outside the system's code page works).
+std::string PathForSdl(const std::filesystem::path& path) {
+#if defined(_WIN32)
+  const std::wstring wide = path.wstring();
+  char* utf8 = SDL_iconv_wchar_utf8(wide.c_str());
+  std::string out = utf8 ? utf8 : "";
+  SDL_free(utf8);
+  return out;
+#else
+  return path.string();
+#endif
