+
+bool IsAbsolutePath(const std::string& p) {
+  return !p.empty() && (p[0] == '/' || p[0] == '\\' ||
+                        (p.size() >= 2 && std::isalpha(static_cast<unsigned char>(p[0])) && p[1] == ':'));
+}
+
+std::string JoinPath(std::string folder, const std::string& name) {
+  if (!folder.empty() && folder.back() != '/' && folder.back() != '\\') {
+    folder += '/';
+  }
+  return folder + name;
+}
+
+// hid_mappings_file: the program's folder, then the folder above it (the
+// setup tool's bin/ layout). The first candidate when neither has it, so the
+// log names where it was looked for.
+std::string ShippedMappingsPath() {
+  const std::string value = REXCVAR_GET(hid_mappings_file);
+  if (value.empty() || IsAbsolutePath(value)) {
+    return value;
+  }
+  const std::filesystem::path exe = rex::filesystem::GetExecutableFolder();
+  std::string first;
+  for (const std::filesystem::path& folder : {exe, exe.parent_path()}) {
+    if (folder.empty()) {
+      continue;
+    }
+    const std::string candidate = JoinPath(PathForSdl(folder), value);
+    if (first.empty()) {
+      first = candidate;
+    }
+    SDL_PathInfo info;
+    if (SDL_GetPathInfo(candidate.c_str(), &info)) {
+      return candidate;
+    }
+  }
+  return first;
+}
+
+// hid_mappings_user_file: in the runtime's user data folder (else the
+// user_data_root setting), when it's a relative path.
+std::string UserMappingsPath() {
+  const std::string value = REXCVAR_GET(hid_mappings_user_file);
+  if (value.empty() || IsAbsolutePath(value)) {
+    return value;
+  }
+  std::string root;  // UTF-8, as SDL takes paths
+  if (auto* state = rex::system::kernel_state(); state && state->emulator()) {
+    const std::filesystem::path folder = state->emulator()->user_data_root();
+    if (!folder.empty()) {
+      root = PathForSdl(folder);
+    }
+  }
+  if (root.empty()) {
+    root = REXCVAR_GET(user_data_root);  // a setting's text is UTF-8 already: no std::filesystem::path in between
+  }
+  if (root.empty()) {
+    REXLOG_INFO("Controller mappings (yours): no user data folder known; only an absolute "
+                "hid_mappings_user_file is read");
+    return {};
+  }
+  return JoinPath(root, value);
+}
