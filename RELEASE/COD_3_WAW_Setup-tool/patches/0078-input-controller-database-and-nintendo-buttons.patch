+// [rexglue-native-input] 2026-11-16 hid_test_virtual_pad's helpers.
+// "12" or "12.5" (no locale: the decimal point is always '.'); false if not a number.
+bool ParseSeconds(std::string_view text, double* out) {
+  double value = 0, scale = 0;
+  bool digits = false;
+  for (const char c : text) {
+    if (c >= '0' && c <= '9') {
+      digits = true;
+      if (scale == 0) {
+        value = value * 10 + (c - '0');
+      } else {
+        value += (c - '0') * scale;
+        scale /= 10;
+      }
+    } else if (c == '.' && scale == 0) {
+      scale = 0.1;
+    } else {
+      return false;
+    }
+  }
+  *out = value;
+  return digits;
+}
