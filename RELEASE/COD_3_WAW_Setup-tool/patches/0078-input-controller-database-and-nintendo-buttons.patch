+// The mapping of the database line in `path` whose GUID is `guid`, for this
+// platform: what follows "GUID,name," up to "platform:". Empty if none.
+std::string MappingFieldsFor(const std::string& path, const char* guid) {
+  if (path.empty()) {
+    return {};
+  }
+  size_t size = 0;
+  char* data = static_cast<char*>(SDL_LoadFile(path.c_str(), &size));
+  if (!data) {
+    return {};
+  }
+  const std::string text(data, size);
+  SDL_free(data);
+  const std::string platform = std::string("platform:") + SDL_GetPlatform() + ",";
+  size_t at = 0;
+  while (at < text.size()) {
+    size_t end = text.find('\n', at);
+    if (end == std::string::npos) {
+      end = text.size();
+    }
+    std::string line = text.substr(at, end - at);
+    at = end + 1;
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    if (line.compare(0, std::strlen(guid), guid) != 0 || line.find(platform) == std::string::npos) {
+      continue;
+    }
+    const size_t c1 = line.find(',');
+    const size_t c2 = c1 == std::string::npos ? c1 : line.find(',', c1 + 1);
+    if (c2 == std::string::npos) {
+      continue;
+    }
+    std::string fields = line.substr(c2 + 1);
+    const size_t platform_at = fields.find("platform:");
+    if (platform_at != std::string::npos) {
+      fields.erase(platform_at);
+    }
+    return fields;
+  }
+  return {};
+}
