+std::string XButtonNames(uint32_t read) {
+  static const struct {
+    uint32_t bit;
+    const char* name;
+  } kNames[] = {{GDB_X_A, "A"},          {GDB_X_B, "B"},           {GDB_X_X, "X"},
+                {GDB_X_Y, "Y"},          {GDB_X_START, "START"},   {GDB_X_BACK, "BACK"},
+                {GDB_X_DPAD_UP, "UP"},   {GDB_X_DPAD_DOWN, "DOWN"}, {GDB_X_DPAD_LEFT, "LEFT"},
+                {GDB_X_DPAD_RIGHT, "RIGHT"}, {GDB_X_LEFT_SHOULDER, "LB"}, {GDB_X_RIGHT_SHOULDER, "RB"},
+                {GDB_X_LEFT_THUMB, "LS"}, {GDB_X_RIGHT_THUMB, "RS"}, {GDB_X_GUIDE, "GUIDE"},
+                {0x10000u, "LT"},        {0x20000u, "RT"}};
+  std::string out;
+  for (const auto& n : kNames) {
+    if (read & n.bit) {
+      out += out.empty() ? "" : " ";
+      out += n.name;
+    }
+  }
+  return out.empty() ? "nothing" : out;
 }
 
