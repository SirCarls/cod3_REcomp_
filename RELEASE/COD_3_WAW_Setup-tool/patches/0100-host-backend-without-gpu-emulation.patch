index 0000000..16b1225
--- /dev/null
+++ b/include/rex/graphics/host/command_processor.h
@@ -0,0 +1,62 @@
+/**
+ * @file        rex/graphics/host/command_processor.h
+ *
+ * @brief       The "host" backend's command processor: the base command
+ *              processor's ring walk, registers, fences and swaps, with every
+ *              shader, draw, resolve and swap handed to the host renderer
+ *              (rex/graphics/host_renderer.h) instead of being emulated.
+ *
+ * Built like Xenia's null backend. What the base keeps for every backend
+ * stays as it is: predication, the register file, the gamma ramps, the
+ * fences and waits, the read pointer, the occlusion queries' fixed counts.
+ * Resolves aren't copied back to guest memory (as with gpu_skip_drawing):
+ * that is the host renderer's to do.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/host_renderer.h>
+
+namespace rex::graphics::host {
+
+class HostGraphicsSystem;
+
+class HostCommandProcessor : public CommandProcessor {
+ public:
+  HostCommandProcessor(HostGraphicsSystem* graphics_system, system::KernelState* kernel_state);
+  ~HostCommandProcessor() override;
+
+  void IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                 uint32_t frontbuffer_height) override;
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                     const uint32_t* host_address, uint32_t dword_count) override;
+
+  bool IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                 IndexBufferInfo* index_buffer_info, bool major_mode_explicit) override;
+  bool IssueCopy() override;
+
+ private:
+  // The renderer while it runs (from a successful start to stop), else null.
+  const RexHostRenderer* renderer_ = nullptr;
+  // What start got; valid until stop.
+  RexHostGpu gpu_ = {};
+  // The guest's shaders by microcode hash, vertex [0] and pixel [1]. Kept for
+  // the program's life, as the Vulkan backend keeps its own: the base's
+  // active shaders point at them.
+  std::array<std::unordered_map<uint64_t, std::unique_ptr<Shader>>, 2> shaders_;
+};
+
+}  // namespace rex::graphics::host
