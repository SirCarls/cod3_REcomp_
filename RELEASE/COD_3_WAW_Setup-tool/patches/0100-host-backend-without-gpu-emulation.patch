@@ -0,0 +1,48 @@
+/**
+ * @file        rex/graphics/host/graphics_system.h
+ *
+ * @brief       The "host" backend's graphics system: the guest-visible GPU
+ *              without the GPU emulation's drawing (rex/graphics/host_renderer.h).
+ *
+ * The Vulkan provider and presenter are made as the Vulkan backend makes
+ * them, for the window, its overlays and the host renderer, which draws on
+ * that device.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/host_renderer.h>
+
+namespace rex::graphics::host {
+
+class HostGraphicsSystem : public GraphicsSystem {
+ public:
+  // renderer may be null (nothing is drawn). It is copied: the fields its
+  // struct_size covers, the others left null.
+  explicit HostGraphicsSystem(const RexHostRenderer* renderer);
+  ~HostGraphicsSystem() override;
+
+  std::string name() const override;
+
+  // The renderer the command processor uses: null when none was given or it
+  // was written for another REX_HOST_RENDERER_ABI_VERSION.
+  const RexHostRenderer* renderer() const { return has_renderer_ ? &renderer_ : nullptr; }
+
+ protected:
+  void CreateProvider(bool with_presentation) override;
+
+ private:
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override;
+
+  RexHostRenderer renderer_ = {};
+  bool has_renderer_ = false;
+};
+
+}  // namespace rex::graphics::host
diff --git a/include/rex/graphics/host_renderer.h b/include/rex/graphics/host_renderer.h
new file mode 100644
index 0000000..fea5075
--- /dev/null
+++ b/include/rex/graphics/host_renderer.h
@@ -0,0 +1,152 @@
+/**
+ * @file        rex/graphics/host_renderer.h
+ *
+ * @brief       The host renderer: what the GPU plugin's "host" backend hands
+ *              the guest's GPU work to, instead of emulating the GPU.
+ *
+ * The host backend (rexgpu-xenos with GpuCreateInfo::backend "host",
+ * rex/system/gpu_plugin.h) keeps everything the guest sees of its GPU: the
+ * registers and MMIO, the vblank interrupts, the ring buffer walk with its
+ * fences, waits, register writes and read pointer, and the gamma ramps. It
+ * draws nothing itself: no EDRAM, render-target, texture or shared-memory
+ * cache, no shader translation, no host GPU work. Each shader the guest
+ * loads, each draw, each resolve and each swap goes to the host renderer
+ * given in GpuCreateInfo::host_renderer, which draws them its own way on the
+ * plugin's Vulkan device. Without one nothing is drawn (as with
+ * gpu_skip_drawing, rex/graphics/gpu_census.h): the picture stays black.
+ *
+ * Plain C, so a renderer in another language can implement it. The rules:
+ *  - Every struct starts with struct_size. Whoever reads a struct reads only
+ *    the fields its struct_size covers, so either side can grow a struct at
+ *    its end. A change of meaning or order raises
+ *    REX_HOST_RENDERER_ABI_VERSION; a renderer written for another version
+ *    isn't used.
+ *  - Every call is made on the GPU command thread, in the guest's command
+ *    order, and returns before the next command is read. What a call's
+ *    arguments point to is valid only during the call, except the RexHostGpu
+ *    given to start, which stays valid until stop.
+ *  - During a call, the registers and the guest memory are as the guest set
+ *    them for that command. Once it returns, the guest may change them (the
+ *    next fence the backend writes lets it), so a renderer copies what it
+ *    needs before returning.
+ *  - A renderer never throws or unwinds across a call.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Raised when a struct below changes meaning or order (growing one at its end
+// doesn't need it).
+#define REX_HOST_RENDERER_ABI_VERSION 1u
+
+// RexHostShader::type (xenos::ShaderType).
+#define REX_HOST_SHADER_VERTEX 0u
+#define REX_HOST_SHADER_PIXEL 1u
+
+// What the backend gives the renderer when the GPU command thread starts.
+// Valid until stop.
+typedef struct RexHostGpu {
+  uint32_t struct_size;
+  uint32_t abi_version;  // REX_HOST_RENDERER_ABI_VERSION of the plugin
+  // Guest physical memory, physical_memory_size bytes from physical address
+  // 0. A renderer writes into it only what the guest would read back from the
+  // GPU (resolve destinations, memory exports).
+  uint8_t* physical_memory;
+  uint64_t physical_memory_size;
+  // The GPU's register file: register_count 32-bit values indexed by register
+  // number (rex/graphics/registers.h), current during every call. Read only.
+  const uint32_t* registers;
+  uint32_t register_count;
+  // The device's Vulkan version (VK_MAKE_API_VERSION); 0 when the plugin has
+  // no Vulkan device, and then all the vulkan_ fields below are 0 too.
+  uint32_t vulkan_api_version;
+  // The plugin's Vulkan objects (rex::ui::vulkan::VulkanProvider), shared
+  // with the presenter: VkInstance, VkPhysicalDevice, VkDevice and the
+  // PFN_vkGetInstanceProcAddr everything else is loaded through.
+  void* vulkan_instance;
+  void* vulkan_physical_device;
+  void* vulkan_device;
+  void* vulkan_get_instance_proc_addr;
+  // The graphics and compute queue, also the presenter's.
+  uint32_t vulkan_queue_family;
+  uint32_t vulkan_queue_index;
+  // Vulkan wants a queue's host access synchronized: hold the queue with
+  // lock_queue around each vkQueueSubmit (and anything else on the queue),
+  // then unlock_queue on the same thread. lock_queue returns the VkQueue. Both
+  // take gpu_user. They may be used from any thread.
+  void* (*lock_queue)(void* gpu_user);
+  void (*unlock_queue)(void* gpu_user);
+  void* gpu_user;
+} RexHostGpu;
+
+// A shader the guest loads for the first time (its microcode hash is new).
+typedef struct RexHostShader {
+  uint32_t struct_size;
+  uint32_t type;  // REX_HOST_SHADER_VERTEX or _PIXEL
+  // XXH3-64 of the microcode as the guest wrote it (big-endian), the name the
+  // Vulkan backend gives the same shader.
+  uint64_t hash;
+  uint32_t guest_address;  // physical
+  uint32_t dword_count;
+  const uint32_t* ucode;  // dword_count dwords, in the host's byte order
+} RexHostShader;
+
+// A draw (a draw packet whose RB_MODECONTROL isn't the copy mode). The rest of
+// its state is in the registers.
+typedef struct RexHostDraw {
+  uint32_t struct_size;
+  uint32_t primitive_type;  // xenos::PrimitiveType (VGT_DRAW_INITIATOR)
+  uint32_t index_count;     // VGT_DRAW_INITIATOR num_indices
+  // 1: the index_ fields are the index buffer; 0: auto-indexed.
+  uint32_t indexed;
+  uint32_t index_format;         // xenos::IndexFormat (0 16-bit, 1 32-bit)
+  uint32_t index_endian;         // xenos::Endian
+  uint32_t index_guest_address;  // physical
+  uint32_t index_buffer_bytes;
+  uint32_t major_mode_explicit;  // 1: VGT_DRAW_INITIATOR major mode is explicit
+  uint32_t reserved;             // 0
+  // The draw's shaders, by RexHostShader::hash; 0 if none.
+  uint64_t vertex_shader;
+  uint64_t pixel_shader;
+} RexHostDraw;
+
+// A swap: the guest shows a picture.
+typedef struct RexHostSwap {
+  uint32_t struct_size;
+  uint32_t frontbuffer_address;  // physical
+  uint32_t frontbuffer_width;
+  uint32_t frontbuffer_height;
+} RexHostSwap;
+
+// The renderer (GpuCreateInfo::host_renderer). The plugin copies it when it is
+// created; user and the functions stay valid for the program's life. Any
+// function may be null (that call isn't made).
+typedef struct RexHostRenderer {
+  uint32_t struct_size;
+  uint32_t abi_version;  // REX_HOST_RENDERER_ABI_VERSION it was written for
+  void* user;            // passed to every call
+  const char* name;      // for the log (NUL-terminated); may be null
+  // When the GPU command thread starts, before any other call. Nonzero: the
+  // renderer runs. Zero: it is never called again and nothing is drawn.
+  int32_t (*start)(void* user, const RexHostGpu* gpu);
+  // When the GPU command thread stops, after every other call. A program may
+  // end without it.
+  void (*stop)(void* user);
+  void (*shader)(void* user, const RexHostShader* shader);
+  void (*draw)(void* user, const RexHostDraw* draw);
+  // A resolve (a draw packet in RB_MODECONTROL's copy mode; RB_COPY_* and the
+  // other copy registers say what is copied where).
+  void (*resolve)(void* user);
+  void (*swap)(void* user, const RexHostSwap* swap);
+} RexHostRenderer;
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
