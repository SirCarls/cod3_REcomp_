diff --git a/src/graphics/host/command_processor.cpp b/src/graphics/host/command_processor.cpp
new file mode 100644
index 0000000..59b833e
--- /dev/null
+++ b/src/graphics/host/command_processor.cpp
@@ -0,0 +1,183 @@
+/**
+ * @file        graphics/host/command_processor.cpp
+ *
+ * @brief       The "host" backend's command processor
+ *              (rex/graphics/host/command_processor.h).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/graphics/host/command_processor.h>
+
+#include <rex/graphics/gpu_stats.h>
+#include <rex/graphics/host/graphics_system.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/hash.h>  // XXH3_64bits
+#include <rex/logging.h>
+#include <rex/system/xmemory.h>
+#include <rex/ui/vulkan/provider.h>
+
+namespace rex::graphics::host {
+
+namespace {
+
+// RexHostGpu::lock_queue / unlock_queue: the queue's own lock, the one the
+// presenter and VulkanDevice::AcquireQueue take.
+void* LockQueue(void* gpu_user) {
+  auto* queue = static_cast<ui::vulkan::VulkanDevice::Queue*>(gpu_user);
+  queue->mutex.lock();
+  return queue->queue;
+}
+
+void UnlockQueue(void* gpu_user) {
+  static_cast<ui::vulkan::VulkanDevice::Queue*>(gpu_user)->mutex.unlock();
+}
+
+}  // namespace
+
+HostCommandProcessor::HostCommandProcessor(HostGraphicsSystem* graphics_system,
+                                           system::KernelState* kernel_state)
+    : CommandProcessor(graphics_system, kernel_state) {}
+
+HostCommandProcessor::~HostCommandProcessor() = default;
+
+bool HostCommandProcessor::SetupContext() {
+  if (!CommandProcessor::SetupContext()) {
+    return false;
+  }
+  const RexHostRenderer* renderer = static_cast<HostGraphicsSystem*>(graphics_system_)->renderer();
+  if (!renderer) {
+    REXGPU_INFO(
+        "host backend: the GPU emulation is off and there is no host renderer, so nothing is "
+        "drawn (the picture stays black)");
+    return true;
+  }
+  const char* name = renderer->name ? renderer->name : "the host renderer";
+
+  gpu_ = {};
+  gpu_.struct_size = uint32_t(sizeof(gpu_));
+  gpu_.abi_version = REX_HOST_RENDERER_ABI_VERSION;
+  gpu_.physical_memory = memory_->TranslatePhysical<uint8_t*>(0);
+  gpu_.physical_memory_size = UINT64_C(0x20000000);
+  gpu_.registers = register_file_->values;
+  gpu_.register_count = uint32_t(RegisterFile::kRegisterCount);
+  auto* provider = static_cast<ui::vulkan::VulkanProvider*>(graphics_system_->provider());
+  const ui::vulkan::VulkanDevice* device = provider ? provider->vulkan_device() : nullptr;
+  if (device) {
+    const ui::vulkan::VulkanInstance* instance = device->vulkan_instance();
+    const uint32_t queue_family = device->queue_family_graphics_compute();
+    gpu_.vulkan_api_version = device->properties().apiVersion;
+    gpu_.vulkan_instance = instance->instance();
+    gpu_.vulkan_physical_device = device->physical_device();
+    gpu_.vulkan_device = device->device();
+    gpu_.vulkan_get_instance_proc_addr =
+        reinterpret_cast<void*>(instance->functions().vkGetInstanceProcAddr);
+    gpu_.vulkan_queue_family = queue_family;
+    gpu_.vulkan_queue_index = 0;
+    gpu_.lock_queue = LockQueue;
+    gpu_.unlock_queue = UnlockQueue;
+    gpu_.gpu_user = device->queue_families()[queue_family].queues[0].get();
+  }
+
+  if (!renderer->start || !renderer->start(renderer->user, &gpu_)) {
+    REXGPU_WARN("host backend: {} didn't start, so nothing is drawn (the picture stays black)",
+                name);
+    return true;
+  }
+  renderer_ = renderer;
+  REXGPU_INFO("host backend: the GPU emulation is off; {} gets the guest's draws{}", name,
+              device ? "" : " (no Vulkan device)");
+  return true;
+}
+
+void HostCommandProcessor::ShutdownContext() {
+  if (renderer_ && renderer_->stop) {
+    renderer_->stop(renderer_->user);
+  }
+  renderer_ = nullptr;
+  CommandProcessor::ShutdownContext();
+}
+
+Shader* HostCommandProcessor::LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                                         const uint32_t* host_address, uint32_t dword_count) {
+  // The same name the Vulkan backend gives the shader (its pipeline cache).
+  const uint64_t hash = XXH3_64bits(host_address, size_t(dword_count) * sizeof(uint32_t));
+  auto& shaders = shaders_[shader_type == xenos::ShaderType::kPixel ? 1 : 0];
+  if (auto it = shaders.find(hash); it != shaders.end()) {
+    return it->second.get();
+  }
+  auto made = std::make_unique<Shader>(shader_type, hash, host_address, dword_count);
+  Shader* shader = made.get();
+  shaders.emplace(hash, std::move(made));
+  if (renderer_ && renderer_->shader) {
+    RexHostShader record = {};
+    record.struct_size = uint32_t(sizeof(record));
+    record.type =
+        shader_type == xenos::ShaderType::kPixel ? REX_HOST_SHADER_PIXEL : REX_HOST_SHADER_VERTEX;
+    record.hash = hash;
+    record.guest_address = guest_address;
+    record.dword_count = uint32_t(shader->ucode_dword_count());
+    record.ucode = shader->ucode_dwords();
+    renderer_->shader(renderer_->user, &record);
+  }
+  return shader;
+}
+
+bool HostCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                                     IndexBufferInfo* index_buffer_info,
+                                     bool major_mode_explicit) {
+  const RegisterFile& regs = *register_file_;
+  if (regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy) {
+    // A resolve, as in the Vulkan backend.
+    stats::Add(stats::Counter::kResolves);
+    return IssueCopy();
+  }
+  stats::Add(stats::Counter::kDraws);
+  if (!renderer_ || !renderer_->draw) {
+    return true;
+  }
+  RexHostDraw draw = {};
+  draw.struct_size = uint32_t(sizeof(draw));
+  draw.primitive_type = uint32_t(prim_type);
+  draw.index_count = index_count;
+  if (index_buffer_info) {
+    draw.indexed = 1;
+    draw.index_format = uint32_t(index_buffer_info->format);
+    draw.index_endian = uint32_t(index_buffer_info->endianness);
+    draw.index_guest_address = index_buffer_info->guest_base;
+    draw.index_buffer_bytes = uint32_t(index_buffer_info->length);
+  }
+  draw.major_mode_explicit = major_mode_explicit ? 1 : 0;
+  const Shader* vertex_shader = active_vertex_shader();
+  const Shader* pixel_shader = active_pixel_shader();
+  draw.vertex_shader = vertex_shader ? vertex_shader->ucode_data_hash() : 0;
+  draw.pixel_shader = pixel_shader ? pixel_shader->ucode_data_hash() : 0;
+  renderer_->draw(renderer_->user, &draw);
+  return true;
+}
+
+bool HostCommandProcessor::IssueCopy() {
+  if (renderer_ && renderer_->resolve) {
+    renderer_->resolve(renderer_->user);
+  }
+  return true;
+}
+
+void HostCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                                     uint32_t frontbuffer_height) {
+  if (!renderer_ || !renderer_->swap) {
+    return;
+  }
+  RexHostSwap swap = {};
+  swap.struct_size = uint32_t(sizeof(swap));
+  swap.frontbuffer_address = frontbuffer_ptr & 0x1FFFFFFF;
+  swap.frontbuffer_width = frontbuffer_width;
+  swap.frontbuffer_height = frontbuffer_height;
+  renderer_->swap(renderer_->user, &swap);
+}
+
+}  // namespace rex::graphics::host
diff --git a/src/graphics/host/graphics_system.cpp b/src/graphics/host/graphics_system.cpp
new file mode 100644
index 0000000..aaa1453
--- /dev/null
+++ b/src/graphics/host/graphics_system.cpp
@@ -0,0 +1,64 @@
+/**
+ * @file        graphics/host/graphics_system.cpp
+ *
+ * @brief       The "host" backend's graphics system
+ *              (rex/graphics/host/graphics_system.h).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/graphics/host/graphics_system.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+
+#include <rex/graphics/host/command_processor.h>
+#include <rex/logging.h>
+#include <rex/system/kernel_state.h>
+#include <rex/ui/vulkan/provider.h>
+
+namespace rex::graphics::host {
+
+HostGraphicsSystem::HostGraphicsSystem(const RexHostRenderer* renderer) {
+  if (!renderer) {
+    return;
+  }
+  // struct_size and abi_version come first, so even a smaller table than this
+  // plugin's is read in bounds; fields it doesn't have stay null.
+  const size_t given = std::min<size_t>(renderer->struct_size, sizeof(renderer_));
+  if (given < offsetof(RexHostRenderer, user)) {
+    REXGPU_ERROR("host backend: the host renderer's table is {} bytes, too small; nothing is drawn",
+                 renderer->struct_size);
+    return;
+  }
+  if (renderer->abi_version != REX_HOST_RENDERER_ABI_VERSION) {
+    REXGPU_ERROR(
+        "host backend: the host renderer was written for interface version {}, this plugin has {}; "
+        "nothing is drawn",
+        renderer->abi_version, REX_HOST_RENDERER_ABI_VERSION);
+    return;
+  }
+  std::memcpy(&renderer_, renderer, given);
+  renderer_.struct_size = uint32_t(sizeof(renderer_));
+  has_renderer_ = true;
+}
+
+HostGraphicsSystem::~HostGraphicsSystem() = default;
+
+std::string HostGraphicsSystem::name() const {
+  return "host";
+}
+
+void HostGraphicsSystem::CreateProvider(bool with_presentation) {
+  // The same device the Vulkan backend would make: the host renderer draws
+  // the same guest work on it.
+  provider_ = rex::ui::vulkan::VulkanProvider::Create(true, with_presentation);
+}
+
+std::unique_ptr<CommandProcessor> HostGraphicsSystem::CreateCommandProcessor() {
+  return std::make_unique<HostCommandProcessor>(this, kernel_state_);
+}
+
+}  // namespace rex::graphics::host
