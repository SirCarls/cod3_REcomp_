+bool TextureCache::TakeOrRequestReplacementImage(const ReplacementImageRequest& request,
+                                                 ReplacementImageResult& result_out) {
+  std::lock_guard<std::mutex> lock(replacement_loader_mutex_);
+  auto result_it = replacement_loader_results_.find(request.id);
+  if (result_it != replacement_loader_results_.end()) {
+    result_out = std::move(result_it->second);
+    replacement_loader_result_bytes_ -= result_out.image.data.size();
+    replacement_loader_results_.erase(result_it);
+    return true;
+  }
+  if (replacement_loader_requested_.insert(request.id).second) {
+    replacement_loader_queue_.push_back(request);
+    if (!replacement_loader_thread_.joinable()) {
+      replacement_loader_stop_ = false;
+      replacement_loader_thread_ = std::thread([this]() { ReplacementLoaderThread(); });
+    }
+    replacement_loader_cv_.notify_one();
+  }
+  return false;
+}
+
+bool TextureCache::IsReplacementImageReady(uint64_t id) {
+  std::lock_guard<std::mutex> lock(replacement_loader_mutex_);
+  if (replacement_loader_results_.count(id)) {
+    return true;
+  }
+  // Neither waiting nor read (its result was dropped, see below): the texture
+  // is made again, and asks again.
+  return !replacement_loader_requested_.count(id);
+}
+
+void TextureCache::ReplacementLoaderThread() {
+  rex::thread::set_current_thread_name("Texture replacement loader");
+  // Images read but not taken within this time are dropped (their texture
+  // went out of use first); a later use reads them again. Also the most
+  // memory they may hold at once.
+  constexpr uint64_t kResultLifetimeMs = 30000;
+  constexpr uint64_t kMaxResultBytes = uint64_t(1) << 30;
+  std::unique_lock<std::mutex> lock(replacement_loader_mutex_);
+  while (true) {
+    replacement_loader_cv_.wait(
+        lock, [this]() { return replacement_loader_stop_ || !replacement_loader_queue_.empty(); });
+    if (replacement_loader_stop_) {
+      return;
+    }
+    ReplacementImageRequest request = std::move(replacement_loader_queue_.front());
+    replacement_loader_queue_.pop_front();
+    lock.unlock();
+    ReplacementImageResult result;
+    result.ok = texture_replacement::LoadDds(request.path, request.format, request.width,
+                                             request.height, request.level_count,
+                                             request.max_width_height, request.max_bytes,
+                                             result.image, result.error, &result.too_large);
+    if (!result.ok) {
+      result.image = texture_replacement::Image();
+    }
+    const uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+    result.done_time_ms = now_ms;
+    lock.lock();
+    for (auto it = replacement_loader_results_.begin(); it != replacement_loader_results_.end();) {
+      if (now_ms - it->second.done_time_ms > kResultLifetimeMs ||
+          replacement_loader_result_bytes_ + result.image.data.size() > kMaxResultBytes) {
+        replacement_loader_result_bytes_ -= it->second.image.data.size();
+        it = replacement_loader_results_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    replacement_loader_requested_.erase(request.id);
+    replacement_loader_result_bytes_ += result.image.data.size();
+    replacement_loader_results_[request.id] = std::move(result);
+    replacement_loads_done_.fetch_add(1, std::memory_order_release);
+  }
+}
+
+void TextureCache::StopReplacementLoader() {
+  {
+    std::lock_guard<std::mutex> lock(replacement_loader_mutex_);
+    replacement_loader_stop_ = true;
+  }
+  replacement_loader_cv_.notify_all();
+  if (replacement_loader_thread_.joinable()) {
+    replacement_loader_thread_.join();
+  }
+}
