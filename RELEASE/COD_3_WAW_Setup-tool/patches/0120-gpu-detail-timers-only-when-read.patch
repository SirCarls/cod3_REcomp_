 #include <cstddef>
 #include <cstdint>
 
@@ -25,8 +26,12 @@
 // 7: kTextureRequestMicros ... kTextureDestroyMicros (where the GPU thread's
 // texture time goes). 8: kResolveMicros, kRenderTargetUpdateMicros,
 // kPipelineConfigureMicros (more of the GPU thread's time, timed).
+// 9: SetDetailTimers, DetailTimersOn and ScopedDetailMicros: the timers run
+// for every draw (texture requests, uploads and creates, resolves, render
+// target updates, pipeline configuration) read the clock only while a reader
+// has turned them on.
 // A game built against any version can test this to know which counters exist.
-#define REX_GRAPHICS_STATS_VERSION 8
+#define REX_GRAPHICS_STATS_VERSION 9
 
 namespace rex::graphics::stats {
 
@@ -142,5 +147,42 @@
   Counter counter_;
   uint64_t start_us_;
 };
+
+// [claude-9b] 2026-10-27 The timers run for every draw and every resolve. A
+// heavy scene runs about 10,000 of them a frame on the GPU emulation thread
+// (three a draw); their clock reads and atomic adds were about 4% of that
+// thread in Black Baron's tank scene, and only a game's detailed slow-frame
+// log reads their counters. They time only while SetDetailTimers(true) is in
+// effect (off at start); otherwise one costs a relaxed load.
+// kGpuThreadMicros, kSubmitMicros, kShaderTranslateMicros and ScopedGpuWait
+// stay on ScopedMicros and always time.
+void SetDetailTimers(bool on);
+bool DetailTimersOn();
+// The switch itself, for ScopedDetailMicros (data in the runtime library is
+// reached through a function, as for the counters).
+const std::atomic<bool>& DetailTimersFlag();
+// The clock as the timers read it (never 0), and adding the time since such a
+// reading to a counter.
+uint64_t TimerStartMicros();
+void AddTimeSince(Counter counter, uint64_t start_us);
+
+class ScopedDetailMicros {
+ public:
+  explicit ScopedDetailMicros(Counter counter)
+      : counter_(counter), start_us_(Enabled() ? TimerStartMicros() : 0) {}
+  ~ScopedDetailMicros() {
+    if (start_us_) AddTimeSince(counter_, start_us_);
+  }
+  ScopedDetailMicros(const ScopedDetailMicros&) = delete;
+  ScopedDetailMicros& operator=(const ScopedDetailMicros&) = delete;
+
+ private:
+  static bool Enabled() {
+    static const std::atomic<bool>* const flag = &DetailTimersFlag();
+    return flag->load(std::memory_order_relaxed);
+  }
+  Counter counter_;
+  uint64_t start_us_;
+};
 
 }  // namespace rex::graphics::stats
