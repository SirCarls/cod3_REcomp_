+// [claude-9b] The switch for ScopedDetailMicros (gpu_stats.h).
+void SetDetailTimers(bool on) { g_detail_timers.store(on, std::memory_order_relaxed); }
+
+bool DetailTimersOn() { return g_detail_timers.load(std::memory_order_relaxed); }
+
+const std::atomic<bool>& DetailTimersFlag() { return g_detail_timers; }
+
+uint64_t TimerStartMicros() {
+  const uint64_t now = NowMicros();
+  return now ? now : 1;
+}
+
+void AddTimeSince(Counter counter, uint64_t start_us) { Add(counter, Since(start_us)); }
+
 }  // namespace rex::graphics::stats
