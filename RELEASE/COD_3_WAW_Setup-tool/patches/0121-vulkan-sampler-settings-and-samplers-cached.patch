+// [claude-9b] See texture_cache.h. GetSamplerParameters reads only the fetch
+// constant (six dwords), the binding's four filter overrides and
+// anisotropic_override (max_anisotropy_ and the host format table are fixed
+// once the cache exists), so its result is cached under exactly those.
+VulkanTextureCache::SamplerParameters VulkanTextureCache::GetSamplerParametersCached(
+    const VulkanShader::SamplerBinding& binding) {
+  if (!REXCVAR_GET(vulkan_sampler_cache)) {
+    return GetSamplerParameters(binding);
+  }
+  const xenos::xe_gpu_texture_fetch_t fetch =
+      register_file().GetTextureFetch(binding.fetch_constant);
+  static_assert(sizeof(fetch) == sizeof(uint32_t) * 6, "a texture fetch constant is six dwords");
+  uint32_t key[6];
+  std::memcpy(key, &fetch, sizeof(key));
+  // Bit 31 marks a filled entry (the filter fields use bits 0 to 14).
+  const uint32_t binding_filters =
+      UINT32_C(0x80000000) | uint32_t(binding.mag_filter) |
+      (uint32_t(binding.min_filter) << 4) | (uint32_t(binding.mip_filter) << 8) |
+      (uint32_t(binding.aniso_filter) << 12);
+  const int32_t anisotropic_override = REXCVAR_GET(anisotropic_override);
+  uint32_t hash = binding_filters * UINT32_C(0x9E3779B1) ^ uint32_t(anisotropic_override);
+  for (uint32_t dword : key) {
+    hash = (hash ^ dword) * UINT32_C(0x85EBCA77);
+  }
+  hash ^= hash >> 15;
+  SamplerParametersCacheEntry& entry =
+      sampler_parameters_cache_[hash >> (32 - kSamplerParametersCacheSizeLog2)];
+  if (entry.binding_filters == binding_filters &&
+      entry.anisotropic_override == anisotropic_override &&
+      !std::memcmp(entry.fetch, key, sizeof(key))) {
+    return entry.parameters;
+  }
+  const SamplerParameters parameters = GetSamplerParameters(binding);
+  std::memcpy(entry.fetch, key, sizeof(key));
+  entry.binding_filters = binding_filters;
+  entry.anisotropic_override = anisotropic_override;
+  entry.parameters = parameters;
+  return parameters;
+}
+
+VkSampler VulkanTextureCache::UseSamplerCached(SamplerParameters parameters,
+                                               bool& has_overflown_out) {
+  if (!REXCVAR_GET(vulkan_sampler_cache)) {
+    return UseSampler(parameters, has_overflown_out);
+  }
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  SamplerHandleCacheEntry& entry =
+      sampler_handle_cache_[(parameters.value * UINT32_C(0x9E3779B1)) >>
+                            (32 - kSamplerHandleCacheSizeLog2)];
+  if (entry.submission == submission && entry.parameters == parameters) {
+    has_overflown_out = false;
+    return entry.sampler;
+  }
+  const VkSampler sampler = UseSampler(parameters, has_overflown_out);
+  if (sampler != VK_NULL_HANDLE) {
+    entry.parameters = parameters;
+    entry.submission = submission;
+    entry.sampler = sampler;
+  }
+  return sampler;
+}
