+// Players 2-4 (split screen): no profile is signed in for them, so a game asks XamUserGetName and
+// shows its own "Player N" when that fails. user_name_2..4 answer it, without signing anyone in (no
+// profile reads, saves or sign-in prompts start for them): printable ASCII without quotes,
+// backslashes, '%' or '^' (format and color codes), at most 14 characters (Call of Duty 3's session
+// table keeps 15 bytes a name). Empty: no such user, as before.
+static std::string LocalPlayerName(uint32_t user_index) {
+  std::string name;
+  switch (user_index) {
+    case 1: name = REXCVAR_GET(user_name_2); break;
+    case 2: name = REXCVAR_GET(user_name_3); break;
+    case 3: name = REXCVAR_GET(user_name_4); break;
+    default: return {};
+  }
+  std::string clean;
+  for (char c : name) {
+    const unsigned char u = static_cast<unsigned char>(c);
+    if (u < 32 || u > 126 || c == '"' || c == '\\' || c == '%' || c == '^') continue;
+    clean += c;
+  }
+  while (!clean.empty() && clean.back() == ' ') clean.pop_back();
+  while (!clean.empty() && clean.front() == ' ') clean.erase(clean.begin());
+  if (clean.size() > 14) clean.resize(14);
+  return clean;
+}
