+// gpu_skip_drawing, kSettingsUnread before the first read. Active() runs for
+// every packet and draw, and each REXCVAR_GET is a call into a function with a
+// guarded static (0.9% of the GPU emulation thread in a 4-player split-screen
+// profile); RefreshSettings reads them again at every swap.
+constexpr uint32_t kSettingsUnread = 0x80;
+std::atomic<uint32_t> g_settings{kSettingsUnread};
+
+uint32_t ReadSettings() {
+  return (REXCVAR_GET(gpu_census) ? 1u : 0u) | (REXCVAR_GET(gpu_skip_drawing) ? 2u : 0u);
+}
+
+uint32_t Settings() {
+  uint32_t settings = g_settings.load(std::memory_order_relaxed);
+  if (settings & kSettingsUnread) {
+    settings = ReadSettings();
+    g_settings.store(settings, std::memory_order_relaxed);
+  }
+  return settings;
+}
+
