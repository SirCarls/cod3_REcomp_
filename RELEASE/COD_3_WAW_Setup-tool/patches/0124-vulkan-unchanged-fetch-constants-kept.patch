+// [claude-9b] 0124: games set every fetch constant of a draw again, also those
+// that stay the same; each write made the texture binding be looked up again,
+// the vertex buffer be checked again and the fetch constants be uploaded again.
+REXCVAR_DEFINE_BOOL(vulkan_skip_unchanged_fetch_constants, true, "GPU/Vulkan",
