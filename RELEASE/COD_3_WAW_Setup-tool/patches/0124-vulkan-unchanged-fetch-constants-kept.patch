 void VulkanCommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
+  // [claude-9b] 0124: whether a fetch constant keeps the value it has (read
+  // before the write below stores the new one).
+  bool fetch_constant_unchanged = skip_unchanged_fetch_constants_ &&
+                                  index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+                                  index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5 &&
+                                  register_file_->values[index] == value;
   CommandProcessor::WriteRegister(index, value);
+  if (fetch_constant_unchanged) {
+    // The texture binding, the vertex buffer and the fetch constant buffer
+    // were made from this same value, so they stay valid.
+    return;
+  }
 
   if (index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
     if (frame_open_) {
