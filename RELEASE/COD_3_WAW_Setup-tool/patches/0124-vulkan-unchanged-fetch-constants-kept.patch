   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
+    if (skip_unchanged_fetch_constants_) {
+      // [claude-9b] 0124: store only the dwords that change, and redo only
+      // what depends on them: the texture fetch constants (6 dwords each) and
+      // vertex fetch constants (2 dwords each) that hold a changed dword, and
+      // the fetch constant buffer if anything changed.
+      uint32_t first_fetch_dword = start_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
+      uint32_t* fetch_values = register_file_->values + start_index;
+      uint32_t textures_changed = 0;
+      uint64_t vertex_fetches_changed[2] = {};
+      for (uint32_t i = 0; i < num_registers; ++i) {
+        uint32_t value = memory::load_and_swap<uint32_t>(base + i);
+        if (fetch_values[i] == value) {
+          continue;
+        }
+        fetch_values[i] = value;
+        uint32_t fetch_dword = first_fetch_dword + i;
+        textures_changed |= UINT32_C(1) << (fetch_dword / 6);
+        uint32_t vfetch_index = fetch_dword / 2;
+        vertex_fetches_changed[vfetch_index >> 6] |= uint64_t(1) << (vfetch_index & 63);
+      }
+      if (!textures_changed) {
+        // Every fetch constant dword is part of a texture fetch constant, so
+        // nothing changed.
+        return;
+      }
+      current_constant_buffers_up_to_date_ &=
+          ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFetch);
+      if (texture_cache_) {
+        uint32_t textures_remaining = textures_changed;
+        while (textures_remaining) {
+          uint32_t texture_index = uint32_t(std::countr_zero(textures_remaining));
+          textures_remaining &= textures_remaining - 1;
+          texture_cache_->TextureFetchConstantWritten(texture_index);
+        }
+      }
+      for (uint32_t i = 0; i < 2; ++i) {
+        uint64_t vfetches_remaining = vertex_fetches_changed[i];
+        while (vfetches_remaining) {
+          uint32_t vfetch_index = i * 64 + uint32_t(std::countr_zero(vfetches_remaining));
+          vfetches_remaining &= vfetches_remaining - 1;
+          InvalidateVertexBufferResidency(vfetch_index);
+        }
+      }
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     current_constant_buffers_up_to_date_ &=
         ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFetch);
