+void VulkanCommandProcessor::CountRegisterWriteForStateReuse(uint32_t index, uint32_t value) {
+  if (index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+      index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
+    ++state_reuse_fetch_dwords_;
+    if (register_file_->values[index] == value) {
+      ++state_reuse_fetch_dwords_unchanged_;
+    }
+    return;
+  }
+  if (draw_state_changed_ || index < XE_GPU_REG_RB_SURFACE_INFO ||
+      index >= XE_GPU_REG_SHADER_CONSTANT_000_X || register_file_->values[index] == value) {
+    return;
+  }
+  switch (index) {
+    // Written for every draw by the draw packet, or by the game with the
+    // draw's index range and base vertex (they don't change the pipeline, the
+    // viewport or the render targets).
+    case XE_GPU_REG_VGT_MAX_VTX_INDX:
+    case XE_GPU_REG_VGT_MIN_VTX_INDX:
+    case XE_GPU_REG_VGT_INDX_OFFSET:
+    case XE_GPU_REG_VGT_EVENT_INITIATOR:
+    case XE_GPU_REG_VGT_DMA_BASE:
+    case XE_GPU_REG_VGT_DMA_SIZE:
+    case XE_GPU_REG_VGT_DRAW_INITIATOR:
+      return;
+    default:
+      draw_state_changed_ = true;
+      return;
+  }
+}
