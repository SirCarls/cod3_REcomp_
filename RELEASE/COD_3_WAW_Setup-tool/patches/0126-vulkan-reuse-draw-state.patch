+// [claude-9b] 0126: vulkan_reuse_draw_state.
+bool VulkanCommandProcessor::IsLastDrawStateReusable(xenos::PrimitiveType prim_type,
+                                                     bool major_mode_explicit) const {
+  const ReusedDrawState& last = reuse_last_;
+  if (!last.valid || reuse_state_changed_ || !submission_open_ ||
+      GetCurrentSubmission() != last.submission) {
+    return false;
+  }
+  if (active_vertex_shader() != last.active_vertex_shader ||
+      active_pixel_shader() != last.active_pixel_shader) {
+    return false;
+  }
+  // The primitive type, index source and size and major mode (the shader
+  // modifications and the pipeline depend on them); not the index count.
+  uint32_t draw_initiator_low = register_file_->values[XE_GPU_REG_VGT_DRAW_INITIATOR] & 0xFFFF;
+  if (draw_initiator_low != last.draw_initiator_low ||
+      prim_type != last.prim_type ||
+      major_mode_explicit != last.major_mode_explicit) {
+    return false;
+  }
+  // With clipping off, the render target update's height estimate may come from the vertices
+  // (execute_unclipped_draw_vs_on_cpu), which aren't tracked: always the full path.
+  if (register_file_->Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    return false;
+  }
+  // The samplers of the textures used were made from their fetch constants.
+  if (reuse_textures_changed_ & last.used_texture_mask) {
+    return false;
+  }
+  if (texture_cache_->draw_resolution_scale_x() != last.draw_resolution_scale_x ||
+      texture_cache_->draw_resolution_scale_y() != last.draw_resolution_scale_y) {
+    return false;
+  }
+  // Still bound: nothing else (a resolve, a render target transfer, the
+  // presenter) bound its own pipeline or changed the render targets since.
+  if (current_guest_graphics_pipeline_ != last.pipeline ||
+      current_guest_graphics_pipeline_layout_ != last.pipeline_layout ||
+      render_target_cache_->last_update_render_pass() != last.render_pass ||
+      render_target_cache_->last_update_framebuffer() != last.framebuffer) {
+    return false;
+  }
+  return true;
+}
+
+bool VulkanCommandProcessor::IsPrimitiveProcessingAsLastDraw(
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result) const {
+  const ReusedDrawState& last = reuse_last_;
+  return primitive_processing_result.guest_primitive_type == last.guest_primitive_type &&
+         primitive_processing_result.host_primitive_type == last.host_primitive_type &&
+         primitive_processing_result.host_vertex_shader_type == last.host_vertex_shader_type &&
+         primitive_processing_result.tessellation_mode == last.tessellation_mode &&
+         primitive_processing_result.host_primitive_reset_enabled ==
+             last.host_primitive_reset_enabled;
+}
+
+VulkanCommandProcessor::DrawStateReuse VulkanCommandProcessor::IssueDrawReusingState() {
+  const RegisterFile& regs = *register_file_;
+  const ReusedDrawState& last = reuse_last_;
+  const ui::vulkan::VulkanDevice::Properties& device_properties = GetVulkanDevice()->properties();
+
+  // The full path reports a failure here.
+  if (!BeginSubmission(true)) {
+    return DrawStateReuse::kNotReusable;
+  }
+  if (GetCurrentSubmission() != last.submission ||
+      current_guest_graphics_pipeline_ != last.pipeline ||
+      current_guest_graphics_pipeline_layout_ != last.pipeline_layout) {
+    return DrawStateReuse::kNotReusable;
+  }
+
+  // The index buffer is the draw's own. The last draw wasn't a memory export
+  // one, and with the same shaders neither is this one.
+  memexport_ranges_.clear();
+  PrimitiveProcessor::ProcessingResult primitive_processing_result;
+  if (!primitive_processor_->Process(primitive_processing_result)) {
+    return DrawStateReuse::kNotReusable;
+  }
+  if (!primitive_processing_result.host_draw_vertex_count) {
+    // Nothing to draw (as in the full path).
+    return DrawStateReuse::kDrawn;
+  }
+  if (!IsPrimitiveProcessingAsLastDraw(primitive_processing_result)) {
+    return DrawStateReuse::kNotReusable;
+  }
+
+  SetGpuSection(GpuSection::kDraws);
+
+  // Textures every draw: their contents may have changed (the same samplers,
+  // already used in this submission, stay in current_samplers_vertex_ and
+  // current_samplers_pixel_).
+  texture_cache_->RequestTextures(last.used_texture_mask);
+  if (current_guest_graphics_pipeline_ != last.pipeline ||
+      current_guest_graphics_pipeline_layout_ != last.pipeline_layout) {
+    // Loading a texture bound another graphics pipeline.
+    return DrawStateReuse::kNotReusable;
+  }
+
+  reg::RB_DEPTHCONTROL normalized_depth_control;
+  normalized_depth_control.value = last.normalized_depth_control;
+  UpdateDynamicState(last.viewport_info, last.primitive_polygonal, normalized_depth_control);
+
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  bool shader_32bit_index_dma =
+      !device_properties.fullDrawIndexUint32 &&
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA &&
+      vgt_draw_initiator.index_size == xenos::IndexFormat::kInt32 &&
+      primitive_processing_result.host_vertex_shader_type == Shader::HostVertexShaderType::kVertex;
+
+  UpdateSystemConstantValues(last.primitive_polygonal, primitive_processing_result,
+                             shader_32bit_index_dma, 0, last.viewport_info, last.used_texture_mask,
+                             normalized_depth_control, last.normalized_color_mask);
+  if (!UpdateBindings(last.vertex_shader, last.pixel_shader)) {
+    REXGPU_ERROR("Vulkan IssueDraw (reusing the last draw's state) failed at update_bindings");
+    return DrawStateReuse::kFailed;
+  }
+
+  // Vertex buffers, as in the full path (a fetch constant that isn't a valid
+  // vertex one is left to the full path, which reports it).
+  const Shader::ConstantRegisterMap& constant_map_vertex =
+      last.vertex_shader->constant_register_map();
+  for (uint32_t i = 0; i < rex::countof(constant_map_vertex.vertex_fetch_bitmap); ++i) {
+    uint32_t vfetch_bits_remaining = constant_map_vertex.vertex_fetch_bitmap[i];
+    uint32_t j;
+    while (FindFirstSetBit(vfetch_bits_remaining, &j)) {
+      vfetch_bits_remaining &= ~(uint32_t(1) << j);
+      uint32_t vfetch_index = i * 32 + j;
+      uint64_t vfetch_bit = uint64_t(1) << (vfetch_index & 63);
+      if (vertex_buffers_in_sync_[vfetch_index >> 6] & vfetch_bit) {
+        continue;
+      }
+      xenos::xe_gpu_vertex_fetch_t vfetch_constant = regs.GetVertexFetch(vfetch_index);
+      if (vfetch_constant.type != xenos::FetchConstantType::kVertex &&
+          !(vfetch_constant.type == xenos::FetchConstantType::kInvalidVertex &&
+            REXCVAR_GET(gpu_allow_invalid_fetch_constants))) {
+        return DrawStateReuse::kNotReusable;
+      }
+      VertexBufferState& state = vertex_buffer_states_[vfetch_index];
+      if (state.address == vfetch_constant.address && state.size == vfetch_constant.size) {
+        vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+        continue;
+      }
+      if (!shared_memory_->RequestRange(vfetch_constant.address << 2, vfetch_constant.size << 2)) {
+        return DrawStateReuse::kNotReusable;
+      }
+      state.address = vfetch_constant.address;
+      state.size = vfetch_constant.size;
+      vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+    }
+  }
+
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+
+  SubmitBarriersAndEnterRenderTargetCacheRenderPass(
+      render_target_cache_->last_update_render_pass(),
+      render_target_cache_->last_update_framebuffer());
+
+  if (primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kNone ||
+      shader_32bit_index_dma) {
+    deferred_command_buffer_.CmdVkDraw(primitive_processing_result.host_draw_vertex_count, 1, 0, 0);
+    return DrawStateReuse::kDrawn;
+  }
+  std::pair<VkBuffer, VkDeviceSize> index_buffer;
+  switch (primitive_processing_result.index_buffer_type) {
+    case PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA:
+      index_buffer.first = shared_memory_->buffer();
+      index_buffer.second = primitive_processing_result.guest_index_base;
+      break;
+    case PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted:
+      index_buffer = primitive_processor_->GetConvertedIndexBuffer(
+          primitive_processing_result.host_index_buffer_handle);
+      break;
+    case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForAuto:
+    case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA:
+      index_buffer = primitive_processor_->GetBuiltinIndexBuffer(
+          primitive_processing_result.host_index_buffer_handle);
+      break;
+    default:
+      REXGPU_ERROR(
+          "Vulkan IssueDraw (reusing the last draw's state): unexpected index buffer type {}",
+          uint32_t(primitive_processing_result.index_buffer_type));
+      return DrawStateReuse::kFailed;
+  }
+  deferred_command_buffer_.CmdVkBindIndexBuffer(
+      index_buffer.first, index_buffer.second,
+      primitive_processing_result.host_index_format == xenos::IndexFormat::kInt16
+          ? VK_INDEX_TYPE_UINT16
+          : VK_INDEX_TYPE_UINT32);
+  deferred_command_buffer_.CmdVkDrawIndexed(primitive_processing_result.host_draw_vertex_count, 1,
+                                            0, 0, 0);
+  return DrawStateReuse::kDrawn;
+}
+
+void VulkanCommandProcessor::VerifyReusedDrawState(const VulkanShader* pixel_shader,
+                                                   uint32_t used_texture_mask,
+                                                   reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                   uint32_t normalized_color_mask,
+                                                   const draw_util::ViewportInfo& viewport_info) {
+  const ReusedDrawState& last = reuse_last_;
+  auto samplers_match =
+      [](const std::vector<std::pair<VulkanTextureCache::SamplerParameters, VkSampler>>& current,
+         const std::vector<VkSampler>& kept) {
+        if (current.size() != kept.size()) {
+          return false;
+        }
+        for (size_t i = 0; i < kept.size(); ++i) {
+          if (current[i].second != kept[i]) {
+            return false;
+          }
+        }
+        return true;
+      };
+  ++reuse_verify_checked_;
+  const char* difference = nullptr;
+  if (pixel_shader != last.pixel_shader) {
+    difference = "pixel shader in use";
+  } else if (used_texture_mask != last.used_texture_mask) {
+    difference = "textures used";
+  } else if (normalized_depth_control.value != last.normalized_depth_control) {
+    difference = "depth control";
+  } else if (normalized_color_mask != last.normalized_color_mask) {
+    difference = "color mask";
+  } else if (current_guest_graphics_pipeline_ != last.pipeline) {
+    difference = "pipeline";
+  } else if (current_guest_graphics_pipeline_layout_ != last.pipeline_layout) {
+    difference = "pipeline layout";
+  } else if (render_target_cache_->last_update_render_pass() != last.render_pass) {
+    difference = "render pass";
+  } else if (render_target_cache_->last_update_framebuffer() != last.framebuffer) {
+    difference = "framebuffer";
+  } else if (std::memcmp(&viewport_info, &last.viewport_info, sizeof(viewport_info))) {
+    difference = "viewport";
+  } else if (!samplers_match(current_samplers_vertex_, last.samplers_vertex)) {
+    difference = "vertex shader samplers";
+  } else if (!samplers_match(current_samplers_pixel_, last.samplers_pixel)) {
+    difference = "pixel shader samplers";
+  }
+  if (!difference) {
+    return;
+  }
+  ++reuse_verify_mismatches_;
+  if (reuse_verify_logged_ < 16) {
+    ++reuse_verify_logged_;
+    REXGPU_WARN(
+        "Vulkan draw state reuse verify: the {} differs from the last draw's (vertex shader "
+        "{:016X}, pixel shader {:016X}); reusing would have drawn this draw wrong",
+        difference, last.vertex_shader ? last.vertex_shader->ucode_data_hash() : 0,
+        last.pixel_shader ? last.pixel_shader->ucode_data_hash() : 0);
+  }
+}
