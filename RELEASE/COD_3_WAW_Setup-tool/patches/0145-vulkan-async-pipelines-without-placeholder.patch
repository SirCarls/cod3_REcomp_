+// [claude-9b-think] 0145 UNTESTED: EnsurePipelineCreated on the GPU thread (a draw waiting for it),
+// timed and counted for NoteSwap's line.
+bool VulkanPipelineCache::EnsurePipelineCreatedOnGpuThread(
+    const PipelineCreationArguments& creation_arguments, VkShaderModule fragment_shader_override,
+    bool placeholder) {
+  const auto start = std::chrono::steady_clock::now();
+  const bool created = EnsurePipelineCreated(creation_arguments, fragment_shader_override);
+  const uint64_t micros = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                       std::chrono::steady_clock::now() - start)
+                                       .count());
+  ++creation_counts_.gpu_thread;
+  if (placeholder) {
+    ++creation_counts_.gpu_thread_placeholders;
+  }
+  creation_counts_.gpu_thread_micros += micros;
+  creation_counts_.gpu_thread_longest_micros =
+      std::max(creation_counts_.gpu_thread_longest_micros, micros);
+  return created;
+}
