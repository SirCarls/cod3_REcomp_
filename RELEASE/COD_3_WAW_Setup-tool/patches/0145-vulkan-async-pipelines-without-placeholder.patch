+// [claude-9b-think] 0145 UNTESTED: once a swap, on the GPU thread (VulkanCommandProcessor::IssueSwap).
+void VulkanPipelineCache::NoteSwap(uint64_t draws_left_out, bool frame_had_draws_left_out,
+                                   bool frame_not_shown) {
+  const uint64_t now_us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count());
+  CreationCounts& counts = creation_counts_;
+  ++counts.frames;
+  counts.draws_left_out += draws_left_out;
+  counts.frames_with_draws_left_out += frame_had_draws_left_out ? 1 : 0;
+  // How long the picture stayed the same: from the first frame not shown to the next one shown.
+  if (frame_not_shown) {
+    ++counts.frames_not_shown;
+    if (!not_shown_since_us_) {
+      not_shown_since_us_ = now_us;
+    }
+  } else if (not_shown_since_us_) {
+    counts.longest_hold_micros =
+        std::max(counts.longest_hold_micros, now_us - not_shown_since_us_);
+    not_shown_since_us_ = 0;
+  }
+  const int32_t seconds = REXCVAR_GET(vulkan_pipeline_stats_seconds);
+  if (seconds <= 0 || !creation_counts_log_time_us_) {
+    // Off, or the first swap: a new count from now.
+    counts = CreationCounts();
+    thread_created_.store(0, std::memory_order_relaxed);
+    thread_created_micros_.store(0, std::memory_order_relaxed);
+    creation_counts_log_time_us_ = seconds > 0 ? now_us : 0;
+    return;
+  }
+  if (now_us - creation_counts_log_time_us_ < uint64_t(seconds) * 1000000) {
+    return;
+  }
+  const uint64_t thread_made = thread_created_.exchange(0, std::memory_order_relaxed);
+  const uint64_t thread_micros = thread_created_micros_.exchange(0, std::memory_order_relaxed);
+  if (counts.gpu_thread || counts.queued || thread_made || counts.draws_left_out ||
+      counts.frames_not_shown) {
+    REXGPU_INFO(
+        "Vulkan pipelines over {:.1f} s ({} frames): {} made on the GPU thread while the frame "
+        "waited ({} of them placeholders, {} at submission ends; {:.1f} ms, the longest {:.1f} ms); "
+        "submission ends {:.1f} ms making and waiting for pipelines, the longest {:.1f} ms; {} "
+        "handed to the pipeline threads ({} without a placeholder), {} made there ({:.1f} ms); {} "
+        "draws left out while their pipeline was made, in {} frames; {} frames not shown, the "
+        "longest hold {:.1f} ms",
+        double(now_us - creation_counts_log_time_us_) / 1e6, counts.frames, counts.gpu_thread,
+        counts.gpu_thread_placeholders, counts.at_submission,
+        double(counts.gpu_thread_micros) / 1000.0,
+        double(counts.gpu_thread_longest_micros) / 1000.0,
+        double(counts.submission_stall_micros) / 1000.0,
+        double(counts.submission_stall_longest_micros) / 1000.0, counts.queued,
+        counts.queued_without_placeholder, thread_made, double(thread_micros) / 1000.0,
+        counts.draws_left_out, counts.frames_with_draws_left_out, counts.frames_not_shown,
+        double(counts.longest_hold_micros) / 1000.0);
+  }
+  counts = CreationCounts();
+  creation_counts_log_time_us_ = now_us;
+}

