+// [claude-9b-think] 0146 UNTESTED: see the header.
+bool TextureCache::PutOffReplacementSwap() {
+  if (!replacement_frame_made_) {
+    return false;  // at least one a frame
+  }
+  const int32_t max_count = REXCVAR_GET(texture_replacement_frame_count);
+  const int32_t max_mb = REXCVAR_GET(texture_replacement_frame_mb);
+  if ((max_count > 0 && replacement_frame_made_ >= uint32_t(max_count)) ||
+      (max_mb > 0 && replacement_frame_bytes_ >= (uint64_t(max_mb) << 20))) {
+    ++replacement_costs_.put_off;
+    return true;
+  }
+  return false;
+}
+
+void TextureCache::LogReplacementCostsIfDue() {
+  const int32_t seconds = REXCVAR_GET(texture_replacement_stats_seconds);
+  const uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count());
+  if (seconds <= 0 || !replacement_costs_log_time_ms_) {
+    // Off, or the first frame: a new count from now.
+    replacement_costs_ = ReplacementCosts();
+    replacement_costs_log_time_ms_ = seconds > 0 ? now_ms : 0;
+    return;
+  }
+  if (now_ms - replacement_costs_log_time_ms_ < uint64_t(seconds) * 1000) {
+    return;
+  }
+  const ReplacementCosts& costs = replacement_costs_;
+  if (costs.made || costs.put_off) {
+    REXGPU_INFO(
+        "Replacement (HD) textures over {:.1f} s: {} made on the GPU thread, {:.1f} MB, {:.1f} ms "
+        "(the longest {:.1f} ms; staging buffers {:.1f} ms, copying into them {:.1f} ms, the "
+        "textures {:.1f} ms; staging buffers freed later {:.1f} ms); {} put off to a later frame",
+        double(now_ms - replacement_costs_log_time_ms_) / 1000.0, costs.made,
+        double(costs.bytes) / (1024.0 * 1024.0), double(costs.micros) / 1000.0,
+        double(costs.longest_micros) / 1000.0, double(costs.staging_micros) / 1000.0,
+        double(costs.copy_micros) / 1000.0, double(costs.image_micros) / 1000.0,
+        double(costs.free_micros) / 1000.0, costs.put_off);
+  }
+  replacement_costs_ = ReplacementCosts();
+  replacement_costs_log_time_ms_ = now_ms;
+}

