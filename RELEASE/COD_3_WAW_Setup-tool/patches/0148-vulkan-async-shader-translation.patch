+// [claude-9b-think] 0148 UNTESTED: shader translation off the GPU thread. The states of
+// VulkanTranslation::async_translation_state.
+namespace {
+constexpr uint8_t kTranslationIdle = 0;
+constexpr uint8_t kTranslationInFlight = 1;
+constexpr uint8_t kTranslationDone = 2;
+}  // namespace
+
+VulkanPipelineCache::ShaderTranslationResult VulkanPipelineCache::RequestShadersTranslated(
+    VulkanShader::VulkanTranslation* vertex_shader, VulkanShader::VulkanTranslation* pixel_shader) {
+  const bool async = REXCVAR_GET(vulkan_async_shader_translation) &&
+                     REXCVAR_GET(async_shader_compilation) && translation_thread_ != nullptr;
+  bool in_flight = false;
+  bool queued = false;
+  bool untranslated = false;
+  for (VulkanShader::VulkanTranslation* translation : {vertex_shader, pixel_shader}) {
+    if (!translation) {
+      continue;
+    }
+    uint8_t state = translation->async_translation_state.load(std::memory_order_acquire);
+    if (state == kTranslationDone) {
+      // Made on the translation thread (its writes seen through the acquire load): the shader's
+      // binding layout UIDs are this thread's to set up, once per shader.
+      if (translation->is_valid() && translation->shader_module() != VK_NULL_HANDLE) {
+        SetUpBindingLayoutUIDs(static_cast<VulkanShader&>(translation->shader()));
+      }
+      translation->async_translation_state.store(kTranslationIdle, std::memory_order_relaxed);
+      state = kTranslationIdle;
+    }
+    if (state == kTranslationInFlight) {
+      // Also when the setting was turned off since: the translation thread finishes it.
+      in_flight = true;
+      continue;
+    }
+    if (translation->is_translated()) {
+      continue;
+    }
+    if (!async) {
+      untranslated = true;
+      continue;
+    }
+    translation->async_translation_state.store(kTranslationInFlight, std::memory_order_relaxed);
+    translations_in_flight_.fetch_add(1, std::memory_order_relaxed);
+    {
+      std::lock_guard<std::mutex> lock(translation_lock_);
+      translation_queue_.push_back(translation);
+    }
+    queued = true;
+    in_flight = true;
+    ++creation_counts_.translations_queued;
+  }
+  if (queued) {
+    translation_cond_.notify_one();
+  }
+  // Off, with translations of other shaders still on the translation thread (just turned off): this
+  // one waits too, so no translation is made here while one may be filling a shader's bindings there.
+  if (untranslated && translations_in_flight_.load(std::memory_order_acquire) != 0) {
+    in_flight = true;
+  }
+  if (in_flight) {
+    ++creation_counts_.draws_waiting_translation;
+    return ShaderTranslationResult::kPending;
+  }
+  if (!async) {
+    // As before: translated here if needed, the draw waiting; the same checks as before.
+    return EnsureShadersTranslated(vertex_shader, pixel_shader) ? ShaderTranslationResult::kReady
+                                                                : ShaderTranslationResult::kFailed;
+  }
+  for (VulkanShader::VulkanTranslation* translation : {vertex_shader, pixel_shader}) {
+    if (translation &&
+        (!translation->is_valid() || translation->shader_module() == VK_NULL_HANDLE)) {
+      return ShaderTranslationResult::kFailed;
+    }
+  }
+  return ShaderTranslationResult::kReady;
+}
+
+std::unique_ptr<SpirvShaderTranslator> VulkanPipelineCache::CreateShaderTranslator() {
+  return std::make_unique<SpirvShaderTranslator>(
+      SpirvShaderTranslator::Features(command_processor_.GetVulkanDevice()),
+      render_target_cache_.msaa_2x_attachments_supported(),
+      render_target_cache_.msaa_2x_no_attachments_supported(),
+      render_target_cache_.GetPath() == RenderTargetCache::Path::kPixelShaderInterlock,
+      render_target_cache_.draw_resolution_scale_x(),
+      render_target_cache_.draw_resolution_scale_y());
+}
+
+void VulkanPipelineCache::StartTranslationThread() {
+  translation_thread_translator_ = CreateShaderTranslator();
+  {
+    std::lock_guard<std::mutex> lock(translation_lock_);
+    translation_thread_shutdown_ = false;
+  }
+  translation_thread_ = rex::thread::Thread::Create({}, [this]() { TranslationThread(); });
+  if (translation_thread_) {
+    translation_thread_->set_name("Vulkan Shader Translation");
+  }
+}
+
+void VulkanPipelineCache::StopTranslationThread() {
+  if (translation_thread_) {
+    {
+      std::lock_guard<std::mutex> lock(translation_lock_);
+      translation_thread_shutdown_ = true;
+    }
+    translation_cond_.notify_all();
+    rex::thread::Wait(translation_thread_.get(), false);
+    translation_thread_.reset();
+  }
+  // Queued and not translated: nothing in flight any more; the next draw asks for them again.
+  std::lock_guard<std::mutex> lock(translation_lock_);
+  for (VulkanShader::VulkanTranslation* translation : translation_queue_) {
+    translation->async_translation_state.store(kTranslationIdle, std::memory_order_relaxed);
+    translations_in_flight_.fetch_sub(1, std::memory_order_relaxed);
+  }
+  translation_queue_.clear();
+  translation_thread_translator_.reset();
+}
+
+void VulkanPipelineCache::TranslationThread() {
+  while (true) {
+    VulkanShader::VulkanTranslation* translation = nullptr;
+    {
+      std::unique_lock<std::mutex> lock(translation_lock_);
+      translation_cond_.wait(
+          lock, [this] { return translation_thread_shutdown_ || !translation_queue_.empty(); });
+      if (translation_thread_shutdown_) {
+        return;
+      }
+      translation = translation_queue_.front();
+      translation_queue_.pop_front();
+    }
+    // The ucode was analyzed on the GPU thread (IssueDraw's AnalyzeShaderUcode) before the
+    // translation was asked for. This thread's own translator; the binding layout UIDs are the GPU
+    // thread's (RequestShadersTranslated, when it sees this one done).
+    const auto start = std::chrono::steady_clock::now();
+    if (!translation_thread_translator_->TranslateAnalyzedShader(*translation)) {
+      REXGPU_ERROR("Shader {:016X} translation failed (translation thread); marking as ignored",
+                   translation->shader().ucode_data_hash());
+    } else {
+      // VK_NULL_HANDLE: seen as a failure by RequestShadersTranslated.
+      translation->GetOrCreateShaderModule();
+    }
+    thread_translated_.fetch_add(1, std::memory_order_relaxed);
+    thread_translated_micros_.fetch_add(
+        uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                     std::chrono::steady_clock::now() - start)
+                     .count()),
+        std::memory_order_relaxed);
+    translations_in_flight_.fetch_sub(1, std::memory_order_relaxed);
+    translation->async_translation_state.store(kTranslationDone, std::memory_order_release);
+  }
+}

