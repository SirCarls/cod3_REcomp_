@@ -193,4 +199,29 @@

 void AddTimeSince(Counter counter, uint64_t start_us) { Add(counter, Since(start_us)); }

+// [claude-9b-think] 0149 UNTESTED: see gpu_stats.h. steady_clock: once a swap, the time-stamp
+// counter isn't needed.
+void HoldSlowPresentsFor(uint32_t window_ms, uint32_t slow_ms) {
+  g_hold_slow_us.store(uint64_t(slow_ms) * 1000, std::memory_order_relaxed);
+  g_hold_until_us.store(window_ms ? SteadyMicros() + uint64_t(window_ms) * 1000 : 0,
+                        std::memory_order_release);
+}
+
+uint64_t HoldThisPresent() {
+  const uint64_t now = SteadyMicros();
+  const uint64_t last = g_last_swap_us.exchange(now, std::memory_order_relaxed);
+  const uint64_t until = g_hold_until_us.load(std::memory_order_acquire);
+  if (!until || now >= until || !last || now <= last) {
+    return 0;
+  }
+  const uint64_t interval = now - last;
+  if (interval <= g_hold_slow_us.load(std::memory_order_relaxed)) {
+    return 0;
+  }
+  g_presents_held.fetch_add(1, std::memory_order_relaxed);
+  return interval;
+}
+
+uint64_t PresentsHeld() { return g_presents_held.load(std::memory_order_relaxed); }
+
 }  // namespace rex::graphics::stats
