+// A player name made safe before the game sees it (owner 2026-11-03: "these user supplied entries
+// need to be safe guarded too"; names may carry World at War's color codes, "^0-9" and the rainbow
+// "^:"). The same rule as Call of Duty 3's recomp/src/game/color_codes.h SanitizeName and the setup
+// tool's clean_player_name: printable ASCII; no '"' or '\' (they split a game's info strings), '%'
+// (a format code) or ';' (it ends a console command); '^' only as a color code (^0-^9, ^:); spaces
+// trimmed; at most max_bytes bytes, codes included, never half a code; codes with nothing printed
+// after them dropped; empty when nothing visible is left.
+static bool IsNameCode(char c) { return (c >= '0' && c <= '9') || c == ':'; }
+
+static std::string SafePlayerName(const std::string& raw, size_t max_bytes) {
+  std::string s;
+  for (size_t i = 0; i < raw.size() && s.size() < 256; ++i) {
+    const char c = raw[i];
+    const unsigned char u = static_cast<unsigned char>(c);
+    if (u < 32 || u > 126 || c == '"' || c == '\\' || c == '%' || c == ';') continue;
+    if (c == '^') {
+      if (i + 1 < raw.size() && IsNameCode(raw[i + 1])) {
+        s.push_back('^');
+        s.push_back(raw[++i]);
+      }
+      continue;
+    }
+    s.push_back(c);
+  }
+  size_t lead = 0;
+  while (lead < s.size() && s[lead] == ' ') ++lead;
+  s.erase(0, lead);
+  if (s.size() > max_bytes) {
+    s.resize(max_bytes);
+    if (!s.empty() && s.back() == '^') s.pop_back();  // a code cut in half
+  }
+  for (;;) {  // every '^' left starts a code, so a '^' second from the end is a code at the end
+    if (!s.empty() && s.back() == ' ') {
+      s.pop_back();
+    } else if (s.size() >= 2 && s[s.size() - 2] == '^') {
+      s.resize(s.size() - 2);
+    } else {
+      break;
+    }
+  }
+  for (size_t i = 0; i < s.size(); ++i) {
+    if (s[i] == '^') {
+      ++i;
+      continue;
+    }
+    if (s[i] != ' ') return s;
+  }
+  return {};
+}
