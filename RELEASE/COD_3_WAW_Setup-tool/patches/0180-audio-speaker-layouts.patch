@@ -0,0 +1,182 @@
+/**
+ * @file        audio/headphones.h
+ * @brief       The guest's 5.1 render placed around a listener's head, for headphones
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/audio/downmix.h>
+#include <rex/types.h>
+
+namespace rex::audio::conversion {
+
+/**
+ * A 5.1 render on headphones as five speakers in a room: front left and right
+ * at 30 degrees, center straight ahead, the surrounds at 110 degrees (ITU-R
+ * BS.775). Each speaker reaches both ears, the far ear later and with less
+ * treble, the way a head shadows sound:
+ *
+ *  - The time between the ears is Woodworth's spherical head (radius 8.75 cm):
+ *    13 samples at 48 kHz for the front pair, 26 for the surrounds.
+ *  - The treble is Brown and Duda's one-pole head shadow (1998): one
+ *    first-order shelf per ear, flat at low frequencies (a head doesn't shadow
+ *    them). Each speaker's two shelves are scaled together so the treble
+ *    reaching both ears adds up to what the speaker gives, so no direction
+ *    sounds brighter or duller than straight ahead (the center is
+ *    untouched): the ear facing a front speaker gets +2.8 dB of treble and
+ *    the far ear -10.8 dB; for a surround +3.0 dB and -21 dB.
+ *  - The surrounds lose a little treble (a one-pole low-pass at 10 kHz), the
+ *    ear's own cue for sound from behind.
+ *
+ * No measured head data: everything is a few filters per speaker, so it costs
+ * next to nothing and needs no download. Center and surround take the 5.1
+ * weights (SurroundMix), because these are speakers like a 5.1 room's; the
+ * LFE takes the stereo fold's weight (StereoFold::lfe), because headphones
+ * are a two-channel destination. The level matches the stereo fold: one
+ * front channel alone gives both ears together the power the fold gives its
+ * side.
+ *
+ * Keeps state from one call to the next (the delays and the filters), so one
+ * object follows one stream: Reset() when a stream opens. Not thread-safe;
+ * the output stage calls it from the device callback only.
+ */
+class HeadphoneMix {
+ public:
+  static constexpr float kSampleRate = 48000.0f;
+
+  HeadphoneMix() {
+    for (size_t i = 0; i < kSpeakers; ++i) Configure(i);
+    Reset();
+  }
+
+  void Reset() {
+    for (auto& line : delay_) line.fill(0.0f);
+    for (auto& ears : shelf_) {
+      for (auto& shelf : ears) shelf.x1 = shelf.y1 = 0.0f;
+    }
+    rear_lp_.fill(0.0f);
+    pos_ = 0;
+  }
+
+  // The input is the guest's frame: 6 channels one after another (fl fr fc
+  // lf bl br), big-endian floats, ch_sample_count samples each. The output
+  // is interleaved stereo, little-endian, clamped to [-1, 1].
+  void Process(float* output, const float* input, size_t ch_sample_count, const SurroundMix& mix,
+               float lfe, float gain) {
+    const float scale = kLevel * gain;
+    for (size_t sample = 0; sample < ch_sample_count; ++sample) {
+      const float fl = rex::byte_swap(input[0 * ch_sample_count + sample]);
+      const float fr = rex::byte_swap(input[1 * ch_sample_count + sample]);
+      const float fc = rex::byte_swap(input[2 * ch_sample_count + sample]);
+      const float lf = rex::byte_swap(input[3 * ch_sample_count + sample]);
+      const float bl = rex::byte_swap(input[4 * ch_sample_count + sample]);
+      const float br = rex::byte_swap(input[5 * ch_sample_count + sample]);
+      float feed[kSpeakers] = {fl, fr, fc * mix.center, bl * mix.surround, br * mix.surround};
+      for (size_t r = 0; r < 2; ++r) {
+        float& state = rear_lp_[r];
+        state += kRearLowPass * (feed[3 + r] - state);
+        state = Flush(state);
+        feed[3 + r] = state;
+      }
+      float ear[2] = {lf * lfe, lf * lfe};
+      for (size_t i = 0; i < kSpeakers; ++i) {
+        auto& line = delay_[i];
+        line[pos_] = feed[i];
+        for (size_t e = 0; e < 2; ++e) {
+          const float x = line[(pos_ - delay_samples_[i][e]) & kDelayMask];
+          ear[e] += shelf_[i][e].Run(x);
+        }
+      }
+      pos_ = (pos_ + 1) & kDelayMask;
+      output[sample * 2] = std::clamp(ear[0] * scale, -1.0f, 1.0f);
+      output[sample * 2 + 1] = std::clamp(ear[1] * scale, -1.0f, 1.0f);
+    }
+  }
+
+  // For tests: the delay in samples and the treble gain (above a few kHz) of
+  // speaker i (0 fl, 1 fr, 2 fc, 3 bl, 4 br) at ear e (0 left, 1 right).
+  uint32_t delay_samples(size_t i, size_t e) const { return delay_samples_[i][e]; }
+  float treble_gain(size_t i, size_t e) const { return treble_[i][e]; }
+
+  // Both ears together get the power the stereo fold gives its side for one
+  // front channel: 2 * kLevel^2 = (1 / (1 + 0.7071))^2.
+  static constexpr float kLevel = 0.41421356f;
+
+ private:
+  static constexpr size_t kSpeakers = 5;
+  static constexpr uint32_t kDelayLength = 64;  // more than the longest delay (26)
+  static constexpr uint32_t kDelayMask = kDelayLength - 1;
+  // 1 - exp(-2 pi 10 kHz / 48 kHz)
+  static constexpr float kRearLowPass = 0.73005f;
+
+  struct Shelf {
+    float b0 = 1.0f, b1 = 0.0f, a1 = 0.0f;
+    float x1 = 0.0f, y1 = 0.0f;
+    float Run(float x) {
+      const float y = Flush(b0 * x + b1 * x1 - a1 * y1);
+      x1 = x;
+      y1 = y;
+      return y;
+    }
+  };
+
+  // Filter state that has decayed to nothing is set to zero, so silence
+  // never leaves denormals behind (slow on x86).
+  static float Flush(float v) { return std::fabs(v) < 1e-20f ? 0.0f : v; }
+
+  void Configure(size_t i) {
+    constexpr double kPi = 3.14159265358979323846;
+    constexpr double kHeadRadius = 0.0875;  // m
+    constexpr double kSpeedOfSound = 343.0;  // m/s
+    constexpr double kAzimuth[kSpeakers] = {-30.0, 30.0, 0.0, -110.0, 110.0};  // degrees, left < 0
+    const double azimuth = kAzimuth[i];
+
+    // Brown & Duda: alpha = (1 + amin/2) + (1 - amin/2) cos(theta / theta_min * 180 deg),
+    // theta the angle between the source and the ear, amin 0.1, theta_min 150 deg.
+    double alpha[2];
+    const double ear_azimuth[2] = {-90.0, 90.0};
+    for (size_t e = 0; e < 2; ++e) {
+      double theta = std::fabs(azimuth - ear_azimuth[e]);
+      if (theta > 180.0) theta = 360.0 - theta;
+      alpha[e] = 1.05 + 0.95 * std::cos(theta / 150.0 * kPi);
+    }
+    const double norm = std::sqrt(2.0 / (alpha[0] * alpha[0] + alpha[1] * alpha[1]));
+
+    // Woodworth: (a / c) (lateral + sin lateral), lateral the angle off the
+    // middle plane (110 degrees is 70 degrees off it, behind).
+    const double lateral = std::asin(std::fabs(std::sin(azimuth * kPi / 180.0)));
+    const double itd = kHeadRadius / kSpeedOfSound * (lateral + std::sin(lateral));
+    const uint32_t far_delay = static_cast<uint32_t>(std::lround(itd * kSampleRate));
+    const size_t far_ear = azimuth < 0.0 ? 1 : 0;
+
+    // H(s) = (1 + alpha s / (2 w0)) / (1 + s / (2 w0)), w0 = c / a, by the
+    // bilinear transform (s = 2 fs (1 - 1/z) / (1 + 1/z)).
+    const double tk = kSampleRate / (kSpeedOfSound / kHeadRadius);
+    for (size_t e = 0; e < 2; ++e) {
+      const double a = alpha[e] * norm;
+      Shelf& shelf = shelf_[i][e];
+      shelf.b0 = static_cast<float>((1.0 + a * tk) / (1.0 + tk));
+      shelf.b1 = static_cast<float>((1.0 - a * tk) / (1.0 + tk));
+      shelf.a1 = static_cast<float>((1.0 - tk) / (1.0 + tk));
+      treble_[i][e] = static_cast<float>(a);
+      delay_samples_[i][e] = azimuth != 0.0 && e == far_ear ? far_delay : 0;
+    }
+  }
+
+  std::array<std::array<float, kDelayLength>, kSpeakers> delay_ = {};
+  std::array<std::array<Shelf, 2>, kSpeakers> shelf_ = {};
+  uint32_t delay_samples_[kSpeakers][2] = {};
+  float treble_[kSpeakers][2] = {};
+  std::array<float, 2> rear_lp_ = {};
+  uint32_t pos_ = 0;
+};
+
+}  // namespace rex::audio::conversion
