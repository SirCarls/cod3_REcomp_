diff --git a/include/rex/audio/conversion.h b/include/rex/audio/conversion.h
index 42cdddb..47d58fb 100644
--- a/include/rex/audio/conversion.h
+++ b/include/rex/audio/conversion.h
@@ -144,4 +144,34 @@ inline void sequential_6_BE_to_interleaved_2_LE(float* output, const float* inpu
 }
 #endif
 
+// A 7.1 device (SDL's order: fl fr fc lf bl br sl sr). The fronts, center and
+// LFE as for 5.1; each guest surround plays on the side and the back speaker
+// of its side, weighted by `wide`. Scalar on every architecture: 2,048
+// floats per 5.33 ms frame.
+inline void sequential_6_BE_to_interleaved_8_LE(float* output, const float* input,
+                                                size_t ch_sample_count, const SurroundMix& mix,
+                                                const WideMix& wide, float gain) {
+  const float c = mix.center * gain;
+  const float l = mix.lfe * gain;
+  const float back = mix.surround * wide.back * gain;
+  const float side = mix.surround * wide.side * gain;
+  for (size_t sample = 0; sample < ch_sample_count; sample++) {
+    const float fl = rex::byte_swap(input[0 * ch_sample_count + sample]);
+    const float fr = rex::byte_swap(input[1 * ch_sample_count + sample]);
+    const float fc = rex::byte_swap(input[2 * ch_sample_count + sample]);
+    const float lf = rex::byte_swap(input[3 * ch_sample_count + sample]);
+    const float bl = rex::byte_swap(input[4 * ch_sample_count + sample]);
+    const float br = rex::byte_swap(input[5 * ch_sample_count + sample]);
+    float* out = &output[sample * 8];
+    out[0] = std::clamp(fl * gain, -1.0f, 1.0f);
+    out[1] = std::clamp(fr * gain, -1.0f, 1.0f);
+    out[2] = std::clamp(fc * c, -1.0f, 1.0f);
+    out[3] = std::clamp(lf * l, -1.0f, 1.0f);
+    out[4] = std::clamp(bl * back, -1.0f, 1.0f);
+    out[5] = std::clamp(br * back, -1.0f, 1.0f);
+    out[6] = std::clamp(bl * side, -1.0f, 1.0f);
+    out[7] = std::clamp(br * side, -1.0f, 1.0f);
+  }
+}
+
 }  // namespace rex::audio::conversion
