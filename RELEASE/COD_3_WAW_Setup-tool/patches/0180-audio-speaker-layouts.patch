 #include <vector>
 
 namespace rex::audio {
@@ -31,4 +32,43 @@ std::vector<std::string> ListOutputDevices();
 /// Safe to call from any thread.
 std::string CurrentOutputDevice();
 
+/// What the guest's 5.1 sound is mixed for, the `audio_output_layout`
+/// setting: "auto" (the default) follows the device (2 channels or fewer:
+/// stereo; 8 or more: 7.1; anything else: 5.1), the others ask for one
+/// whatever the device has. "headphones" places the five speakers around the
+/// listener's head (rex/audio/headphones.h). A layout with more channels than
+/// the device has is mixed down by the system. The setting is live: a change
+/// reopens the sound stream (a moment of silence).
+enum class OutputLayout { kAuto, kStereo, kHeadphones, kSurround51, kSurround71 };
+
+/// The setting's value for a layout, and back ("5.1" and "7.1" may also be
+/// written "51" or "71"; case and spaces don't matter; anything else is auto).
+inline const char* OutputLayoutName(OutputLayout layout) {
+  switch (layout) {
+    case OutputLayout::kStereo: return "stereo";
+    case OutputLayout::kHeadphones: return "headphones";
+    case OutputLayout::kSurround51: return "5.1";
+    case OutputLayout::kSurround71: return "7.1";
+    default: return "auto";
+  }
+}
+
+inline OutputLayout ParseOutputLayout(std::string_view value) {
+  std::string v;
+  for (const char ch : value) {
+    if (ch == ' ' || ch == '\t') continue;
+    v += (ch >= 'A' && ch <= 'Z') ? static_cast<char>(ch - 'A' + 'a') : ch;
+  }
+  if (v == "stereo" || v == "2.0") return OutputLayout::kStereo;
+  if (v == "headphones" || v == "headphone") return OutputLayout::kHeadphones;
+  if (v == "5.1" || v == "51") return OutputLayout::kSurround51;
+  if (v == "7.1" || v == "71") return OutputLayout::kSurround71;
+  return OutputLayout::kAuto;
+}
+
+/// The layout the sound is mixed for now and how many channels go to the
+/// device, for showing ("" before audio starts), e.g. "7.1 (8 channels; the
+/// device's own)". Safe to call from any thread.
+std::string CurrentOutputLayout();
+
 }  // namespace rex::audio
