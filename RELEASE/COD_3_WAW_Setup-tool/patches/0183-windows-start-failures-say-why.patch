+
+// The program's file name without ".exe" ("cod3"), for a box shown before
+// the program has named itself.
+std::wstring ProgramFileName() {
+  wchar_t path[MAX_PATH];
+  const DWORD n = GetModuleFileNameW(nullptr, path, MAX_PATH);
+  if (n == 0 || n >= MAX_PATH)
+    return L"ReXGlue";
+  std::wstring name(path, n);
+  if (const size_t slash = name.find_last_of(L"\\/"); slash != std::wstring::npos)
+    name.erase(0, slash + 1);
+  if (const size_t dot = name.rfind(L'.'); dot != std::wstring::npos && dot > 0)
+    name.erase(dot);
+  return name.empty() ? std::wstring(L"ReXGlue") : name;
+}
+
+}  // namespace
+
+void SetSimpleMessageBoxTitle(std::string_view title) {
+  const auto wide = rex::string::to_utf16(title);
+  std::lock_guard lock(g_title_mutex);
+  g_title.assign(reinterpret_cast<const wchar_t*>(wide.data()), wide.size());
+}
+
+bool SimpleMessageBoxShown() {
+  return g_shown.load(std::memory_order_acquire);
+}
