 namespace {
 
+#if REX_PLATFORM_WIN32
+// [cod3 0183] A Windows program has no console, so a start that failed before
+// the program's own window ended without a word (no window, often no log).
+// Now it says why in a message box, unless one has said it already. An error
+// that escapes once the program runs (its message loop) still ends it as
+// before (std::terminate).
+
+// UTF-8 for a C runtime or exception text, which on Windows may be in the
+// system's code page (a path in a std::filesystem or spdlog message).
+std::string NarrowToUtf8(const char* text) {
+  if (!text || !*text)
+    return {};
+  if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, nullptr, 0) > 0)
+    return text;
+  const int wide_size = MultiByteToWideChar(CP_ACP, 0, text, -1, nullptr, 0);
+  if (wide_size <= 1)
+    return text;
+  std::wstring wide(static_cast<size_t>(wide_size), L'\0');
+  MultiByteToWideChar(CP_ACP, 0, text, -1, wide.data(), wide_size);
+  const int size = WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), -1, nullptr, 0, nullptr, nullptr);
+  if (size <= 1)
+    return text;
+  std::string utf8(static_cast<size_t>(size), '\0');
+  WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), -1, utf8.data(), size, nullptr, nullptr);
+  utf8.resize(static_cast<size_t>(size - 1));
+  return utf8;
+}
+
+// The exception being handled; call only inside a catch block.
+std::string CurrentExceptionText() {
+  try {
+    throw;
+  } catch (const std::exception& e) {
+    const std::string text = NarrowToUtf8(e.what());
+    return text.empty() ? std::string("an error without a description") : text;
+  } catch (...) {
+    return "an error without a description";
+  }
+}
+
+std::string LogFileHint() {
+  const std::string log_file = NarrowToUtf8(rex::cvar::GetFlagByName("log_file").c_str());
+  return log_file.empty() ? std::string("the logs folder next to the program") : log_file;
+}
+
+void ShowStartFailure(const std::string& text) {
+  if (rex::SimpleMessageBoxShown())
+    return;
+  rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, text);
+}
