+
+// Adds `delta` local or remote players to the session at `session_ptr` and
+// logs the totals. A count never goes below 0; at most 64 sessions are kept.
+void CountSessionPlayers(uint32_t session_ptr, bool local, int delta, const char* what) {
+  std::lock_guard<std::mutex> lock(SessionCountsMutex());
+  auto& counts = SessionCounts();
+  if (!counts.count(session_ptr) && counts.size() >= 64) {
+    counts.clear();
+  }
+  SessionCount& count = counts[session_ptr];
+  int& field = local ? count.local : count.remote;
+  field = std::max(0, field + delta);
+  REXKRNL_INFO("XSession {:08X}: {} {} player(s) {}; now {} local and {} remote", session_ptr,
+               delta < 0 ? -delta : delta, local ? "local" : "remote", what, count.local,
+               count.remote);
+}
