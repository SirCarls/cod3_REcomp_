+
+void TraceDatagram(bool out, const XSocket* socket, uint32_t peer, uint16_t peer_port,
+                   const uint8_t* data, uint32_t length, const char* note) {
+  if (!Tracing()) {
+    return;
+  }
+  auto& trace = Trace();
+  std::lock_guard<std::mutex> lock(trace.mutex);
+  const uint16_t local_port = socket->bound_port();
+  TraceFlow* flow = nullptr;
+  for (auto& f : trace.flows) {
+    if (f.out == out && f.local_port == local_port && f.peer == peer && f.peer_port == peer_port) {
+      flow = &f;
+      break;
+    }
+  }
+  if (!flow && trace.flows.size() < 64) {
+    trace.flows.emplace_back();
+    flow = &trace.flows.back();
+    flow->out = out;
+    flow->local_port = local_port;
+    flow->peer = peer;
+    flow->peer_port = peer_port;
+  }
+  if (flow && !note) {
+    ++flow->packets;
+    flow->bytes += length;
+  }
+  if (note || (flow && flow->logged < 3)) {
+    if (flow && !note) {
+      ++flow->logged;
+    }
+    std::string head;
+    for (uint32_t i = 0; data && i < length && i < 12; ++i) {
+      head += fmt::format("{:02X}", data[i]);
+    }
+    REXKRNL_INFO("XNet trace: {} port {} {} {}:{}, {} bytes{} [{}]{}{}", out ? "send" : "recv",
+                 local_port, out ? "->" : "<-", rex::net::format_ipv4(peer), peer_port, length,
+                 socket->is_vdp() ? " (VDP)" : "", head, note ? ": " : "", note ? note : "");
+  }
+  auto now = std::chrono::steady_clock::now();
+  if (now - trace.last_summary >= std::chrono::seconds(10)) {
+    trace.last_summary = now;
+    std::string line;
+    for (auto& f : trace.flows) {
+      if (f.packets) {
+        line += fmt::format(" [port {} {} {}:{}: {} packets, {} bytes]", f.local_port,
+                            f.out ? "->" : "<-", rex::net::format_ipv4(f.peer), f.peer_port,
+                            f.packets, f.bytes);
+      }
+      f.packets = 0;
+      f.bytes = 0;
+    }
+    REXKRNL_INFO("XNet trace: the last 10 s by port and peer:{}", line.empty() ? " nothing" : line);
+  }
+}
+
+// Logs a peer's connect status when it differs from the last one logged for that address.
+void TraceStatus(uint32_t ina, uint32_t status) {
+  if (!Tracing()) {
+    return;
+  }
+  auto& trace = Trace();
+  std::lock_guard<std::mutex> lock(trace.mutex);
+  for (auto& entry : trace.status) {
+    if (entry.first == ina) {
+      if (entry.second != status) {
+        entry.second = status;
+        REXKRNL_INFO("XNet trace: XNetGetConnectStatus({}) is now {}", rex::net::format_ipv4(ina),
+                     status);
+      }
+      return;
+    }
+  }
+  if (trace.status.size() < 64) {
+    trace.status.emplace_back(ina, status);
+  }
+  REXKRNL_INFO("XNet trace: XNetGetConnectStatus({}) = {}", rex::net::format_ipv4(ina), status);
+}
