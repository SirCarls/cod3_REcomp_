+// [claude-9b-think] 0209: net_broadcast_peers, parsed (at most 32 addresses;
+// anything that isn't a dotted-quad address is skipped). Read at every
+// broadcast: the game broadcasts only while it looks for games.
+std::vector<uint32_t> BroadcastPeers() {
+  std::vector<uint32_t> peers;
+  std::string list = REXCVAR_GET(net_broadcast_peers);
+  size_t pos = 0;
+  while (pos <= list.size() && peers.size() < 32) {
+    size_t end = list.find_first_of(", ;", pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    uint32_t addr = 0;
+    if (end > pos && rex::net::parse_ipv4(std::string_view(list).substr(pos, end - pos), &addr) &&
+        addr && addr != rex::net::kIpv4Broadcast && !rex::net::ipv4_is_multicast(addr) &&
+        std::find(peers.begin(), peers.end(), addr) == peers.end()) {
+      peers.push_back(addr);
+    }
+    pos = end + 1;
+  }
+  return peers;
+}
