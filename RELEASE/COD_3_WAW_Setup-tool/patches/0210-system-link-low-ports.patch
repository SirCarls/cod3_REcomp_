+// [claude-9b-think] 0210: net_low_port_offset, or 0 when it is 0 or out of range.
+uint32_t LowPortOffset() {
+  const int32_t offset = REXCVAR_GET(net_low_port_offset);
+  if (offset < 1024 || offset > 65535 - 1023) {
+    if (offset != 0) {
+      static std::once_flag warned;
+      std::call_once(warned, [offset] {
+        REXKRNL_WARN("XNet: net_low_port_offset {} is outside 1024-64512; the game's ports "
+                     "below 1024 are used as they are",
+                     offset);
+      });
+    }
+    return 0;
+  }
+  return static_cast<uint32_t>(offset);
+}
+
+// [claude-9b-think] 0210: the game's port as this PC uses it: 1-1023 move up by
+// net_low_port_offset (1000 -> 31000 by default). Applied to every address the
+// game passes in (bind, connect, sendto), so a copy sends to the moved port of
+// its peer too: all copies must use the same offset.
+uint16_t HostPort(uint16_t game_port) {
+  const uint32_t offset = LowPortOffset();
+  if (offset && game_port && game_port < 1024) {
+    return static_cast<uint16_t>(game_port + offset);
+  }
+  return game_port;
+}
+
+// [claude-9b-think] 0210: a host port as the game sees it (recvfrom, accept):
+// the moved range comes back down, so the game sees its peer's port 1000 and
+// replies there (HostPort moves it back up). A port the game picks itself in
+// that range (31000 for 1000) would be shown moved down too; CoD3 uses 1000 and 50000.
+uint16_t GamePort(uint16_t host_port) {
+  const uint32_t offset = LowPortOffset();
+  if (offset && host_port > offset && host_port < offset + 1024) {
+    return static_cast<uint16_t>(host_port - offset);
+  }
+  return host_port;
+}
