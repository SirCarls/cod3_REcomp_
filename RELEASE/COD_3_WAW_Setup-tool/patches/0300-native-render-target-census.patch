+// [rexglue-native] SDK 0300: the native render-target census (native_census.h).
+REXCVAR_DEFINE_UINT32(native_census_seconds, 0, "GPU",
+                      "Every this many seconds, log what the EDRAM emulation did: render-target "
+                      "switches, ownership transfers, resolves (0 = off)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(native_census_skip_transfers, false, "GPU",
+                    "Test only: drop render-target ownership transfers, so each render target "
+                    "keeps its own contents as native render targets will")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace rex::graphics::native_census {
+
+namespace {
+Counters counters_;
+std::chrono::steady_clock::time_point interval_start_;
+bool interval_started_ = false;
+}  // namespace
+
+bool Active() { return REXCVAR_GET(native_census_seconds) != 0; }
+
+bool SkipTransfers() { return REXCVAR_GET(native_census_skip_transfers); }
+
+Counters& Get() { return counters_; }
+
+void MaybeLog() {
+  const uint32_t seconds = REXCVAR_GET(native_census_seconds);
+  if (!seconds) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (!interval_started_) {
+    interval_started_ = true;
+    interval_start_ = now;
+    counters_ = Counters();
+    return;
+  }
+  const double elapsed = std::chrono::duration<double>(now - interval_start_).count();
+  if (elapsed < double(seconds)) {
+    return;
+  }
+  const Counters& c = counters_;
+  auto per_second = [elapsed](uint64_t count) { return double(count) / elapsed; };
+  REXGPU_INFO(
+      "native census ({:.1f} s, per second): render-target updates {:.0f}, {:.0f} changed what "
+      "is bound; ownership transfers {:.1f} (same format {:.1f}, format change {:.1f}, "
+      "color/depth {:.1f}; {:.0f} tiles){}; resolves {:.1f} (depth {:.1f}, MSAA {:.1f}, "
+      "offset {:.1f}); color resolves copied into their textures {:.1f}, not: MSAA/64bpp/shader "
+      "{:.1f}, format {:.1f}, several owners {:.1f}, part owner {:.1f}, other owner {:.1f}, "
+      "outside {:.1f}, no texture {:.1f}, not attempted {:.1f}; resolve clears depth {:.1f} "
+      "color {:.1f}",
+      elapsed, per_second(c.updates), per_second(c.updates_changed),
+      per_second(c.transfers[kTransferSameFormat] + c.transfers[kTransferFormatChange] +
+                 c.transfers[kTransferColorDepth]),
+      per_second(c.transfers[kTransferSameFormat]), per_second(c.transfers[kTransferFormatChange]),
+      per_second(c.transfers[kTransferColorDepth]), per_second(c.transfer_tiles),
+      c.transfers_dropped ? fmt::format(", {:.1f} dropped (skip_transfers on)",
+                                        per_second(c.transfers_dropped))
+                          : std::string(),
+      per_second(c.resolves), per_second(c.resolves_depth), per_second(c.resolves_msaa),
+      per_second(c.resolves_offset), per_second(c.into_texture),
+      per_second(c.not_into_texture[kSkipShaderOrMsaa]),
+      per_second(c.not_into_texture[kSkipFormat]),
+      per_second(c.not_into_texture[kSkipSeveralOwners]),
+      per_second(c.not_into_texture[kSkipPartOwner]),
+      per_second(c.not_into_texture[kSkipOtherOwner]),
+      per_second(c.not_into_texture[kSkipOutside]),
+      per_second(c.not_into_texture[kSkipNoTexture]),
+      per_second(c.not_into_texture[kSkipNotAttempted]), per_second(c.clears_depth),
+      per_second(c.clears_color));
+  counters_ = Counters();
+  interval_start_ = now;
+}
+
+}  // namespace rex::graphics::native_census
