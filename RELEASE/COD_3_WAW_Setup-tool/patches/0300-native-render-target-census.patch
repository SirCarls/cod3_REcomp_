+/**
+ * @file        rex/graphics/native_census.h
+ *
+ * @brief       [rexglue-native] SDK 0300: counts what the EDRAM emulation does
+ *              (render-target switches, ownership transfers between aliased
+ *              render targets, resolves and whether they could be copied
+ *              straight into their textures), for the native render-target
+ *              design (the project's dev/agents/rexglue-native/DESIGN.md).
+ *
+ * Off by default: with native_census_seconds 0 the cost is one setting read
+ * per render-target update and per resolve. The GPU command thread is the only
+ * writer and reader, so the counters are plain integers.
+ *
+ * native_census_skip_transfers (test only, off) drops the ownership transfers
+ * that render-target updates ask for, so every render target keeps its own
+ * contents, as native host render targets will. A picture difference with it
+ * on shows a pass that reads EDRAM another render target wrote.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::native_census {
+
+enum TransferKind : uint32_t {
+  // Same depth/color kind and format, another base or pitch.
+  kTransferSameFormat,
+  // Same kind, another format.
+  kTransferFormatChange,
+  // Color to depth or depth to color.
+  kTransferColorDepth,
+  kTransferKindCount,
+};
+
+// Why a color resolve wasn't copied straight into its texture. 0-5 are the
+// reasons VulkanRenderTargetCache::CopyResolveIntoTexture logs (in its order).
+enum ResolveSkip : uint32_t {
+  kSkipShaderOrMsaa,       // 0: MSAA, 64bpp or another copy shader
+  kSkipFormat,             // 1: format, exponent bias, array, endian or offset
+  kSkipSeveralOwners,      // 2: more than one render target owns the area
+  kSkipPartOwner,          // 3: the render target owns only part of the area
+  kSkipOtherOwner,         // 4: the owner isn't a 1x 8_8_8_8 color target of the pitch
+  kSkipOutside,            // 5: the area is outside the render target
+  kSkipNoTexture,          // 6: no texture of that address, pitch and format
+  kSkipNotAttempted,       // 7: resolve-into-textures off, or resolution scaled
+  kResolveSkipCount,
+};
+
+struct Counters {
+  uint64_t updates;
+  uint64_t updates_changed;  // the bound render targets differ from the last update
+  uint64_t transfers[kTransferKindCount];
+  uint64_t transfer_tiles;
+  uint64_t transfers_dropped;  // by native_census_skip_transfers
+  uint64_t resolves;
+  uint64_t resolves_depth;
+  uint64_t resolves_msaa;
+  uint64_t resolves_offset;  // a destination offset (sub-rectangle)
+  uint64_t into_texture;
+  uint64_t not_into_texture[kResolveSkipCount];
+  uint64_t clears_depth;
+  uint64_t clears_color;
+};
+
+// native_census_seconds != 0.
+bool Active();
+// native_census_skip_transfers.
+bool SkipTransfers();
+Counters& Get();
+// Logs one line and starts over when native_census_seconds have passed.
+void MaybeLog();
+
+}  // namespace rex::graphics::native_census
