+void VulkanRenderTargetCache::PerformNativeInitialClears() {
+  // [rexglue-native] SDK 0301: what a new native render target starts with:
+  // color 0, depth 1.0 and stencil 0, cleared like a resolve clears (a render
+  // pass clear of the whole render target, nothing transferred).
+  if (native_initial_clears_.empty()) {
+    return;
+  }
+  const std::vector<Transfer> no_transfers;
+  for (RenderTarget* render_target : native_initial_clears_) {
+    RenderTargetKey key = render_target->key();
+    // The guest's clear value, as in RB_DEPTH_CLEAR / RB_COLOR_CLEAR(_LO).
+    uint64_t clear_value = 0;
+    if (key.is_depth) {
+      uint32_t depth_one = key.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24FS8
+                               ? xenos::Float32To20e4(1.0f, false)
+                               : uint32_t(0xFFFFFF);
+      clear_value = uint64_t(depth_one) << 8;
+    }
+    Transfer::Rectangle rectangle;
+    rectangle.x_pixels = 0;
+    rectangle.y_pixels = 0;
+    rectangle.width_pixels = key.GetWidth();
+    rectangle.height_pixels = GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples);
+    PerformTransfersAndResolveClears(1, &render_target, &no_transfers, &clear_value, &rectangle);
+  }
+  native_initial_clears_.clear();
 }
 
