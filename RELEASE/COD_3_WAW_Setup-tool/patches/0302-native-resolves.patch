 }
 
+// [rexglue-native] SDK 0302: native resolves into their textures.
+
+bool VulkanTextureCache::FindNativeResolveDestination(
+    uint32_t copy_dest_base, uint32_t dest_pitch_texels, xenos::TextureFormat format,
+    xenos::Endian endianness, uint32_t offset_x, uint32_t offset_y, uint32_t width,
+    uint32_t height, NativeResolveDestination& destination_out) {
+  destination_out = NativeResolveDestination();
+  if (IsDrawResolutionScaled() || !width || !height || (copy_dest_base & 0xFFF) ||
+      !dest_pitch_texels || (dest_pitch_texels & 31) || offset_x >= 32 || offset_y >= 32) {
+    return false;
+  }
+  const uint32_t dest_page = (copy_dest_base & 0x1FFFFFFF) >> 12;
+  const uint32_t pitch_tiles = dest_pitch_texels >> 5;
+  // A texture the resolve could land in: as the game fetches a resolved
+  // surface (2D, tiled, one level), loaded as a plain copy of its texels.
+  auto is_candidate = [&](const Texture& texture) -> bool {
+    const TextureKey& key = texture.key();
+    if (!key.is_valid || !key.tiled || key.dimension != xenos::DataDimension::k2DOrStacked ||
+        key.depth_or_array_size_minus_1 || key.scaled_resolve || key.signed_separate ||
+        key.pitch != pitch_tiles || key.format != format || key.endianness != endianness ||
+        key.base_page > dest_page) {
+      return false;
+    }
+    // A base level of 16 texels or less may be in the packed mip tail.
+    if (key.packed_mips && (key.GetWidth() <= 16 || key.GetHeight() <= 16)) {
+      return false;
+    }
+    if (texture.is_replacement() || texture.GetGuestMipsSize() || !texture.GetGuestBaseSize()) {
+      return false;
+    }
+    const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+    // [rexglue-native] SDK 0302-r3: depth sampled as depth (k_24_8,
+    // k_24_8_FLOAT) is R32_SFLOAT made by its own load shader, whose output
+    // the native resolve's linear texels reproduce.
+    if (key.format == xenos::TextureFormat::k_24_8) {
+      return host_format_pair.format_unsigned.load_shader == kLoadShaderIndexDepthUnorm &&
+             host_format_pair.format_unsigned.format == VK_FORMAT_R32_SFLOAT;
+    }
+    if (key.format == xenos::TextureFormat::k_24_8_FLOAT) {
+      return host_format_pair.format_unsigned.load_shader == kLoadShaderIndexDepthFloat &&
+             host_format_pair.format_unsigned.format == VK_FORMAT_R32_SFLOAT;
+    }
+    return host_format_pair.format_unsigned.load_shader == kLoadShaderIndex32bpb &&
+           host_format_pair.format_unsigned.format == VK_FORMAT_R8G8B8A8_UNORM;
+  };
+  // Where the resolve is in a candidate. A 32bpp tiled texture is made of
+  // 32x32-texel tiles of 4 KB each, in rows of pitch_tiles
+  // (texture_util::GetTiledOffset2D), so the destination base, moved to the
+  // tile the resolve starts in, is that many tiles into the texture.
+  auto locate = [&](Texture* texture, NativeResolveDestination& located) -> bool {
+    const TextureKey& key = texture->key();
+    const uint32_t tiles = dest_page - key.base_page;
+    const uint32_t x = (tiles % pitch_tiles) * 32 + offset_x;
+    const uint32_t y = (tiles / pitch_tiles) * 32 + offset_y;
+    const uint32_t texture_width = key.GetWidth();
+    const uint32_t texture_height = key.GetHeight();
+    if (x >= texture_width || y >= texture_height) {
+      return false;
+    }
+    located.texture = texture;
+    located.dest_x = x;
+    located.dest_y = y;
+    located.width = std::min(width, texture_width - x);
+    located.height = std::min(height, texture_height - y);
+    return true;
+  };
+  // Every field whole: 17-bit page, 9-bit pitch, 6-bit format, 2-bit
+  // endianness, 2-bit offsets in 8-texel blocks, 11-bit sizes in 8-texel
+  // blocks, and a bit for "used".
+  const uint64_t resolve_id =
+      (uint64_t(1) << 63) | (uint64_t(dest_page) << 43) | (uint64_t(pitch_tiles) << 34) |
+      (uint64_t(format) << 28) | (uint64_t(endianness) << 26) |
+      (uint64_t(offset_x >> 3) << 24) | (uint64_t(offset_y >> 3) << 22) |
+      (uint64_t((width >> 3) & 0x7FF) << 11) | uint64_t((height >> 3) & 0x7FF);
+  NativeResolveMemo& memo = native_resolve_memos_[(resolve_id * 0x9E3779B97F4A7C15ull) >> 58];
+  if (memo.resolve == resolve_id) {
+    if (memo.key.is_valid) {
+      Texture* texture = FindExistingTexture(memo.key);
+      if (texture && is_candidate(*texture) && locate(texture, destination_out)) {
+        return true;
+      }
+    } else if (memo.textures_created == textures_created()) {
+      return false;
+    }
+  }
+  // The candidate based closest before (or at) the destination.
+  NativeResolveDestination best;
+  ForEachTexture([&](Texture* texture) {
+    if (!texture || !is_candidate(*texture)) {
+      return;
+    }
+    if (best.texture && best.texture->key().base_page >= texture->key().base_page) {
+      return;
+    }
+    NativeResolveDestination located;
+    if (locate(texture, located)) {
+      best = located;
+    }
+  });
+  memo.resolve = resolve_id;
+  memo.textures_created = textures_created();
+  if (best.texture) {
+    memo.key = best.texture->key();
+  } else {
+    memo.key.MakeInvalid();
+  }
+  destination_out = best;
+  return best.texture != nullptr;
+}
+
+VulkanTextureCache::NativeResolveCopy VulkanTextureCache::GetNativeResolveCopy(
+    const NativeResolveDestination& destination, bool is_depth, bool red_blue_swap,
+    bool& linear_red_blue_swap_out) {
+  linear_red_blue_swap_out = false;
+  if (!destination.texture) {
+    return NativeResolveCopy::kNone;
+  }
+  const VulkanTexture& texture = *static_cast<const VulkanTexture*>(destination.texture);
+  const TextureKey& key = texture.key();
+  const bool covers_texture = !destination.dest_x && !destination.dest_y &&
+                              destination.width == key.GetWidth() &&
+                              destination.height == key.GetHeight();
+  // Written in part: the rest must be what the texture holds now.
+  if (!covers_texture && texture.outdated_mask()) {
+    return NativeResolveCopy::kNone;
+  }
+  // The texture holds red and blue as the guest memory has them, or swapped
+  // back if red_blue_swapped (its views swap them again).
+  const bool texture_swapped = texture.red_blue_swapped();
+  if (is_depth) {
+    // Depth and color images can't be copied into each other.
+    if (key.format == xenos::TextureFormat::k_24_8 ||
+        key.format == xenos::TextureFormat::k_24_8_FLOAT) {
+      // [rexglue-native] SDK 0302-r3: one float component - red/blue swapped
+      // views of it would be wrong (never set for these, but not assumed).
+      return texture_swapped ? NativeResolveCopy::kNone : NativeResolveCopy::kBuffer;
+    }
+    linear_red_blue_swap_out = texture_swapped;
+    return NativeResolveCopy::kBuffer;
+  }
+  if (texture_swapped == red_blue_swap) {
+    return NativeResolveCopy::kImage;
+  }
+  if (covers_texture && (!red_blue_swap ||
+                         command_processor_.GetVulkanDevice()->properties().imageViewFormatSwizzle)) {
+    // The texture's red/blue state is set to the resolve's.
+    return NativeResolveCopy::kImage;
+  }
+  linear_red_blue_swap_out = true;
+  return NativeResolveCopy::kBuffer;
+}
+
+void VulkanTextureCache::BeginNativeResolveTextureWrite(VulkanTexture& texture) {
+  // From its last use (sampling, or a copy into it, which must finish before
+  // this one writes) to a copy's destination, keeping its contents.
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags texture_src_stage_mask, texture_dst_stage_mask;
+  VkAccessFlags texture_src_access_mask, texture_dst_access_mask;
+  VkImageLayout texture_old_layout, texture_new_layout;
+  GetTextureUsageMasks(old_usage, texture_src_stage_mask, texture_src_access_mask,
+                       texture_old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, texture_dst_stage_mask,
+                       texture_dst_access_mask, texture_new_layout);
+  if (!texture_src_stage_mask) {
+    texture_src_stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), texture_src_stage_mask,
+      texture_dst_stage_mask, texture_src_access_mask, texture_dst_access_mask, texture_old_layout,
+      texture_new_layout, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+}
+
+void VulkanTextureCache::CopyImageIntoNativeResolveDestination(
+    const NativeResolveDestination& destination, bool red_blue_swap, VkImage source_image,
+    VkPipelineStageFlags source_stage_mask, VkAccessFlags source_access_mask,
+    VkImageLayout source_layout, uint32_t source_x, uint32_t source_y) {
+  if (!destination.texture || !destination.width || !destination.height) {
+    return;
+  }
+  VulkanTexture& texture = *static_cast<VulkanTexture*>(destination.texture);
+  command_processor_.PushImageMemoryBarrier(
+      source_image, ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+      source_stage_mask, VK_PIPELINE_STAGE_TRANSFER_BIT, source_access_mask,
+      VK_ACCESS_TRANSFER_READ_BIT, source_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  BeginNativeResolveTextureWrite(texture);
+  command_processor_.SubmitBarriers(true);
+  VkImageCopy& region = *command_processor_.deferred_command_buffer().CmdCopyImageEmplace(
+      source_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1);
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.mipLevel = 0;
+  region.srcSubresource.baseArrayLayer = 0;
+  region.srcSubresource.layerCount = 1;
+  region.srcOffset.x = int32_t(source_x);
+  region.srcOffset.y = int32_t(source_y);
+  region.srcOffset.z = 0;
+  region.dstSubresource = region.srcSubresource;
+  region.dstOffset.x = int32_t(destination.dest_x);
+  region.dstOffset.y = int32_t(destination.dest_y);
+  region.dstOffset.z = 0;
+  region.extent.width = destination.width;
+  region.extent.height = destination.height;
+  region.extent.depth = 1;
+  // Only when the whole texture is written (GetNativeResolveCopy).
+  if (texture.red_blue_swapped() != red_blue_swap) {
+    texture.set_red_blue_swapped(red_blue_swap);
+    RecheckTextureBindings();
+  }
+  MarkTextureUpToDate(texture);
+}
+
+void VulkanTextureCache::CopyBufferIntoNativeResolveDestination(
+    const NativeResolveDestination& destination, VkBuffer buffer) {
+  if (!destination.texture || !destination.width || !destination.height) {
+    return;
+  }
+  VulkanTexture& texture = *static_cast<VulkanTexture*>(destination.texture);
+  BeginNativeResolveTextureWrite(texture);
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy& region =
+      *command_processor_.deferred_command_buffer().CmdCopyBufferToImageEmplace(
+          buffer, texture.image(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1);
+  region.bufferOffset = 0;
+  region.bufferRowLength = destination.width;
+  region.bufferImageHeight = destination.height;
+  region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.imageSubresource.mipLevel = 0;
+  region.imageSubresource.baseArrayLayer = 0;
+  region.imageSubresource.layerCount = 1;
+  region.imageOffset.x = int32_t(destination.dest_x);
+  region.imageOffset.y = int32_t(destination.dest_y);
+  region.imageOffset.z = 0;
+  region.imageExtent.width = destination.width;
+  region.imageExtent.height = destination.height;
+  region.imageExtent.depth = 1;
+  MarkTextureUpToDate(texture);
+}
+
 bool VulkanTextureCache::Initialize() {
   const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
   const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
