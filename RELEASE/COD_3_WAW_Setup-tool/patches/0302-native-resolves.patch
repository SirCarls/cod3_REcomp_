+// [rexglue-native] SDK 0302: native resolves of the Vulkan render target
+// cache (VulkanRenderTargetCache::NativeResolve in render_target_cache.h).
+// With native render targets, a 32bpp resolve without MSAA reads the render
+// target the resolve names, and one compute pass, made here with SpirvBuilder,
+// writes what the guest's resolve would have written into shared memory: the
+// 32-bit words of the render target (color 8888 as the EDRAM dump packs it,
+// red and blue swapped if asked; depth as 24-bit depth << 8 | stencil),
+// endian-swapped, at the 32bpp tiled addresses of the destination
+// (texture_util::GetTiledOffset2D). For a texture the game samples, the same
+// pass can also write the texture's texels linearly into the scratch buffer.
+// 0302-r3: for depth the game samples as depth (k_24_8, k_24_8_FLOAT, R32_SFLOAT
+// textures), those texels are the floats the texture's load shader would make,
+// so depth resolves no longer make their textures load again from memory.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include <SPIRV/GLSL.std.450.h>
+
+#include <rex/assert.h>
+#include <rex/cvar.h>
+#include <rex/graphics/native_census.h>
+#include <rex/graphics/pipeline/shader/spirv_builder.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/graphics/vulkan/deferred_command_buffer.h>
+#include <rex/graphics/vulkan/render_target_cache.h>
+#include <rex/graphics/vulkan/shared_memory.h>
+#include <rex/graphics/vulkan/texture_cache.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/util.h>
+
+// Defined in render_target_cache.cpp.
+REXCVAR_DECLARE(bool, vulkan_resolve_into_textures);
+
+namespace rex::graphics::vulkan {
+
+bool VulkanRenderTargetCache::NativeResolve(const draw_util::ResolveInfo& resolve_info,
+                                            VulkanSharedMemory& shared_memory,
+                                            VulkanTextureCache& texture_cache) {
+  // Why a resolve is done the EDRAM emulation's way instead, logged once for
+  // each reason.
+  static uint32_t reasons_logged = 0;
+  auto skip = [](uint32_t reason, const char* why) -> bool {
+    if (!(reasons_logged & (uint32_t(1) << reason))) {
+      reasons_logged |= uint32_t(1) << reason;
+      REXGPU_INFO("native_render_targets: a resolve done the EDRAM emulation's way: {}", why);
+    }
+    return false;
+  };
+
+  const bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  const draw_util::ResolveCopyDestCoordinateInfo dest_coordinates =
+      resolve_info.copy_dest_coordinate_info;
+  if (edram_info.msaa_samples != xenos::MsaaSamples::k1X || edram_info.format_is_64bpp) {
+    return skip(0, "MSAA or 64bpp");
+  }
+  if (dest_info.copy_dest_array ||
+      uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian128::k16in32)) {
+    return skip(1, "an array destination, or 64-bit or 128-bit endian swapping");
+  }
+  // Depth is written as its raw 32-bit words (copy_dest_info has the depth
+  // format, not the one the game samples it as). Color: 8888 to 8888 only.
+  if (!is_depth &&
+      (xenos::ColorRenderTargetFormat(edram_info.format) !=
+           xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+       dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 ||
+       dest_info.copy_dest_exp_bias)) {
+    return skip(2, "color other than 8888 to 8888, or an exponent bias");
+  }
+  const uint32_t dest_pitch_texels = uint32_t(dest_coordinates.pitch_aligned_div_32)
+                                     << xenos::kTextureTileWidthHeightLog2;
+  const uint32_t dest_offset_x = uint32_t(dest_coordinates.offset_x_div_8)
+                                 << xenos::kResolveAlignmentPixelsLog2;
+  const uint32_t dest_offset_y = uint32_t(dest_coordinates.offset_y_div_8)
+                                 << xenos::kResolveAlignmentPixelsLog2;
+  // 32bpp: the destination base is moved to the 32x32 tile the resolve starts
+  // in, the offsets are within it.
+  if (!dest_pitch_texels || dest_offset_x >= 32 || dest_offset_y >= 32) {
+    return skip(3, "no destination pitch, or an offset outside the first tile");
+  }
+
+  uint32_t source_x, source_y;
+  RenderTarget* source_render_target =
+      FindResolveSourceRenderTarget(resolve_info, source_x, source_y);
+  if (!source_render_target) {
+    return skip(4, "no render target with the resolve's base, pitch and format");
+  }
+  // Created by a resolve clear and not cleared yet (normally done already).
+  PerformNativeInitialClears();
+  auto& vulkan_rt = *static_cast<VulkanRenderTarget*>(source_render_target);
+  const RenderTargetKey rt_key = vulkan_rt.key();
+  const uint32_t width = uint32_t(resolve_info.coordinate_info.width_div_8)
+                         << xenos::kResolveAlignmentPixelsLog2;
+  const uint32_t height = resolve_info.height_div_8 << xenos::kResolveAlignmentPixelsLog2;
+  if (!width || !height || source_x + width > rt_key.GetWidth() ||
+      source_y + height >
+          GetRenderTargetHeight(rt_key.pitch_tiles_at_32bpp, rt_key.msaa_samples)) {
+    return skip(5, "the area is outside its render target");
+  }
+  bool source_is_uint = false;
+  if (!is_depth) {
+    GetColorOwnershipTransferVulkanFormat(rt_key.GetColorFormat(), rt_key.msaa_samples,
+                                          &source_is_uint);
+  }
+  const bool red_blue_swap = !is_depth && dest_info.copy_dest_swap;
+
+  // The texture the game samples the surface as, if it exists and can be
+  // written (otherwise it's loaded again from the memory written here).
+  VulkanTextureCache::NativeResolveDestination texture_destination;
+  VulkanTextureCache::NativeResolveCopy texture_copy =
+      VulkanTextureCache::NativeResolveCopy::kNone;
+  bool linear_red_blue_swap = false;
+  // [rexglue-native] SDK 0302-r3: why not, for the census.
+  native_census::NativeNotCopied not_copied = native_census::kNativeNoTexture;
+  if (REXCVAR_GET(vulkan_resolve_into_textures)) {
+    const xenos::Endian dest_endian = xenos::Endian(dest_info.copy_dest_endian);
+    auto find_destination = [&](xenos::TextureFormat texture_format) -> bool {
+      return texture_cache.FindNativeResolveDestination(
+          resolve_info.copy_dest_base, dest_pitch_texels, texture_format, dest_endian,
+          dest_offset_x, dest_offset_y, width, height, texture_destination);
+    };
+    bool found;
+    if (is_depth) {
+      // [rexglue-native] SDK 0302-r3: depth is normally sampled as depth -
+      // k_24_8 or k_24_8_FLOAT as the depth render target's format gives it
+      // (draw_util::GetResolveInfo puts that in copy_dest_info) - else, as
+      // before, as the register's format (k_8_8_8_8 from Direct3D 9).
+      found = find_destination(xenos::TextureFormat(dest_info.copy_dest_format));
+      if (!found) {
+        const reg::RB_COPY_DEST_INFO dest_info_register =
+            register_file().Get<reg::RB_COPY_DEST_INFO>();
+        if (dest_info_register.copy_dest_format != dest_info.copy_dest_format) {
+          found = find_destination(xenos::TextureFormat(dest_info_register.copy_dest_format));
+        }
+      }
+    } else {
+      found = find_destination(xenos::TextureFormat::k_8_8_8_8);
+    }
+    if (found) {
+      // Before the range is marked as resolved below.
+      texture_copy = texture_cache.GetNativeResolveCopy(texture_destination, is_depth,
+                                                        red_blue_swap, linear_red_blue_swap);
+      not_copied = native_census::kNativeRefused;
+    }
+  }
+  const VkDeviceSize linear_size = VkDeviceSize(texture_destination.width) *
+                                   texture_destination.height * sizeof(uint32_t);
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch_buffer_acquisition;
+  if (texture_copy == VulkanTextureCache::NativeResolveCopy::kBuffer) {
+    scratch_buffer_acquisition = command_processor_.AcquireScratchGpuBuffer(
+        linear_size, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+    if (scratch_buffer_acquisition.buffer() == VK_NULL_HANDLE) {
+      texture_copy = VulkanTextureCache::NativeResolveCopy::kNone;
+      not_copied = native_census::kNativeNoScratch;
+    }
+  }
+  const bool linear = texture_copy == VulkanTextureCache::NativeResolveCopy::kBuffer;
+  // [rexglue-native] SDK 0302-r3: depth texels for a texture sampling depth
+  // as depth are what its load shader would make of the word in memory.
+  NativeResolveLinearDepth linear_depth = kNativeResolveLinearDepthWord;
+  if (linear && is_depth) {
+    switch (texture_destination.texture->key().format) {
+      case xenos::TextureFormat::k_24_8:
+        linear_depth = kNativeResolveLinearDepthUnorm24;
+        break;
+      case xenos::TextureFormat::k_24_8_FLOAT:
+        linear_depth = kNativeResolveLinearDepthFloat20e4;
+        break;
+      default:
+        break;
+    }
+  }
+
+  NativeResolvePipelineKey pipeline_key;
+  pipeline_key.resource_format = rt_key.resource_format;
+  pipeline_key.is_depth = uint32_t(is_depth);
+  pipeline_key.source_is_uint = uint32_t(source_is_uint);
+  pipeline_key.endian = uint32_t(dest_info.copy_dest_endian);
+  pipeline_key.red_blue_swap = uint32_t(red_blue_swap);
+  pipeline_key.linear = uint32_t(linear);
+  pipeline_key.linear_red_blue_swap = uint32_t(linear && linear_red_blue_swap);
+  pipeline_key.linear_depth = uint32_t(linear_depth);
+  VkPipeline pipeline = GetNativeResolvePipeline(pipeline_key);
+  if (pipeline == VK_NULL_HANDLE) {
+    return skip(6, "no native resolve pipeline");
+  }
+
+  // The destination memory, as the EDRAM path binds it.
+  if (!shared_memory.RequestRange(resolve_info.copy_dest_extent_start,
+                                  resolve_info.copy_dest_extent_length)) {
+    return skip(7, "the destination memory couldn't be obtained");
+  }
+  const uint32_t copy_dest_range_length = resolve_info.copy_dest_extent_start -
+                                          resolve_info.copy_dest_base +
+                                          resolve_info.copy_dest_extent_length;
+  VkDescriptorSet descriptor_set_buffers = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferPairCompute);
+  if (descriptor_set_buffers == VK_NULL_HANDLE) {
+    return skip(8, "no descriptor set");
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkDescriptorBufferInfo buffer_infos[2];
+  buffer_infos[0].buffer = shared_memory.buffer();
+  buffer_infos[0].offset = resolve_info.copy_dest_base;
+  buffer_infos[0].range = copy_dest_range_length;
+  if (linear) {
+    buffer_infos[1].buffer = scratch_buffer_acquisition.buffer();
+    buffer_infos[1].offset = 0;
+    buffer_infos[1].range = linear_size;
+  } else {
+    // Not accessed by the pipeline, but must be valid.
+    buffer_infos[1] = buffer_infos[0];
+  }
+  VkWriteDescriptorSet descriptor_writes[2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    VkWriteDescriptorSet& descriptor_write = descriptor_writes[i];
+    descriptor_write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    descriptor_write.pNext = nullptr;
+    descriptor_write.dstSet = descriptor_set_buffers;
+    descriptor_write.dstBinding = i;
+    descriptor_write.dstArrayElement = 0;
+    descriptor_write.descriptorCount = 1;
+    descriptor_write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    descriptor_write.pImageInfo = nullptr;
+    descriptor_write.pBufferInfo = &buffer_infos[i];
+    descriptor_write.pTexelBufferView = nullptr;
+  }
+  dfn.vkUpdateDescriptorSets(device, 2, descriptor_writes, 0, nullptr);
+
+  // The render target: from its last use to a compute shader read (as the
+  // EDRAM dump does).
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_rt.image(),
+      ui::vulkan::util::InitializeSubresourceRange(
+          is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                   : VK_IMAGE_ASPECT_COLOR_BIT),
+      vulkan_rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      vulkan_rt.current_access_mask(), VK_ACCESS_SHADER_READ_BIT, vulkan_rt.current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  vulkan_rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  shared_memory.Use(VulkanSharedMemory::Usage::kComputeWrite,
+                    std::pair<uint32_t, uint32_t>(resolve_info.copy_dest_extent_start,
+                                                  resolve_info.copy_dest_extent_length));
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  VkPipelineLayout pipeline_layout =
+      is_depth ? native_resolve_pipeline_layout_depth_ : native_resolve_pipeline_layout_color_;
+  VkDescriptorSet descriptor_sets[2] = {descriptor_set_buffers,
+                                        vulkan_rt.GetDescriptorSetTransferSource()};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0, 2,
+                                         descriptor_sets, 0, nullptr);
+  uint32_t push_constants[kNativeResolvePushConstantCount];
+  push_constants[kNativeResolvePushConstantSource] = source_x | (source_y << 16);
+  push_constants[kNativeResolvePushConstantDestOrigin] = dest_offset_x | (dest_offset_y << 16);
+  push_constants[kNativeResolvePushConstantDestPitchTiles] =
+      dest_pitch_texels >> xenos::kTextureTileWidthHeightLog2;
+  push_constants[kNativeResolvePushConstantLinearSize] =
+      texture_destination.width | (texture_destination.height << 16);
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push_constants), push_constants);
+  command_processor_.SubmitBarriers(true);
+  // 8x8 texels per group; the area is whole 8x8 blocks.
+  command_buffer.CmdVkDispatch(width >> 3, height >> 3, 1);
+
+  // Every texture over the range is outdated now (and the range valid in
+  // shared memory) - the one written below is up to date again after it.
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                    resolve_info.copy_dest_extent_length);
+
+  switch (texture_copy) {
+    case VulkanTextureCache::NativeResolveCopy::kImage:
+      texture_cache.CopyImageIntoNativeResolveDestination(
+          texture_destination, red_blue_swap, vulkan_rt.image(), vulkan_rt.current_stage_mask(),
+          vulkan_rt.current_access_mask(), vulkan_rt.current_layout(), source_x, source_y);
+      vulkan_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+      break;
+    case VulkanTextureCache::NativeResolveCopy::kBuffer:
+      command_processor_.PushBufferMemoryBarrier(
+          scratch_buffer_acquisition.buffer(), 0, VK_WHOLE_SIZE,
+          scratch_buffer_acquisition.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT),
+          VK_PIPELINE_STAGE_TRANSFER_BIT,
+          scratch_buffer_acquisition.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT),
+          VK_ACCESS_TRANSFER_READ_BIT);
+      texture_cache.CopyBufferIntoNativeResolveDestination(texture_destination,
+                                                           scratch_buffer_acquisition.buffer());
+      break;
+    default:
+      break;
+  }
+
+  if (native_census::Active()) {
+    native_census::Counters& census = native_census::Get();
+    ++census.native_resolves;
+    if (texture_copy == VulkanTextureCache::NativeResolveCopy::kImage) {
+      ++census.native_into_texture_image;
+    } else if (texture_copy == VulkanTextureCache::NativeResolveCopy::kBuffer) {
+      ++census.native_into_texture_texels;
+    } else if (REXCVAR_GET(vulkan_resolve_into_textures)) {
+      ++census.native_not_copied[is_depth ? 1 : 0][not_copied];
+    }
+  }
+
+  static bool logged[2] = {};
+  if (!logged[is_depth ? 1 : 0]) {
+    logged[is_depth ? 1 : 0] = true;
+    REXGPU_INFO(
+        "native_render_targets: the first native {} resolve, {}x{} to 0x{:08X} (into its texture: "
+        "{})",
+        is_depth ? "depth" : "color", width, height, resolve_info.copy_dest_base,
+        texture_copy == VulkanTextureCache::NativeResolveCopy::kImage    ? "image copy"
+        : texture_copy == VulkanTextureCache::NativeResolveCopy::kBuffer ? "texel copy"
+                                                                          : "no");
+  }
+  return true;
+}
+
+VkPipeline VulkanRenderTargetCache::GetNativeResolvePipeline(NativeResolvePipelineKey key) {
+  auto pipeline_it = native_resolve_pipelines_.find(key);
+  if (pipeline_it != native_resolve_pipelines_.end()) {
+    return pipeline_it->second;
+  }
+  VkPipelineLayout pipeline_layout =
+      key.is_depth ? native_resolve_pipeline_layout_depth_ : native_resolve_pipeline_layout_color_;
+  if (pipeline_layout == VK_NULL_HANDLE) {
+    native_resolve_pipelines_.emplace(key, VkPipeline(VK_NULL_HANDLE));
+    return VK_NULL_HANDLE;
+  }
+
+  std::vector<spv::Id> id_vector_temp;
+
+  SpirvBuilder builder(spv::Spv_1_0, (SpirvShaderTranslator::kSpirvMagicToolId << 16) | 1, nullptr);
+  spv::Id ext_inst_glsl_std_450 = builder.import("GLSL.std.450");
+  builder.addCapability(spv::CapabilityShader);
+  builder.setMemoryModel(spv::AddressingModelLogical, spv::MemoryModelGLSL450);
+  builder.setSource(spv::SourceLanguageUnknown, 0);
+
+  spv::Id type_void = builder.makeVoidType();
+  spv::Id type_bool = builder.makeBoolType();
+  spv::Id type_int = builder.makeIntType(32);
+  spv::Id type_int2 = builder.makeVectorType(type_int, 2);
+  spv::Id type_uint = builder.makeUintType(32);
+  spv::Id type_uint3 = builder.makeVectorType(type_uint, 3);
+  spv::Id type_float = builder.makeFloatType(32);
+
+  // Set 0: binding 0 - shared memory from the destination base, binding 1 -
+  // the texture's texels, linearly. Write-only arrays of 32-bit words.
+  auto make_storage_buffer = [&](uint32_t binding, const char* type_name,
+                                 const char* variable_name) -> spv::Id {
+    id_vector_temp.clear();
+    id_vector_temp.push_back(builder.makeRuntimeArray(type_uint));
+    // Storage buffers have std430 packing, no padding to 4-component vectors.
+    builder.addDecoration(id_vector_temp.back(), spv::DecorationArrayStride,
+                          int(sizeof(uint32_t)));
+    spv::Id type_buffer = builder.makeStructType(id_vector_temp, type_name);
+    builder.addMemberName(type_buffer, 0, "words");
+    builder.addMemberDecoration(type_buffer, 0, spv::DecorationNonReadable);
+    builder.addMemberDecoration(type_buffer, 0, spv::DecorationOffset, 0);
+    // Block since SPIR-V 1.3, but since SPIR-V 1.0 is generated, it's
+    // BufferBlock.
+    builder.addDecoration(type_buffer, spv::DecorationBufferBlock);
+    // StorageBuffer since SPIR-V 1.3, but since SPIR-V 1.0 is generated, it's
+    // Uniform.
+    spv::Id buffer =
+        builder.createVariable(spv::NoPrecision, spv::StorageClassUniform, type_buffer, variable_name);
+    builder.addDecoration(buffer, spv::DecorationDescriptorSet, 0);
+    builder.addDecoration(buffer, spv::DecorationBinding, int(binding));
+    return buffer;
+  };
+  spv::Id dest_buffer = make_storage_buffer(0, "XeNativeResolveDest", "xe_native_resolve_dest");
+  spv::Id linear_buffer = spv::NoResult;
+  if (key.linear) {
+    linear_buffer =
+        make_storage_buffer(1, "XeNativeResolveLinear", "xe_native_resolve_linear");
+  }
+  // Set 1: the render target (binding 0, depth or color) and its stencil
+  // (binding 1), the transfer source descriptor set.
+  bool source_is_uint = !key.is_depth && key.source_is_uint;
+  spv::Id source_component_type = source_is_uint ? type_uint : type_float;
+  spv::Id source_texture = builder.createVariable(
+      spv::NoPrecision, spv::StorageClassUniformConstant,
+      builder.makeImageType(source_component_type, spv::Dim2D, false, false, false, 1,
+                            spv::ImageFormatUnknown),
+      "xe_native_resolve_source");
+  builder.addDecoration(source_texture, spv::DecorationDescriptorSet, 1);
+  builder.addDecoration(source_texture, spv::DecorationBinding, 0);
+  spv::Id source_stencil_texture = spv::NoResult;
+  if (key.is_depth) {
+    source_stencil_texture = builder.createVariable(
+        spv::NoPrecision, spv::StorageClassUniformConstant,
+        builder.makeImageType(type_uint, spv::Dim2D, false, false, false, 1,
+                              spv::ImageFormatUnknown),
+        "xe_native_resolve_stencil");
+    builder.addDecoration(source_stencil_texture, spv::DecorationDescriptorSet, 1);
+    builder.addDecoration(source_stencil_texture, spv::DecorationBinding, 1);
+  }
+  // Push constants.
+  id_vector_temp.clear();
+  id_vector_temp.reserve(kNativeResolvePushConstantCount);
+  for (uint32_t i = 0; i < kNativeResolvePushConstantCount; ++i) {
+    id_vector_temp.push_back(type_uint);
+  }
+  spv::Id type_push_constants =
+      builder.makeStructType(id_vector_temp, "XeNativeResolvePushConstants");
+  builder.addMemberName(type_push_constants, kNativeResolvePushConstantSource, "source");
+  builder.addMemberName(type_push_constants, kNativeResolvePushConstantDestOrigin, "dest_origin");
+  builder.addMemberName(type_push_constants, kNativeResolvePushConstantDestPitchTiles,
+                        "dest_pitch_tiles");
+  builder.addMemberName(type_push_constants, kNativeResolvePushConstantLinearSize, "linear_size");
+  for (uint32_t i = 0; i < kNativeResolvePushConstantCount; ++i) {
+    builder.addMemberDecoration(type_push_constants, i, spv::DecorationOffset,
+                                int(sizeof(uint32_t) * i));
+  }
+  builder.addDecoration(type_push_constants, spv::DecorationBlock);
+  spv::Id push_constants =
+      builder.createVariable(spv::NoPrecision, spv::StorageClassPushConstant, type_push_constants,
+                             "xe_native_resolve_push_constants");
+
+  // gl_GlobalInvocationID input.
+  spv::Id input_global_invocation_id = builder.createVariable(
+      spv::NoPrecision, spv::StorageClassInput, type_uint3, "gl_GlobalInvocationID");
+  builder.addDecoration(input_global_invocation_id, spv::DecorationBuiltIn,
+                        spv::BuiltInGlobalInvocationId);
+
+  // Begin the main function.
+  std::vector<spv::Id> main_param_types;
+  std::vector<std::vector<spv::Decoration>> main_precisions;
+  spv::Block* main_entry;
+  spv::Function* main_function = builder.makeFunctionEntry(
+      spv::NoPrecision, type_void, "main", main_param_types, main_precisions, &main_entry);
+
+  spv::Id const_uint_0 = builder.makeUintConstant(0);
+  spv::Id const_uint_8 = builder.makeUintConstant(8);
+  spv::Id const_uint_16 = builder.makeUintConstant(16);
+  auto load_push_constant = [&](uint32_t index) -> spv::Id {
+    id_vector_temp.clear();
+    id_vector_temp.push_back(builder.makeIntConstant(int(index)));
+    return builder.createLoad(
+        builder.createAccessChain(spv::StorageClassPushConstant, push_constants, id_vector_temp),
+        spv::NoPrecision);
+  };
+  auto low_16 = [&](spv::Id value) -> spv::Id {
+    return builder.createTriOp(spv::OpBitFieldUExtract, type_uint, value, const_uint_0,
+                               const_uint_16);
+  };
+  auto high_16 = [&](spv::Id value) -> spv::Id {
+    return builder.createBinOp(spv::OpShiftRightLogical, type_uint, value, const_uint_16);
+  };
+  auto swap_red_blue = [&](spv::Id value) -> spv::Id {
+    spv::Id red = builder.createTriOp(spv::OpBitFieldUExtract, type_uint, value, const_uint_0,
+                                      const_uint_8);
+    spv::Id blue = builder.createTriOp(spv::OpBitFieldUExtract, type_uint, value, const_uint_16,
+                                       const_uint_8);
+    value = builder.createQuadOp(spv::OpBitFieldInsert, type_uint, value, blue, const_uint_0,
+                                 const_uint_8);
+    return builder.createQuadOp(spv::OpBitFieldInsert, type_uint, value, red, const_uint_16,
+                                const_uint_8);
+  };
+  auto uint_and = [&](spv::Id value, uint32_t mask) -> spv::Id {
+    return builder.createBinOp(spv::OpBitwiseAnd, type_uint, value, builder.makeUintConstant(mask));
+  };
+  auto uint_shl = [&](spv::Id value, uint32_t shift) -> spv::Id {
+    return builder.createBinOp(spv::OpShiftLeftLogical, type_uint, value,
+                               builder.makeUintConstant(shift));
+  };
+  auto uint_shr = [&](spv::Id value, uint32_t shift) -> spv::Id {
+    return builder.createBinOp(spv::OpShiftRightLogical, type_uint, value,
+                               builder.makeUintConstant(shift));
+  };
+  auto uint_add = [&](spv::Id a, spv::Id b) -> spv::Id {
+    return builder.createBinOp(spv::OpIAdd, type_uint, a, b);
+  };
+
+  // The texel of the resolve this invocation writes.
+  spv::Id global_invocation_id = builder.createLoad(input_global_invocation_id, spv::NoPrecision);
+  spv::Id x = builder.createCompositeExtract(global_invocation_id, type_uint, 0);
+  spv::Id y = builder.createCompositeExtract(global_invocation_id, type_uint, 1);
+
+  // Load the render target's sample.
+  spv::Id source_xy = load_push_constant(kNativeResolvePushConstantSource);
+  spv::Builder::TextureParameters source_texture_parameters = {};
+  source_texture_parameters.sampler = builder.createLoad(source_texture, spv::NoPrecision);
+  id_vector_temp.clear();
+  id_vector_temp.push_back(
+      builder.createUnaryOp(spv::OpBitcast, type_int, uint_add(low_16(source_xy), x)));
+  id_vector_temp.push_back(
+      builder.createUnaryOp(spv::OpBitcast, type_int, uint_add(high_16(source_xy), y)));
+  source_texture_parameters.coords = builder.createCompositeConstruct(type_int2, id_vector_temp);
+  source_texture_parameters.lod = builder.makeIntConstant(0);
+  spv::Id source_vec4 = builder.createTextureCall(
+      spv::NoPrecision, builder.makeVectorType(source_component_type, 4), false, true, false, false,
+      false, source_texture_parameters, spv::ImageOperandsMaskNone);
+
+  // Pack it into the 32-bit word the EDRAM holds (as the EDRAM dump does).
+  spv::Id packed;
+  if (key.is_depth) {
+    source_texture_parameters.sampler =
+        builder.createLoad(source_stencil_texture, spv::NoPrecision);
+    spv::Id source_stencil = builder.createCompositeExtract(
+        builder.createTextureCall(spv::NoPrecision, builder.makeVectorType(type_uint, 4), false,
+                                  true, false, false, false, source_texture_parameters,
+                                  spv::ImageOperandsMaskNone),
+        type_uint, 0);
+    spv::Id source_depth32 = builder.createCompositeExtract(source_vec4, type_float, 0);
+    spv::Id depth24;
+    if (xenos::DepthRenderTargetFormat(key.resource_format) ==
+        xenos::DepthRenderTargetFormat::kD24FS8) {
+      depth24 = SpirvShaderTranslator::PreClampedDepthTo20e4(
+          builder, source_depth32, depth_float24_round(), true, ext_inst_glsl_std_450);
+    } else {
+      // Round to the nearest even integer, as the EDRAM dump does.
+      depth24 = builder.createUnaryOp(
+          spv::OpConvertFToU, type_uint,
+          builder.createUnaryBuiltinCall(
+              type_float, ext_inst_glsl_std_450, GLSLstd450RoundEven,
+              builder.createBinOp(spv::OpFMul, type_float, source_depth32,
+                                  builder.makeFloatConstant(float(0xFFFFFF)))));
+    }
+    // Stencil in 0:7, depth in 8:31.
+    packed = builder.createQuadOp(spv::OpBitFieldInsert, type_uint, source_stencil, depth24,
+                                  const_uint_8, builder.makeUintConstant(24));
+  } else {
+    // 8_8_8_8: red in 0:7 to alpha in 24:31.
+    spv::Id unorm_round_offset = builder.makeFloatConstant(0.5f);
+    spv::Id unorm_scale = builder.makeFloatConstant(255.0f);
+    auto component_uint = [&](uint32_t i) -> spv::Id {
+      spv::Id component = builder.createCompositeExtract(source_vec4, source_component_type, i);
+      if (source_is_uint) {
+        return component;
+      }
+      return builder.createUnaryOp(
+          spv::OpConvertFToU, type_uint,
+          builder.createBinOp(spv::OpFAdd, type_float,
+                              builder.createBinOp(spv::OpFMul, type_float, component, unorm_scale),
+                              unorm_round_offset));
+    };
+    packed = component_uint(0);
+    for (uint32_t i = 1; i < 4; ++i) {
+      packed = builder.createQuadOp(spv::OpBitFieldInsert, type_uint, packed, component_uint(i),
+                                    builder.makeUintConstant(8 * i), const_uint_8);
+    }
+  }
+
+  // The texture's texels, if asked, inside the texture only.
+  if (key.linear) {
+    spv::Id linear_value = key.linear_red_blue_swap ? swap_red_blue(packed) : packed;
+    // [rexglue-native] SDK 0302-r3: depth as the texture's load shader makes
+    // it from the word (endian-swapped back by it, so the word as packed).
+    if (key.is_depth) {
+      switch (NativeResolveLinearDepth(key.linear_depth)) {
+        case kNativeResolveLinearDepthUnorm24: {
+          // texture_load_depth_unorm: n = word >> 8;
+          // float(n + (n >> 23)) * 2^-24 (exact: n + 1 <= 2^24).
+          spv::Id depth_unorm24 = uint_shr(packed, 8);
+          spv::Id depth_float = builder.createBinOp(
+              spv::OpFMul, type_float,
+              builder.createUnaryOp(spv::OpConvertUToF, type_float,
+                                    uint_add(depth_unorm24, uint_shr(depth_unorm24, 23))),
+              builder.makeFloatConstant(1.0f / float(1 << 24)));
+          linear_value = builder.createUnaryOp(spv::OpBitcast, type_uint, depth_float);
+        } break;
+        case kNativeResolveLinearDepthFloat20e4:
+          // texture_load_depth_float: the 20e4 in bits 8:31 to float32, zero
+          // to zero, denormals normalized, without the 0...0.5 remapping.
+          linear_value = SpirvShaderTranslator::Depth20e4To32(builder, packed, 8, false, true,
+                                                              ext_inst_glsl_std_450);
+          break;
+        default:
+          break;
+      }
+    }
+    spv::Id linear_size = load_push_constant(kNativeResolvePushConstantLinearSize);
+    spv::Id linear_width = low_16(linear_size);
+    spv::Id linear_inside = builder.createBinOp(
+        spv::OpLogicalAnd, type_bool,
+        builder.createBinOp(spv::OpULessThan, type_bool, x, linear_width),
+        builder.createBinOp(spv::OpULessThan, type_bool, y, high_16(linear_size)));
+    SpirvBuilder::IfBuilder linear_inside_if(linear_inside, spv::SelectionControlMaskNone,
+                                             builder);
+    {
+      spv::Id linear_index =
+          uint_add(builder.createBinOp(spv::OpIMul, type_uint, y, linear_width), x);
+      id_vector_temp.clear();
+      // The only SSBO structure member.
+      id_vector_temp.push_back(builder.makeIntConstant(0));
+      id_vector_temp.push_back(builder.createUnaryOp(spv::OpBitcast, type_int, linear_index));
+      builder.createStore(linear_value, builder.createAccessChain(spv::StorageClassUniform,
+                                                                  linear_buffer, id_vector_temp));
+    }
+    linear_inside_if.makeEndIf();
+  }
+
+  // The word in guest memory: red and blue swapped if asked, then endian.
+  spv::Id dest_value = key.red_blue_swap ? swap_red_blue(packed) : packed;
+  switch (xenos::Endian128(key.endian)) {
+    case xenos::Endian128::k8in16:
+    case xenos::Endian128::k8in32:
+      dest_value = builder.createBinOp(spv::OpBitwiseOr, type_uint,
+                                       uint_shl(uint_and(dest_value, 0x00FF00FF), 8),
+                                       uint_and(uint_shr(dest_value, 8), 0x00FF00FF));
+      if (xenos::Endian128(key.endian) == xenos::Endian128::k8in32) {
+        dest_value = builder.createBinOp(spv::OpBitwiseOr, type_uint, uint_shl(dest_value, 16),
+                                         uint_shr(dest_value, 16));
+      }
+      break;
+    case xenos::Endian128::k16in32:
+      dest_value = builder.createBinOp(spv::OpBitwiseOr, type_uint, uint_shl(dest_value, 16),
+                                       uint_shr(dest_value, 16));
+      break;
+    default:
+      break;
+  }
+
+  // Its 32bpp tiled address (texture_util::GetTiledOffset2D with 4 bytes per
+  // block), relative to the destination base, which the resolve moved to the
+  // 32x32 tile it starts in.
+  spv::Id dest_origin = load_push_constant(kNativeResolvePushConstantDestOrigin);
+  spv::Id dest_x = uint_add(low_16(dest_origin), x);
+  spv::Id dest_y = uint_add(high_16(dest_origin), y);
+  spv::Id dest_pitch_tiles = load_push_constant(kNativeResolvePushConstantDestPitchTiles);
+  // macro = ((x >> 5) + (y >> 5) * (pitch >> 5)) << 9
+  spv::Id tiled_macro = uint_shl(
+      uint_add(uint_shr(dest_x, 5),
+               builder.createBinOp(spv::OpIMul, type_uint, uint_shr(dest_y, 5), dest_pitch_tiles)),
+      9);
+  // micro = ((x & 7) + ((y & 0xE) << 2)) << 2
+  spv::Id tiled_micro =
+      uint_shl(uint_add(uint_and(dest_x, 7), uint_shl(uint_and(dest_y, 0xE), 2)), 2);
+  // offset = macro + ((micro & ~0xF) << 1) + (micro & 0xF) + ((y & 1) << 4)
+  spv::Id tiled_offset =
+      uint_add(uint_add(tiled_macro, uint_shl(uint_and(tiled_micro, ~uint32_t(0xF)), 1)),
+               uint_add(uint_and(tiled_micro, 0xF), uint_shl(uint_and(dest_y, 1), 4)));
+  // ((offset & ~0x1FF) << 3) + ((y & 16) << 7) + ((offset & 0x1C0) << 2) +
+  // ((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 0x3F)
+  spv::Id tiled_address = uint_add(
+      uint_add(uint_shl(uint_and(tiled_offset, ~uint32_t(0x1FF)), 3),
+               uint_shl(uint_and(dest_y, 16), 7)),
+      uint_add(uint_add(uint_shl(uint_and(tiled_offset, 0x1C0), 2),
+                        uint_shl(uint_and(uint_add(uint_shr(uint_and(dest_y, 8), 2),
+                                                   uint_shr(dest_x, 3)),
+                                          3),
+                                 6)),
+               uint_and(tiled_offset, 0x3F)));
+  id_vector_temp.clear();
+  // The only SSBO structure member.
+  id_vector_temp.push_back(builder.makeIntConstant(0));
+  id_vector_temp.push_back(
+      builder.createUnaryOp(spv::OpBitcast, type_int, uint_shr(tiled_address, 2)));
+  builder.createStore(dest_value,
+                      builder.createAccessChain(spv::StorageClassUniform, dest_buffer,
+                                                id_vector_temp));
+
+  // End the main function and make it the entry point.
+  builder.leaveFunction();
+  builder.addExecutionMode(main_function, spv::ExecutionModeLocalSize, 8, 8, 1);
+  spv::Instruction* entry_point =
+      builder.addEntryPoint(spv::ExecutionModelGLCompute, main_function, "main");
+  // Bindings only need to be added to the entry point's interface starting with
+  // SPIR-V 1.4 - emitting 1.0 here, so only inputs / outputs.
+  entry_point->addIdOperand(input_global_invocation_id);
+
+  // Serialize the shader code.
+  std::vector<unsigned int> shader_code;
+  builder.dump(shader_code);
+
+  // Create the pipeline, and store the handle even if creation fails not to try
+  // to create it again later.
+  VkPipeline pipeline = ui::vulkan::util::CreateComputePipeline(
+      command_processor_.GetVulkanDevice(), pipeline_layout,
+      reinterpret_cast<const uint32_t*>(shader_code.data()), sizeof(uint32_t) * shader_code.size());
+  if (pipeline == VK_NULL_HANDLE) {
+    REXGPU_ERROR(
+        "VulkanRenderTargetCache: Failed to create a native resolve pipeline (key 0x{:08X})",
+        key.key);
+  }
+  native_resolve_pipelines_.emplace(key, pipeline);
+  return pipeline;
+}
+
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/texture_cache.cpp b/src/graphics/vulkan/texture_cache.cpp
index 9ffbfe5..8aced71 100644
--- a/src/graphics/vulkan/texture_cache.cpp
+++ b/src/graphics/vulkan/texture_cache.cpp
@@ -2746,6 +2746,245 @@ bool VulkanTextureCache::CopyResolveIntoTexture(
