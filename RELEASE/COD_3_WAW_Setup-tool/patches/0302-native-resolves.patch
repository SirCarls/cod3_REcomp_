+RenderTargetCache::RenderTarget* RenderTargetCache::FindResolveSourceRenderTarget(
+    const draw_util::ResolveInfo& resolve_info, uint32_t& source_x_out,
+    uint32_t& source_y_out) const {
+  // [rexglue-native] SDK 0302: see the declaration.
+  source_x_out = 0;
+  source_y_out = 0;
+  const bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  if (edram_info.msaa_samples != xenos::MsaaSamples::k1X || edram_info.format_is_64bpp ||
+      !edram_info.pitch_tiles) {
+    return nullptr;
+  }
+  RenderTargetKey key;
+  key.base_tiles = is_depth ? resolve_info.depth_original_base : resolve_info.color_original_base;
+  key.pitch_tiles_at_32bpp = edram_info.pitch_tiles;
+  key.msaa_samples = edram_info.msaa_samples;
+  key.is_depth = uint32_t(is_depth);
+  key.resource_format =
+      is_depth ? uint32_t(edram_info.format)
+               : uint32_t(GetColorResourceFormat(xenos::ColorRenderTargetFormat(edram_info.format)));
+  auto it = render_targets_.find(key);
+  if (it == render_targets_.end() || !it->second) {
+    return nullptr;
+  }
+  // The resolve's area: whole tiles from the render target's base, then the
+  // offset within the first tile (as PrepareHostRenderTargetsResolveClear).
+  const uint32_t pitch_tiles = edram_info.pitch_tiles;
+  const uint32_t tile_offset =
+      (edram_info.GetBaseTiles() - uint32_t(key.base_tiles)) & (xenos::kEdramTileCount - 1);
+  source_x_out = (tile_offset % pitch_tiles) * xenos::kEdramTileWidthSamples +
+                 (uint32_t(resolve_info.coordinate_info.edram_offset_x_div_8)
+                  << xenos::kResolveAlignmentPixelsLog2);
+  source_y_out = (tile_offset / pitch_tiles) * xenos::kEdramTileHeightSamples +
+                 (uint32_t(resolve_info.coordinate_info.edram_offset_y_div_8)
+                  << xenos::kResolveAlignmentPixelsLog2);
+  return it->second;
+}
