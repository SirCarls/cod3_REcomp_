+// [rexglue-native] SDK 0308: a native resolve with a draw resolution scale.
+
+void VulkanTextureCache::CopyImageIntoNativeResolveDestinationScaled(
+    const NativeResolveDestination& destination, bool red_blue_swap, VkImage source_image,
+    VkPipelineStageFlags source_stage_mask, VkAccessFlags source_access_mask,
+    VkImageLayout source_layout, uint32_t source_x, uint32_t source_y, uint32_t fill_x,
+    uint32_t fill_y) {
+  if (!destination.texture || !destination.width || !destination.height) {
+    return;
+  }
+  VulkanTexture& texture = *static_cast<VulkanTexture*>(destination.texture);
+  const uint32_t scale_x = draw_resolution_scale_x();
+  const uint32_t scale_y = draw_resolution_scale_y();
+  // In host pixels.
+  const uint32_t dest_x = destination.dest_x * scale_x;
+  const uint32_t dest_y = destination.dest_y * scale_y;
+  const uint32_t width = destination.width * scale_x;
+  const uint32_t height = destination.height * scale_y;
+  // A whole 8x8 block at least is copied, the gap is less than a guest pixel.
+  fill_x = std::min(fill_x, width - 1);
+  fill_y = std::min(fill_y, height - 1);
+  command_processor_.PushImageMemoryBarrier(
+      source_image, ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+      source_stage_mask, VK_PIPELINE_STAGE_TRANSFER_BIT, source_access_mask,
+      VK_ACCESS_TRANSFER_READ_BIT, source_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  BeginNativeResolveTextureWrite(texture);
+  command_processor_.SubmitBarriers(true);
+  // The area past the gap as it is; then each column of the gap from the first
+  // column after it, each row of the gap from the first row after it, and each
+  // pixel of the corner from the first pixel after both (none overlap in the
+  // texture, as one copy command requires).
+  const uint32_t region_count = (fill_x + 1) * (fill_y + 1);
+  VkImageCopy* regions = command_processor_.deferred_command_buffer().CmdCopyImageEmplace(
+      source_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region_count);
+  uint32_t region_index = 0;
+  for (uint32_t gap_y = 0; gap_y <= fill_y; ++gap_y) {
+    // gap_y == fill_y: the rows past the gap.
+    for (uint32_t gap_x = 0; gap_x <= fill_x; ++gap_x) {
+      VkImageCopy& region = regions[region_index++];
+      region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+      region.srcSubresource.mipLevel = 0;
+      region.srcSubresource.baseArrayLayer = 0;
+      region.srcSubresource.layerCount = 1;
+      region.srcOffset.x = int32_t(source_x + fill_x);
+      region.srcOffset.y = int32_t(source_y + fill_y);
+      region.srcOffset.z = 0;
+      region.dstSubresource = region.srcSubresource;
+      region.dstOffset.x = int32_t(dest_x + gap_x);
+      region.dstOffset.y = int32_t(dest_y + gap_y);
+      region.dstOffset.z = 0;
+      region.extent.width = gap_x < fill_x ? 1 : width - fill_x;
+      region.extent.height = gap_y < fill_y ? 1 : height - fill_y;
+      region.extent.depth = 1;
+    }
+  }
+  // Only when the whole texture is written (GetNativeResolveCopy).
+  if (texture.red_blue_swapped() != red_blue_swap) {
+    texture.set_red_blue_swapped(red_blue_swap);
+    RecheckTextureBindings();
+  }
+  MarkTextureUpToDate(texture);
+}
