+// [rexglue-native] SDK 0309: native resolve records.
+
+void VulkanRenderTargetCache::ClearNativeResolveRecords() {
+  for (NativeResolveRecord& record : native_resolve_records_) {
+    record.render_target = nullptr;
+  }
+  native_resolve_record_next_ = 0;
+}
+
+void VulkanRenderTargetCache::InvalidateNativeResolveRecords(uint32_t start, uint32_t length) {
+  const uint64_t end = uint64_t(start) + length;
+  for (NativeResolveRecord& record : native_resolve_records_) {
+    if (record.render_target && record.extent_start < end && start < record.extent_end) {
+      record.render_target = nullptr;
+    }
+  }
+}
+
+void VulkanRenderTargetCache::AddNativeResolveRecord(const NativeResolveRecord& record) {
+  InvalidateNativeResolveRecords(record.extent_start, record.extent_end - record.extent_start);
+  native_resolve_records_[native_resolve_record_next_] = record;
+  native_resolve_record_next_ = (native_resolve_record_next_ + 1) % kNativeResolveRecordCount;
+}
+
+void VulkanRenderTargetCache::BumpNativeContentsGenerations(RenderTarget* const* render_targets,
+                                                            uint32_t count) {
+  for (uint32_t i = 0; i < count; ++i) {
+    if (render_targets[i]) {
+      static_cast<VulkanRenderTarget*>(render_targets[i])->BumpNativeContentsGeneration();
+    }
+  }
+}
+
+bool VulkanRenderTargetCache::RefillFromNativeResolveRecordThunk(
+    void* context, VulkanTextureCache& texture_cache,
+    const VulkanTextureCache::NativeResolveDestination& destination) {
+  return static_cast<VulkanRenderTargetCache*>(context)->RefillFromNativeResolveRecord(
+      texture_cache, destination);
+}
+
+bool VulkanRenderTargetCache::RefillFromNativeResolveRecord(
+    VulkanTextureCache& texture_cache,
+    const VulkanTextureCache::NativeResolveDestination& destination) {
+  // A scaled 8888 texture covering all of destination (TryNativeScaledRefill).
+  if (!native_resolve_records_active_ || !destination.texture || !IsDrawResolutionScaled()) {
+    return false;
+  }
+  const auto& key = destination.texture->key();
+  const uint32_t texture_width = destination.width;
+  const uint32_t texture_height = destination.height;
+  for (const NativeResolveRecord& record : native_resolve_records_) {
+    if (!record.render_target || record.pitch_tiles != key.pitch ||
+        record.endian != key.endianness || key.base_page < record.dest_page) {
+      continue;
+    }
+    // Where the texture starts relative to the tile the record's area starts
+    // in: whole 32x32 tiles of 4 KB (as FindNativeResolveDestination).
+    const uint32_t tiles = key.base_page - record.dest_page;
+    const uint32_t texture_x = (tiles % record.pitch_tiles) << 5;
+    const uint32_t texture_y = (tiles / record.pitch_tiles) << 5;
+    // All of the texture must be in the area. Records don't overlap, so no
+    // other one has any of it.
+    if (texture_x < record.offset_x || texture_y < record.offset_y ||
+        texture_x + texture_width > record.offset_x + record.width ||
+        texture_y + texture_height > record.offset_y + record.height) {
+      continue;
+    }
+    VulkanRenderTarget& vulkan_rt = *record.render_target;
+    if (vulkan_rt.native_contents_generation() != record.render_target_generation) {
+      // Drawn into or cleared since: the scaled resolve memory has it.
+      return false;
+    }
+    bool linear_red_blue_swap;
+    if (texture_cache.GetNativeResolveCopy(destination, false, record.red_blue_swap,
+                                           linear_red_blue_swap) !=
+        VulkanTextureCache::NativeResolveCopy::kImage) {
+      return false;
+    }
+    const uint32_t scale_x = draw_resolution_scale_x();
+    const uint32_t scale_y = draw_resolution_scale_y();
+    // The half-pixel offset gap is at the area's left and top edges only.
+    const uint32_t fill_x =
+        (record.fill_half_pixel_offset && texture_x == record.offset_x) ? (scale_x >> 1) : 0;
+    const uint32_t fill_y =
+        (record.fill_half_pixel_offset && texture_y == record.offset_y) ? (scale_y >> 1) : 0;
+    texture_cache.CopyImageIntoNativeResolveDestinationScaled(
+        destination, record.red_blue_swap, vulkan_rt.image(), vulkan_rt.current_stage_mask(),
+        vulkan_rt.current_access_mask(), vulkan_rt.current_layout(),
+        (record.source_x + (texture_x - record.offset_x)) * scale_x,
+        (record.source_y + (texture_y - record.offset_y)) * scale_y, fill_x, fill_y);
+    vulkan_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                       VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      REXGPU_INFO(
+          "native_resolve_records_at_draw_scale: the first texture copied from a render target a "
+          "native resolve recorded, {}x{} at page 0x{:05X}",
+          texture_width, texture_height, uint32_t(key.base_page));
+    }
+    return true;
+  }
+  return false;
+}
