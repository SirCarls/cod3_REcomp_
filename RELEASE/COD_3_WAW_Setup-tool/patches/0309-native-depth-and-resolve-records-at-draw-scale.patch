+      key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      key.signed_separate || key.format != xenos::TextureFormat::k_8_8_8_8) {
+    return false;
+  }
+  if (key.packed_mips && (key.GetWidth() <= 16 || key.GetHeight() <= 16)) {
+    return false;
+  }
+  if (texture.is_replacement() || texture.GetGuestMipsSize() || !texture.GetGuestBaseSize()) {
+    return false;
+  }
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  if (host_format_pair.format_unsigned.load_shader != kLoadShaderIndex32bpb ||
+      host_format_pair.format_unsigned.format != VK_FORMAT_R8G8B8A8_UNORM) {
+    return false;
+  }
+  NativeResolveDestination destination;
+  destination.texture = &texture;
+  destination.dest_x = 0;
+  destination.dest_y = 0;
+  destination.width = key.GetWidth();
+  destination.height = key.GetHeight();
+  return native_scaled_refill_(native_scaled_refill_context_, *this, destination);
+}
