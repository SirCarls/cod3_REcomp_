+bool VulkanTextureCache::TryNativeScaledRefill(VulkanTexture& texture) {
+  // A texture a native color resolve could have been copied into
+  // (FindNativeResolveDestination's candidates with scaled, 8888 only), all of
+  // it, so its red and blue order can be set for the copy.
