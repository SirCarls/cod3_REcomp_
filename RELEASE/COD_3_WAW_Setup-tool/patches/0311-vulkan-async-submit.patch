+// [rexglue-native] SDK 0305: vulkan_async_submit - the submit thread.
+
+void VulkanCommandProcessor::InitializeAsyncSubmit() {
+  async_submit_ = REXCVAR_GET(vulkan_async_submit);
+  if (!async_submit_) {
+    return;
+  }
+  for (std::unique_ptr<AsyncSubmitJob>& job : async_submit_jobs_) {
+    if (!job) {
+      job = std::make_unique<AsyncSubmitJob>(*this);
+    }
+  }
+  async_submit_jobs_enqueued_ = 0;
+  async_submit_jobs_done_ = 0;
+  async_submit_shutdown_ = false;
+  // [rexglue-native] SDK 0305-r2: no presenter tail handed over yet.
+  async_submit_presenter_tail_ = nullptr;
+  async_submit_presenter_tail_running_ = false;
+  // Everything closed so far has been submitted on this thread.
+  async_submit_processed_.store(GetCurrentSubmission() - 1, std::memory_order_relaxed);
+  async_submit_failed_.store(false, std::memory_order_relaxed);
+  async_submit_thread_ = std::thread([this]() { AsyncSubmitThread(); });
+  REXGPU_INFO("Vulkan: command buffers are submitted on a separate thread (vulkan_async_submit)");
+}
+
+void VulkanCommandProcessor::ShutdownAsyncSubmit() {
+  if (async_submit_thread_.joinable()) {
+    {
+      std::lock_guard<std::mutex> lock(async_submit_mutex_);
+      async_submit_shutdown_ = true;
+    }
+    async_submit_work_cond_.notify_one();
+    // It finishes (or, after a failure, drops) everything handed to it first.
+    async_submit_thread_.join();
+  }
+  // [rexglue-native] SDK 0305-r2: it has run the presenter tail it was handed
+  // too (it's handed one only while it has submissions left) - but in case,
+  // don't leave one not run.
+  if (async_submit_presenter_tail_) {
+    std::function<void()> presenter_tail = std::move(async_submit_presenter_tail_);
+    async_submit_presenter_tail_ = nullptr;
+    presenter_tail();
+  }
+  async_submit_ = false;
+}
+
+bool VulkanCommandProcessor::EnqueueAsyncSubmission() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  assert_false(command_buffers_writable_.empty());
+  assert_false(fences_free_.empty());
+  VkFence fence = fences_free_.back();
+  if (dfn.vkResetFences(device, 1, &fence) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to reset a Vulkan submission fence");
+    return false;
+  }
+
+  // A free job: the submit thread is at most kAsyncSubmitJobs submissions
+  // behind.
+  AsyncSubmitJob* job;
+  {
+    std::unique_lock<std::mutex> lock(async_submit_mutex_);
+    async_submit_done_cond_.wait(lock, [this]() {
+      return async_submit_jobs_enqueued_ - async_submit_jobs_done_ < kAsyncSubmitJobs;
+    });
+    job = async_submit_jobs_[async_submit_jobs_enqueued_ % kAsyncSubmitJobs].get();
+  }
+
+  uint64_t submission_current = GetCurrentSubmission();
+  job->submission = submission_current;
+  job->command_buffer = command_buffers_writable_.back();
+  job->fence = fence;
+  job->wait_semaphores.assign(current_submission_wait_semaphores_.cbegin(),
+                              current_submission_wait_semaphores_.cend());
+  job->wait_stage_masks.assign(current_submission_wait_stage_masks_.cbegin(),
+                               current_submission_wait_stage_masks_.cend());
+  // The recorded commands change places with the job's previous ones (already
+  // executed, dropped here) - no copy.
+  job->commands.SwapStream(deferred_command_buffer_);
+  deferred_command_buffer_.Reset();
+  // The graphics card's time, as in EndSubmission.
+  job->gpu_time_query_pool = gpu_time_query_pool_;
+  job->gpu_time_slot = UINT32_MAX;
+  if (gpu_time_query_pool_ != VK_NULL_HANDLE) {
+    const uint32_t slot = uint32_t(submission_current % kGpuTimeSlots);
+    if (!gpu_time_slot_submissions_[slot]) {
+      job->gpu_time_slot = slot;
+      gpu_time_slot_submissions_[slot] = submission_current;
+    }
+  }
+  job->gpu_section_query_pool = VK_NULL_HANDLE;
+  if (gpu_section_recording_) {
+    job->gpu_section_query_pool = gpu_section_query_pool_;
+    job->gpu_section_first_query = gpu_section_current_.first_query;
+    job->gpu_section_query_count = gpu_section_current_.query_count;
+    job->gpu_section_start_query = gpu_section_current_.start_query;
+    job->gpu_section_end_query = gpu_section_current_.end_query;
+    gpu_section_current_.submission = submission_current;
+    gpu_section_current_.last = gpu_section_;
+    gpu_section_submitted_.push_back(std::move(gpu_section_current_));
+    gpu_section_current_ = GpuSectionSubmission();
+    gpu_section_recording_ = false;
+  }
+
+  // The rest of the bookkeeping done after vkQueueSubmit in EndSubmission.
+  stats::Add(stats::Counter::kSubmissions);
+  current_submission_wait_stage_masks_.clear();
+  for (VkSemaphore semaphore : current_submission_wait_semaphores_) {
+    submissions_in_flight_semaphores_.emplace_back(submission_current, semaphore);
+  }
+  current_submission_wait_semaphores_.clear();
+  command_buffers_submitted_.emplace_back(submission_current, command_buffers_writable_.back());
+  command_buffers_writable_.pop_back();
+  // Increments the current submission number, going to the next submission.
+  submissions_in_flight_fences_.push_back(fence);
+  fences_free_.pop_back();
+
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    ++async_submit_jobs_enqueued_;
+  }
+  async_submit_work_cond_.notify_one();
+
+  submission_open_ = false;
+  return true;
+}
+
+bool VulkanCommandProcessor::AwaitAsyncSubmission(uint64_t submission) {
+  // Not past what has been handed to the submit thread.
+  submission = std::min(submission, GetCurrentSubmission() - 1);
+  if (async_submit_processed_.load(std::memory_order_acquire) < submission) {
+    std::unique_lock<std::mutex> lock(async_submit_mutex_);
+    async_submit_done_cond_.wait(lock, [this, submission]() {
+      return async_submit_processed_.load(std::memory_order_relaxed) >= submission ||
+             async_submit_jobs_done_ == async_submit_jobs_enqueued_;
+    });
+  }
+  return !async_submit_failed_.load(std::memory_order_acquire);
+}
+
+// [rexglue-native] SDK 0305-r2: see the declarations.
+void VulkanCommandProcessor::DeferAsyncSubmitPresenterTail(std::function<void()> tail) {
+  // [rexglue-native] SDK 0305-r3: kept for the GPU thread to run (see
+  // RunAsyncSubmitPresenterTailIfReady), not handed to the submit thread.
+  bool deferred = false;
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    // One at a time - the previous one is awaited before the next refresh.
+    assert_false(async_submit_presenter_tail_ || async_submit_presenter_tail_running_);
+    if (async_submit_jobs_done_ != async_submit_jobs_enqueued_) {
+      async_submit_presenter_tail_ = std::move(tail);
+      async_submit_presenter_tail_after_ = GetCurrentSubmission() - 1;
+      deferred = true;
+    }
+  }
+  if (deferred) {
+    REXGPU_DEBUG("Vulkan async submit: presenter tail deferred after submission {}",
+                 async_submit_presenter_tail_after_);
+    return;
+  }
+  // The thread has already passed everything handed to it to vkQueueSubmit.
+  tail();
+}
+
+void VulkanCommandProcessor::AwaitAsyncSubmitPresenterTail() {
+  // [rexglue-native] SDK 0305-r3: waits (a predicate wait under the mutex,
+  // notified after every job) only for the submit thread to pass the tail's
+  // submission to vkQueueSubmit, then runs the tail here with no lock held.
+  {
+    std::unique_lock<std::mutex> lock(async_submit_mutex_);
+    if (!async_submit_presenter_tail_) {
+      return;
+    }
+    async_submit_done_cond_.wait(lock, [this]() {
+      return async_submit_processed_.load(std::memory_order_relaxed) >=
+                 async_submit_presenter_tail_after_ ||
+             async_submit_jobs_done_ == async_submit_jobs_enqueued_;
+    });
+  }
+  RunAsyncSubmitPresenterTailIfReady();
+}
+
+// [rexglue-native] SDK 0305-r3: see the declarations. GPU thread only.
+void VulkanCommandProcessor::RunAsyncSubmitPresenterTailIfReady() {
+  std::function<void()> presenter_tail;
+  uint64_t processed = 0;
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    if (!async_submit_presenter_tail_) {
+      return;
+    }
+    processed = async_submit_processed_.load(std::memory_order_relaxed);
+    if (processed < async_submit_presenter_tail_after_ &&
+        async_submit_jobs_done_ != async_submit_jobs_enqueued_) {
+      return;
+    }
+    presenter_tail = std::move(async_submit_presenter_tail_);
+    async_submit_presenter_tail_ = nullptr;
+  }
+  REXGPU_DEBUG("Vulkan async submit: presenter tail after submission {} run (processed {})",
+               async_submit_presenter_tail_after_, processed);
+  presenter_tail();
+}
+
+void VulkanCommandProcessor::AsyncSubmitThread() {
+  // [rexglue-native] SDK 0305-r3: a name of its own (it would inherit "GPU
+  // Commands" from the thread creating it), to tell the two apart.
+  rex::thread::set_current_thread_name("GPU Submit");
+  for (;;) {
+    AsyncSubmitJob* job;
+    {
+      std::unique_lock<std::mutex> lock(async_submit_mutex_);
+      async_submit_work_cond_.wait(lock, [this]() {
+        return async_submit_jobs_done_ != async_submit_jobs_enqueued_ || async_submit_shutdown_;
+      });
+      if (async_submit_jobs_done_ == async_submit_jobs_enqueued_) {
+        return;
+      }
+      job = async_submit_jobs_[async_submit_jobs_done_ % kAsyncSubmitJobs].get();
+    }
+    // After a failure, the rest is only retired, not submitted - the GPU
+    // thread handles it as a device loss.
+    if (!async_submit_failed_.load(std::memory_order_relaxed) && !ExecuteAsyncSubmission(*job)) {
+      async_submit_failed_.store(true, std::memory_order_release);
+    }
+    const uint64_t submission = job->submission;
+    // [rexglue-native] SDK 0305-r3: no presenter tail here any more - only the
+    // GPU thread runs it (RunAsyncSubmitPresenterTailIfReady), so this thread
+    // waits for nothing but jobs and never holds up the ring.
+    {
+      std::lock_guard<std::mutex> lock(async_submit_mutex_);
+      async_submit_processed_.store(submission, std::memory_order_release);
+      ++async_submit_jobs_done_;
+    }
+    async_submit_done_cond_.notify_all();
+  }
+}
+
+bool VulkanCommandProcessor::ExecuteAsyncSubmission(AsyncSubmitJob& job) {
+  // On the submit thread: what EndSubmission does after SubmitBarriers without
+  // vulkan_async_submit, other than the bookkeeping.
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  const CommandBuffer& command_buffer = job.command_buffer;
+  if (dfn.vkResetCommandPool(device, command_buffer.pool, 0) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to reset a Vulkan command pool");
+    return false;
+  }
+  VkCommandBufferBeginInfo command_buffer_begin_info;
+  command_buffer_begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+  command_buffer_begin_info.pNext = nullptr;
+  command_buffer_begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  command_buffer_begin_info.pInheritanceInfo = nullptr;
+  if (dfn.vkBeginCommandBuffer(command_buffer.buffer, &command_buffer_begin_info) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to begin a Vulkan command buffer");
+    return false;
+  }
+  if (job.gpu_section_query_pool != VK_NULL_HANDLE) {
+    // The submission's queries are reset before any of them is written.
+    const uint32_t first_part =
+        std::min(job.gpu_section_query_count, kGpuSectionQueries - job.gpu_section_first_query);
+    dfn.vkCmdResetQueryPool(command_buffer.buffer, job.gpu_section_query_pool,
+                            job.gpu_section_first_query, first_part);
+    if (first_part < job.gpu_section_query_count) {
+      dfn.vkCmdResetQueryPool(command_buffer.buffer, job.gpu_section_query_pool, 0,
+                              job.gpu_section_query_count - first_part);
+    }
+    dfn.vkCmdWriteTimestamp(command_buffer.buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                            job.gpu_section_query_pool, job.gpu_section_start_query);
+  }
+  if (job.gpu_time_slot != UINT32_MAX) {
+    dfn.vkCmdResetQueryPool(command_buffer.buffer, job.gpu_time_query_pool,
+                            job.gpu_time_slot * 2, 2);
+    dfn.vkCmdWriteTimestamp(command_buffer.buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                            job.gpu_time_query_pool, job.gpu_time_slot * 2);
+  }
+  job.commands.Execute(command_buffer.buffer);
+  if (job.gpu_time_slot != UINT32_MAX) {
+    dfn.vkCmdWriteTimestamp(command_buffer.buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                            job.gpu_time_query_pool, job.gpu_time_slot * 2 + 1);
+  }
+  if (job.gpu_section_query_pool != VK_NULL_HANDLE) {
+    dfn.vkCmdWriteTimestamp(command_buffer.buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                            job.gpu_section_query_pool, job.gpu_section_end_query);
+  }
+  if (dfn.vkEndCommandBuffer(command_buffer.buffer) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to end a Vulkan command buffer");
+    return false;
+  }
+
+  VkSubmitInfo submit_info;
+  submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+  submit_info.pNext = nullptr;
+  if (!job.wait_semaphores.empty()) {
+    submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+    submit_info.pWaitSemaphores = job.wait_semaphores.data();
+    submit_info.pWaitDstStageMask = job.wait_stage_masks.data();
+  } else {
+    submit_info.waitSemaphoreCount = 0;
+    submit_info.pWaitSemaphores = nullptr;
+    submit_info.pWaitDstStageMask = nullptr;
+  }
+  submit_info.commandBufferCount = 1;
+  submit_info.pCommandBuffers = &command_buffer.buffer;
+  submit_info.signalSemaphoreCount = 0;
+  submit_info.pSignalSemaphores = nullptr;
+  VkResult submit_result;
+  {
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+    submit_result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence);
+  }
+  if (submit_result != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to submit a Vulkan command buffer");
+    return false;
+  }
+  return true;
+}
