diff --git a/src/graphics/vulkan/render_target_cache_native_sized.cpp b/src/graphics/vulkan/render_target_cache_native_sized.cpp
new file mode 100644
--- /dev/null
+++ b/src/graphics/vulkan/render_target_cache_native_sized.cpp
@@ -0,0 +1,397 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+// [rexglue-native] SDK 0310 (draft, UNTESTED): right-sized native render
+// targets (native_render_targets_right_sized, with native_render_targets).
+// The EDRAM emulation makes every host render target as tall as the EDRAM
+// below its base can hold (GetRenderTargetHeight: a 1920-wide one 2736 rows,
+// a 1280-wide one 4096), since the EDRAM's tiles may be aliased by any render
+// target. Native render targets don't alias, so each one only needs the rows
+// the game actually uses:
+// - made: the rows the draw it's made for may write (its scissor, and with
+//   clipping its viewport: the host doesn't draw lower), rounded up to 64;
+// - made taller (never shorter) when a later draw (every render target bound,
+//   since the framebuffer is as tall as its shortest attachment), a native
+//   resolve or a resolve clear needs more: a taller image of the same key is
+//   made, the old rows copied into it (vkCmdCopyImage) and the new ones
+//   cleared to what a new native render target starts with (0301), it's
+//   swapped into the render target object (pointers to it stay valid), and the
+//   old image and every framebuffer (they reference the old views) are
+//   destroyed once the GPU is done with them.
+// EDRAM-path resolves in native mode (the fallbacks) dump only tiles a render
+// target owns, and ownership never goes below what its draws and clears
+// asked for, so their rows are always there.
+// Not right-sized (made at the full height as without the setting): MSAA
+// render targets, formats the device can't copy, and anything with the
+// setting off. Without native_render_targets nothing here runs.
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include <rex/assert.h>
+#include <rex/cvar.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/graphics/vulkan/deferred_command_buffer.h>
+#include <rex/graphics/vulkan/render_target_cache.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/ui/vulkan/util.h>
+
+// Read at the render target cache's Initialize (like native_render_targets).
+REXCVAR_DEFINE_BOOL(native_render_targets_right_sized, false, "GPU",
+                    "With native_render_targets: each render target without MSAA is made only as "
+                    "tall as the game's draws, resolves and clears of it need (made taller, its "
+                    "contents copied, when more is needed) instead of the whole height of the "
+                    "EDRAM below its base: less graphics card memory, the same pictures. Read at "
+                    "start")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::vulkan {
+
+namespace {
+// Guest pixel rows right-sized render targets are made in multiples of (4 EDRAM
+// tile rows): a 1013-row 1080p view takes 1024, a 720-row one 768.
+constexpr uint32_t kNativeRowsGranularity = 64;
+// Lines logged about made and grown render targets, at most.
+constexpr uint32_t kNativeRowsLogLines = 128;
+}  // namespace
+
+void VulkanRenderTargetCache::InitializeNativeRightSized() {
+  native_right_sized_ = false;
+  native_rows_wanted_ = 0;
+  native_rows_growing_ = false;
+  native_rows_transfer_formats_.clear();
+  native_rows_bytes_ = 0;
+  native_rows_bytes_full_ = 0;
+  native_rows_log_lines_ = 0;
+  if (!IsNativeRenderTargets() || GetPath() != Path::kHostRenderTargets ||
+      !REXCVAR_GET(native_render_targets_right_sized) || !native_memory_) {
+    return;
+  }
+  if (!native_draw_extent_estimator_) {
+    native_draw_extent_estimator_ =
+        std::make_unique<DrawExtentEstimator>(register_file(), *native_memory_);
+  }
+  native_right_sized_ = true;
+  REXGPU_INFO(
+      "VulkanRenderTargetCache: native render targets only as tall as used "
+      "(native_render_targets_right_sized)");
+}
+
+void VulkanRenderTargetCache::ShutdownNativeRightSized() {
+  // Shutdown is called with the GPU done with everything.
+  DestroyRetiredNativeRenderTargets(UINT64_MAX);
+  native_right_sized_ = false;
+  native_rows_wanted_ = 0;
+  native_rows_growing_ = false;
+}
+
+uint32_t VulkanRenderTargetCache::GetRenderTargetRows(const RenderTarget& render_target) const {
+  const uint32_t rows = static_cast<const VulkanRenderTarget&>(render_target).native_rows();
+  if (rows) {
+    return rows;
+  }
+  const RenderTargetKey key = render_target.key();
+  return GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples);
+}
+
+bool VulkanRenderTargetCache::IsNativeTransferFormat(VkFormat format) {
+  if (format == VK_FORMAT_UNDEFINED) {
+    return false;
+  }
+  for (const auto& [known_format, supported] : native_rows_transfer_formats_) {
+    if (known_format == format) {
+      return supported;
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  VkFormatProperties properties;
+  ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(), format, &properties);
+  constexpr VkFormatFeatureFlags kNeeded =
+      VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+  const bool supported = (properties.optimalTilingFeatures & kNeeded) == kNeeded;
+  native_rows_transfer_formats_.emplace_back(format, supported);
+  if (!supported) {
+    REXGPU_INFO(
+        "native_render_targets_right_sized: Vulkan format {} can't be copied, its render targets "
+        "are made at the full height",
+        uint32_t(format));
+  }
+  return supported;
+}
+
+uint32_t VulkanRenderTargetCache::GetNativeRowsToCreate(RenderTargetKey key) {
+  if (!native_right_sized_ || key.msaa_samples != xenos::MsaaSamples::k1X) {
+    return 0;
+  }
+  const VkFormat format = key.is_depth ? GetDepthVulkanFormat(key.GetDepthFormat())
+                                       : GetColorVulkanFormat(key.GetColorFormat());
+  if (!IsNativeTransferFormat(format)) {
+    return 0;
+  }
+  const uint32_t full_rows = GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples);
+  return std::min(full_rows,
+                  rex::align(std::max(native_rows_wanted_, uint32_t(1)), kNativeRowsGranularity));
+}
+
+uint32_t VulkanRenderTargetCache::GetNativeDrawRows(bool is_rasterization_done,
+                                                    reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                    uint32_t normalized_color_mask,
+                                                    const Shader& vertex_shader) {
+  // What the base Update binds render targets for.
+  if (!is_rasterization_done || !native_draw_extent_estimator_ ||
+      !register_file().Get<reg::RB_SURFACE_INFO>().surface_pitch ||
+      (!normalized_depth_control.z_enable && !normalized_depth_control.stencil_enable &&
+       !normalized_color_mask)) {
+    return 0;
+  }
+  // Only the hard bounds, never the estimate from the vertices on the CPU
+  // (execute_unclipped_draw_vs_on_cpu): the host draws no lower than its
+  // scissor, which is the guest's, and with clipping than the viewport.
+  return native_draw_extent_estimator_->EstimateMaxY(false, vertex_shader);
+}
+
+bool VulkanRenderTargetCache::EnsureNativeRenderTargetsRows(RenderTarget* const* render_targets,
+                                                            uint32_t count, uint32_t rows) {
+  for (uint32_t i = 0; i < count; ++i) {
+    if (!EnsureNativeRenderTargetRows(render_targets[i], rows, "a draw")) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool VulkanRenderTargetCache::EnsureNativeRenderTargetRows(RenderTarget* render_target,
+                                                           uint32_t rows, const char* reason) {
+  if (!native_right_sized_ || !render_target) {
+    return true;
+  }
+  auto& vulkan_rt = *static_cast<VulkanRenderTarget*>(render_target);
+  const uint32_t old_rows = vulkan_rt.native_rows();
+  // Made at the full height (not right-sized), or tall enough.
+  if (!old_rows || rows <= old_rows) {
+    return true;
+  }
+  const RenderTargetKey key = vulkan_rt.key();
+  const uint32_t full_rows = GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples);
+  if (old_rows >= full_rows) {
+    return true;
+  }
+  const uint32_t new_rows = std::min(full_rows, rex::align(rows, kNativeRowsGranularity));
+
+  // The render pass the command processor may be in uses a framebuffer
+  // dropped below.
+  command_processor_.SubmitBarriers(true);
+
+  // A render target of the same key, as tall as needed, made the usual way;
+  // only its image (views, descriptor set) is kept, swapped in below.
+  const uint32_t rows_wanted = native_rows_wanted_;
+  native_rows_wanted_ = new_rows;
+  native_rows_growing_ = true;
+  RenderTarget* const taller_base = CreateRenderTarget(key);
+  native_rows_growing_ = false;
+  native_rows_wanted_ = rows_wanted;
+  if (!taller_base) {
+    REXGPU_ERROR(
+        "native_render_targets_right_sized: couldn't make {} {} rows tall (for {}; it has {})",
+        key.GetDebugName(), new_rows, reason, old_rows);
+    return false;
+  }
+  // CreateRenderTarget queued it for the initial clear of new native render
+  // targets: not this one.
+  if (!native_initial_clears_.empty() && native_initial_clears_.back() == taller_base) {
+    native_initial_clears_.pop_back();
+  }
+  auto& taller = *static_cast<VulkanRenderTarget*>(taller_base);
+  if (taller.native_rows() != new_rows) {
+    // Not made right-sized after all (unexpected): never used, nothing to wait for.
+    REXGPU_ERROR("native_render_targets_right_sized: {} was made {} rows tall, not {}",
+                 key.GetDebugName(), GetRenderTargetRows(taller), new_rows);
+    delete taller_base;
+    return false;
+  }
+
+  // Not cleared yet (made since the last initial clears): nothing to copy, the
+  // initial clear clears the taller image as a whole.
+  const bool clear_pending =
+      std::find(native_initial_clears_.cbegin(), native_initial_clears_.cend(), render_target) !=
+      native_initial_clears_.cend();
+  const VkImageSubresourceRange subresource_range = ui::vulkan::util::InitializeSubresourceRange(
+      key.is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                   : VK_IMAGE_ASPECT_COLOR_BIT);
+  if (!clear_pending) {
+    command_processor_.PushImageMemoryBarrier(
+        vulkan_rt.image(), subresource_range, vulkan_rt.current_stage_mask(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, vulkan_rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT,
+        vulkan_rt.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    command_processor_.PushImageMemoryBarrier(
+        taller.image(), subresource_range, 0, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    command_processor_.SubmitBarriers(true);
+    VkImageCopy* region = command_processor_.deferred_command_buffer().CmdCopyImageEmplace(
+        vulkan_rt.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, taller.image(),
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1);
+    region->srcSubresource.aspectMask = subresource_range.aspectMask;
+    region->srcSubresource.mipLevel = 0;
+    region->srcSubresource.baseArrayLayer = 0;
+    region->srcSubresource.layerCount = 1;
+    region->srcOffset.x = 0;
+    region->srcOffset.y = 0;
+    region->srcOffset.z = 0;
+    region->dstSubresource = region->srcSubresource;
+    region->dstOffset = region->srcOffset;
+    region->extent.width = key.GetWidth() * draw_resolution_scale_x();
+    region->extent.height = old_rows * draw_resolution_scale_y();
+    region->extent.depth = 1;
+  }
+
+  // From here on the render target holds the taller image; `taller` holds the
+  // old one until the GPU is done with this submission.
+  vulkan_rt.SwapNativeImage(taller);
+  if (!clear_pending) {
+    vulkan_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  }
+  native_retired_render_targets_.emplace_back(command_processor_.GetCurrentSubmission(), &taller);
+  // [rexglue-native] SDK 0309's resolve records: not refilled from a moved
+  // image (they'd be right, the contents are copied, but this keeps it simple).
+  vulkan_rt.BumpNativeContentsGeneration();
+  RetireNativeFramebuffers();
+  native_rows_bytes_ += GetNativeRowsBytes(key, new_rows) - GetNativeRowsBytes(key, old_rows);
+
+  if (!clear_pending) {
+    // The rows it didn't have hold what a new native render target starts
+    // with (PerformNativeInitialClears), as in a full-height one where nothing
+    // was drawn: color 0, depth 1.0, stencil 0.
+    uint64_t clear_value = 0;
+    if (key.is_depth) {
+      uint32_t depth_one = key.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24FS8
+                               ? xenos::Float32To20e4(1.0f, false)
+                               : uint32_t(0xFFFFFF);
+      clear_value = uint64_t(depth_one) << 8;
+    }
+    Transfer::Rectangle rectangle;
+    rectangle.x_pixels = 0;
+    rectangle.y_pixels = old_rows;
+    rectangle.width_pixels = key.GetWidth();
+    rectangle.height_pixels = new_rows - old_rows;
+    const std::vector<Transfer> no_transfers;
+    PerformTransfersAndResolveClears(1, &render_target, &no_transfers, &clear_value, &rectangle);
+  }
+
+  LogNativeRows(key, old_rows, new_rows, reason);
+  return true;
+}
+
+uint32_t VulkanRenderTargetCache::GetNativeFramebufferRows(
+    RenderPassKey render_pass_key, const RenderTarget* const* depth_and_color_render_targets) const {
+  uint32_t rows = UINT32_MAX;
+  uint32_t render_targets_remaining = render_pass_key.depth_and_color_used;
+  uint32_t rt_index;
+  while (rex::bit_scan_forward(render_targets_remaining, &rt_index)) {
+    render_targets_remaining &= ~(uint32_t(1) << rt_index);
+    const RenderTarget* render_target = depth_and_color_render_targets[rt_index];
+    if (render_target) {
+      rows = std::min(rows, GetRenderTargetRows(*render_target));
+    }
+  }
+  return rows;
+}
+
+void VulkanRenderTargetCache::RetireNativeFramebuffers() {
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  for (const auto& framebuffer_pair : framebuffers_) {
+    if (framebuffer_pair.second.framebuffer != VK_NULL_HANDLE) {
+      native_retired_framebuffers_.emplace_back(submission, framebuffer_pair.second.framebuffer);
+    }
+  }
+  framebuffers_.clear();
+  last_update_framebuffer_ = nullptr;
+}
+
+void VulkanRenderTargetCache::DestroyRetiredNativeRenderTargets(uint64_t completed_submission) {
+  if (native_retired_framebuffers_.empty() && native_retired_render_targets_.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // Framebuffers first: they reference the views.
+  while (!native_retired_framebuffers_.empty() &&
+         native_retired_framebuffers_.front().first <= completed_submission) {
+    dfn.vkDestroyFramebuffer(device, native_retired_framebuffers_.front().second, nullptr);
+    native_retired_framebuffers_.pop_front();
+  }
+  while (!native_retired_render_targets_.empty() &&
+         native_retired_render_targets_.front().first <= completed_submission) {
+    // Its destructor destroys the old image, its views and frees its
+    // descriptor set.
+    delete native_retired_render_targets_.front().second;
+    native_retired_render_targets_.pop_front();
+  }
+}
+
+uint64_t VulkanRenderTargetCache::GetNativeRowsBytes(RenderTargetKey key, uint32_t rows) const {
+  // 4 bytes a pixel (8 for 64bpp color, 5 for 32-bit float depth with stencil).
+  uint64_t bytes_per_pixel = 4;
+  if (key.is_depth) {
+    if (GetDepthVulkanFormat(key.GetDepthFormat()) == VK_FORMAT_D32_SFLOAT_S8_UINT) {
+      bytes_per_pixel = 5;
+    }
+  } else if (key.Is64bpp()) {
+    bytes_per_pixel = 8;
+  }
+  return uint64_t(key.GetWidth()) * draw_resolution_scale_x() * rows * draw_resolution_scale_y() *
+         bytes_per_pixel;
+}
+
+void VulkanRenderTargetCache::NoteNativeRenderTargetMade(RenderTargetKey key, uint32_t rows) {
+  // A taller image for an existing one is noted by EnsureNativeRenderTargetRows.
+  if (!rows || native_rows_growing_) {
+    return;
+  }
+  native_rows_bytes_ += GetNativeRowsBytes(key, rows);
+  native_rows_bytes_full_ +=
+      GetNativeRowsBytes(key, GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples));
+  LogNativeRows(key, 0, rows, "a draw or a clear");
+}
+
+void VulkanRenderTargetCache::LogNativeRows(RenderTargetKey key, uint32_t old_rows,
+                                            uint32_t new_rows, const char* reason) {
+  if (native_rows_log_lines_ >= kNativeRowsLogLines) {
+    return;
+  }
+  ++native_rows_log_lines_;
+  const uint32_t full_rows = GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples);
+  const double mib = 1.0 / (1024.0 * 1024.0);
+  const char* last = native_rows_log_lines_ >= kNativeRowsLogLines ? " (no more of these lines)" : "";
+  if (old_rows) {
+    REXGPU_INFO(
+        "native_render_targets_right_sized: {} grown from {} to {} rows for {} (full height {}); "
+        "right-sized render targets {:.1f} MiB, {:.1f} MiB at full height{}",
+        key.GetDebugName(), old_rows, new_rows, reason, full_rows,
+        double(native_rows_bytes_) * mib, double(native_rows_bytes_full_) * mib, last);
+  } else {
+    REXGPU_INFO(
+        "native_render_targets_right_sized: {} made {}x{} for {} (full height {}); right-sized "
+        "render targets {:.1f} MiB, {:.1f} MiB at full height{}",
+        key.GetDebugName(), key.GetWidth(), new_rows, reason, full_rows,
+        double(native_rows_bytes_) * mib, double(native_rows_bytes_full_) * mib, last);
+  }
+}
