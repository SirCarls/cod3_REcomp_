+// [acct2-cod4] 0315: on a PC every VDP datagram travels as plain UDP, so one that a VDP socket sent can reach a
+// plain UDP socket, which a 360 never lets happen, and that socket's reader takes the VDP header (the 2-byte game
+// data length) for the start of the packet. Call of Duty 4's system link: the host answers the game browser's
+// query from its VDP socket, and the browser read the "infoResponse" as a sequenced packet ("Got msg sequence ...
+// but connstate (0) is < CA_CONNECTED"). Only an out-of-band datagram is treated: exactly a 2-byte length equal to
+// what follows it, then FF FF FF FF; it reaches a plain UDP socket without the header.
+bool VdpHeaderOnOutOfBand(const uint8_t* data, uint32_t length) {
+  if (!data || length < 6) {
+    return false;
+  }
+  return memory::load_and_swap<uint16_t>(data) == length - 2 && data[2] == 0xFF && data[3] == 0xFF &&
+         data[4] == 0xFF && data[5] == 0xFF;
+}
+
+// [acct2-cod4] 0315: logs the first header taken off for each socket.
+void NoteVdpHeaderTakenOff(uint32_t socket_handle, uint32_t port) {
+  static std::mutex mutex;
+  static std::set<uint32_t> noted;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (noted.insert(socket_handle).second) {
+    REXKRNL_INFO(
+        "XNet: socket {:08X} (port {}): an out-of-band datagram from a VDP socket reached this plain UDP socket; "
+        "its VDP header is taken off (logged once per socket)",
+        socket_handle, port);
+  }
+}
+
