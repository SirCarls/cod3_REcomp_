+  if (others.empty()) return false;
+  SDL_QuitSubSystem(SDL_INIT_AUDIO);
+  sdl_initialized_ = false;
+  if (SDL_WasInit(SDL_INIT_AUDIO)) {  // another user keeps SDL's audio up: its driver stays
+    sdl_initialized_ = SDL_InitSubSystem(SDL_INIT_AUDIO);
+    return false;
+  }
+  for (const auto& name : others) {
