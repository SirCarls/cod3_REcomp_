+// [rexglue-native-audio] 2026-11-16 (0316) The frames SubmitFrame took without a stream get their permits back here,
+// one a frame period (5.33 ms) as a device would take them, so the game's audio keeps its pace. Not in SubmitFrame:
+// the kernel's global lock is held around it, and a sleep there (the old no-stream path) held up every guest thread
+// that needs that lock (measured: "global lock 73% (held by Audio Worker)").
+void SDLAudioDriver::DropFrames() {
+  constexpr uint64_t kFrameUs = 1000000ull * channel_samples_ / frame_frequency_;
+  const uint32_t pending = dropped_frames_.load(std::memory_order_acquire);
+  if (!pending) {
+    drop_clock_us_ = 0;
+    return;
+  }
+  const uint64_t now_us = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+  if (!drop_clock_us_) drop_clock_us_ = now_us;
+  const uint64_t due = (now_us - drop_clock_us_) / kFrameUs;
+  if (!due) return;
+  const uint32_t n = static_cast<uint32_t>(std::min<uint64_t>(due, pending));
+  dropped_frames_.fetch_sub(n, std::memory_order_acq_rel);
+  drop_clock_us_ = n < due ? now_us : drop_clock_us_ + n * kFrameUs;
+  semaphore_->Release(static_cast<int32_t>(n), nullptr);
 }
 
