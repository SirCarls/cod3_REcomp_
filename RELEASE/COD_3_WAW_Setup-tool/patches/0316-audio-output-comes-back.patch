+// [rexglue-native-audio] 2026-11-16 (0316) The watcher thread: CheckDevice every kWatchMs.
+void SDLAudioDriver::Watch() {
+  std::unique_lock<std::mutex> lock(watcher_mutex_);
+  while (!watcher_stop_) {
+    // lost_ is the watcher's own (CheckDevice and TryReopen run here; Initialize set it before this thread began).
+    const bool dropping = lost_ || dropped_frames_.load(std::memory_order_relaxed) != 0;
+    watcher_cv_.wait_for(lock, std::chrono::milliseconds(dropping ? kDropTickMs : kWatchMs));
+    if (watcher_stop_) break;
+    lock.unlock();
+    DropFrames();
+    const uint64_t now = SDL_GetTicks();
+    if (now >= next_check_ms_) {
+      next_check_ms_ = now + kWatchMs;
+      CheckDevice();
+    }
+    lock.lock();
+  }
+}
