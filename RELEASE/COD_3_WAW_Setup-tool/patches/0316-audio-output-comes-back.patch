+// [rexglue-native-audio] 2026-11-16 (0316) One try to get an output while there is none: SDL's audio started (if it
+// wasn't), the device audio_device names or the system default, and every fifth try SDL's other drivers too.
+// Called with stream_mutex_ held.
+void SDLAudioDriver::TryReopen(uint64_t now) {
+  ++retries_;
+  next_retry_ms_ = now + (now - lost_since_ms_ < 30000 ? kRetryMs : kRetrySlowMs);
+  bool opened = false;
+  quiet_open_ = true;
+  if (StartSdl()) {
+    const auto devices = PlaybackDevices();
+    const std::string wanted = WantedDevice();
+    const SDL_AudioDeviceID device = FindPlaybackDevice(devices, wanted);
+    opened_on_ = device;
+    opened = OpenStream(device) || (device && OpenStream(0));
+    if (!opened && retries_ % 5 == 1 && OpenWithFallback(0)) {
+      opened = true;
+      opened_on_ = 0;  // another driver's default (its device ids are its own)
+    }
+    if (opened) {
+      const auto now_listed = PlaybackDevices();
+      last_default_ = DefaultDeviceName(now_listed);
+      for (const auto& listed : now_listed) first_listed_.emplace(listed.name, now);
+    }
+  }
+  quiet_open_ = false;
+  if (opened) {
+    REXAPU_INFO("audio: sound output open after {:.1f} s without one ({} tr{})",
+                double(now - lost_since_ms_) / 1000.0, retries_, retries_ == 1 ? "y" : "ies");
+    retries_ = 0;
+    lost_ = false;
+  } else if (now >= next_retry_log_ms_) {
+    const char* sdl_driver = sdl_initialized_ ? SDL_GetCurrentAudioDriver() : nullptr;
+    REXAPU_WARN("audio: still no sound output after {:.0f} s ({} tries; SDL driver {}); trying again every {} s",
+                double(now - lost_since_ms_) / 1000.0, retries_, sdl_driver ? sdl_driver : "none",
+                (now - lost_since_ms_ < 30000 ? kRetryMs : kRetrySlowMs) / 1000);
+    next_retry_log_ms_ = now + 60000;
+  }
+}
