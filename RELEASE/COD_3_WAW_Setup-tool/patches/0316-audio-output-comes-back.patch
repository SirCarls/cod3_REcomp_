+// [rexglue-native-audio] 2026-11-16 (0316) SDL's audio subsystem, once. Its own driver order (Linux: PipeWire,
+// PulseAudio, ALSA, sndio; Windows: WASAPI, DirectSound) or SDL_AUDIO_DRIVER; it fails when none starts (no sound
+// system at all, or one that isn't up yet). Called with stream_mutex_ held.
+bool SDLAudioDriver::StartSdl() {
+  if (sdl_initialized_) return true;
+  if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+    if (!init_error_logged_) {
+      REXAPU_ERROR("SDL_InitSubSystem(SDL_INIT_AUDIO) failed: {} (no sound system answered; tried again while "
+                   "the game runs)", SDL_GetError());
+      init_error_logged_ = true;
+    }
+    return false;
+  }
+  sdl_initialized_ = true;
+  if (init_error_logged_) {
+    const char* sdl_driver = SDL_GetCurrentAudioDriver();
+    REXAPU_INFO("audio: SDL's sound system started ({})", sdl_driver ? sdl_driver : "?");
+    init_error_logged_ = false;
+  }
+  return true;
+}
