+// [rexglue-native-audio] 2026-11-16 (0316) The stream is closed and the frames queued for it are given back to the
+// guest's audio (their semaphore places): without that the guest's sound thread waited for a device that would
+// never take them, and stayed silent. Called with stream_mutex_ held.
+void SDLAudioDriver::LoseStream() {
+  CloseStream();  // have_stream_ false first: SubmitFrame queues nothing more (it asks under frames_mutex_)
+  uint32_t given_back = 0;
+  {
+    std::unique_lock<std::mutex> guard(frames_mutex_);
+    while (!frames_queued_.empty()) {
+      frames_unused_.push(frames_queued_.front());
+      frames_queued_.pop();
+      ++given_back;
+    }
+    queued_count_.store(0, std::memory_order_relaxed);
+  }
+  if (given_back) semaphore_->Release(static_cast<int32_t>(given_back), nullptr);
+  UpdateCurrentDevice();
+}
