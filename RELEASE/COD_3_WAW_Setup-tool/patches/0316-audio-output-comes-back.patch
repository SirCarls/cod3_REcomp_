-  return device && OpenStream(0);
+  if (device || !sdl_initialized_) return false;
+  const char* forced = SDL_getenv("SDL_AUDIO_DRIVER");
+  if (forced && *forced) return false;
+  const char* current = SDL_GetCurrentAudioDriver();
+  const std::string first = current ? current : "";
+  std::vector<std::string> others;
+  for (int i = 0, n = SDL_GetNumAudioDrivers(); i < n; ++i) {
+    const char* name = SDL_GetAudioDriver(i);
+    if (name && first != name && std::strcmp(name, "dummy") != 0 && std::strcmp(name, "disk") != 0) {
+      others.emplace_back(name);
+    }
