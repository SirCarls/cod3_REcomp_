+/**
+ * @file        rex/graphics/pipeline/texture/capture.h
+ *
+ * @brief       Texture capture: the textures a game draws with, saved as the
+ *              files an HD texture pack is made from.
+ *
+ * Why: an HD pack (replacement.h) needs every texture's key and picture. For
+ * Call of Duty 3 the ripper reads them from the game's files; for the other
+ * Xbox 360 games on this SDK (World at War, Call of Duty 2, Call of Duty 4)
+ * no ripper reads their textures yet. With `texture_capture_path` set, the
+ * texture cache saves each texture a pack could replace, the first time the
+ * game uses it, so playing the game collects its textures. The setup tool
+ * then turns them into pictures, upscales them and packs them, exactly as it
+ * does Call of Duty 3's ripped textures.
+ *
+ * What is saved, into the folder `texture_capture_path` names:
+ *
+ *  - `<key>.dds`: the guest texture's base level, in the pack's own layout
+ *    (the rows of blocks ComputeKey hashes: BC1/BC2/BC3/BC5 for k_DXT1,
+ *    k_DXT2_3, k_DXT4_5 and k_DXN, 32-bit B, G, R, A texels for k_8_8_8_8),
+ *    with a legacy DDS header and no mips. So the picture is exactly the
+ *    data the key is the hash of, and the pack built from it matches.
+ *  - `captured.tsv`: one line per file,
+ *        <key>\t<width>\t<height>\t<xenos_format>\t<file>
+ *    the first five columns of a pack's index.tsv. Lines are only appended;
+ *    keys already in the file are read at start and never saved again, so
+ *    the folder grows over several sessions without repeats.
+ *
+ * Only textures a pack could replace are saved (TextureCache::
+ * IsReplacementCandidate, and not data the GPU wrote, such as render
+ * targets: ComputeReplacementKey refuses those). Saving stops at
+ * `texture_capture_limit_mb` of files in the folder, so a long session can't
+ * fill the disk. Any error is logged once and turns capture off for the
+ * session; the game itself is never affected. Off by default.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics::texture_capture {
+
+// Whether capture is on: `texture_capture_path` is set and nothing has gone
+// wrong yet. Cheap; the texture cache asks it for every texture it creates.
+bool Enabled();
+
+// Saves one texture, unless its key was saved before or the size limit is
+// reached. `blocks` and `size`: the base level as ComputeKey leaves it in its
+// scratch (rows of blocks without padding, byte-swapped). Called on the GPU
+// thread; also safe from any other thread.
+void Capture(uint64_t key, xenos::TextureFormat format, uint32_t width, uint32_t height,
+             const uint8_t* blocks, size_t size);
+
+// The DDS header (with its "DDS " magic: 128 bytes) for a base level of this
+// format and size, or an empty string for a format a pack can't hold. For
+// tests, and used by Capture.
+std::string MakeDdsHeader(xenos::TextureFormat format, uint32_t width, uint32_t height,
+                          size_t data_size);
+
+}  // namespace rex::graphics::texture_capture
