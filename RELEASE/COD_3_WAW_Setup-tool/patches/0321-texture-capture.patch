--- /dev/null
+++ b/src/graphics/pipeline/texture/capture.cpp
@@ -0,0 +1,256 @@
+/**
+ * @file        graphics/pipeline/texture/capture.cpp
+ * @brief       Texture capture: see rex/graphics/pipeline/texture/capture.h.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/graphics/pipeline/texture/capture.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string_view>
+#include <system_error>
+#include <unordered_set>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/graphics/pipeline/texture/replacement.h>
+#include <rex/logging.h>
+
+// Read once, the first time a texture is created: set it at start (on the
+// command line or in the game's settings file).
+REXCVAR_DEFINE_STRING(texture_capture_path, "", "GPU",
+                      "Folder to save the textures the game draws with (DDS files and "
+                      "captured.tsv), for making an HD texture pack. Empty = off")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+REXCVAR_DEFINE_INT32(texture_capture_limit_mb, 8192, "GPU",
+                     "Texture capture stops once its folder holds this many MB of files")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::texture_capture {
+
+namespace {
+
+constexpr std::string_view kListName = "captured.tsv";
+
+// Everything below is guarded by `mutex`; `enabled` is read without it (a
+// stale "true" only means one more call that returns early under the lock).
+struct State {
+  std::mutex mutex;
+  std::atomic<bool> enabled{false};
+  bool started = false;
+  std::filesystem::path folder;
+  std::unordered_set<uint64_t> saved;
+  uint64_t bytes = 0;
+  uint64_t limit = 0;
+  bool limit_logged = false;
+  uint32_t saved_this_session = 0;
+};
+
+State& GetState() {
+  static State state;
+  return state;
+}
+
+void PutU32(std::string& out, size_t offset, uint32_t value) {
+  // DDS is little-endian whatever the host.
+  for (int i = 0; i < 4; ++i) {
+    out[offset + i] = char((value >> (8 * i)) & 0xFF);
+  }
+}
+
+uint32_t FourCC(const char (&code)[5]) {
+  return uint32_t(uint8_t(code[0])) | uint32_t(uint8_t(code[1])) << 8 |
+         uint32_t(uint8_t(code[2])) << 16 | uint32_t(uint8_t(code[3])) << 24;
+}
+
+// Turns capture off for the session, with one log line saying why.
+void Stop(State& s, const std::string& why) {
+  s.enabled = false;
+  REXGPU_WARN("Texture capture: {}; capture is off for this session ({} textures saved)", why,
+              s.saved_this_session);
+}
+
+// Reads the keys already in captured.tsv and the size of the folder's files,
+// so a new session adds only textures not saved before.
+bool Start(State& s) {
+  s.started = true;
+  const std::string path = REXCVAR_GET(texture_capture_path);
+  if (path.empty()) {
+    return false;
+  }
+  s.folder = rex::to_path(path);
+  std::error_code ec;
+  std::filesystem::create_directories(s.folder, ec);
+  if (ec || !std::filesystem::is_directory(s.folder, ec)) {
+    REXGPU_WARN("Texture capture: can't make the folder {}; capture is off", path);
+    return false;
+  }
+  // At least 16 MB, so a mistyped 0 or negative value doesn't save nothing silently.
+  s.limit = uint64_t(std::max<int32_t>(REXCVAR_GET(texture_capture_limit_mb), 16)) << 20;
+  for (const auto& entry : std::filesystem::directory_iterator(s.folder, ec)) {
+    std::error_code size_ec;
+    if (entry.is_regular_file(size_ec)) {
+      uint64_t size = entry.file_size(size_ec);
+      if (!size_ec) {
+        s.bytes += size;
+      }
+    }
+  }
+  std::ifstream list(s.folder / std::string(kListName));
+  std::string line;
+  while (std::getline(list, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();  // CR LF (a list edited on Windows)
+    if (line.empty() || line[0] == '#') {
+      continue;
+    }
+    uint64_t key;
+    if (texture_replacement::ParseKey(std::string_view(line).substr(0, line.find('\t')), key)) {
+      s.saved.insert(key);
+    }
+  }
+  REXGPU_INFO("Texture capture: saving new textures to {} ({} saved before, {} MB of {} MB used)",
+              path, s.saved.size(), s.bytes >> 20, s.limit >> 20);
+  return true;
+}
+
+}  // namespace
+
+std::string MakeDdsHeader(xenos::TextureFormat format, uint32_t width, uint32_t height,
+                          size_t data_size) {
+  // DDS_HEADER flags and the pixel format, from the DDS file format's
+  // documentation: CAPS | HEIGHT | WIDTH | PIXELFORMAT, plus LINEARSIZE for
+  // compressed data or PITCH for uncompressed.
+  constexpr uint32_t kCaps = 0x1, kHeight = 0x2, kWidth = 0x4, kPitch = 0x8, kPixelFormat = 0x1000,
+                     kLinearSize = 0x80000;
+  constexpr uint32_t kPfFourCC = 0x4, kPfRgb = 0x40, kPfAlphaPixels = 0x1;
+  constexpr uint32_t kCapsTexture = 0x1000;
+  uint32_t four_cc = 0;
+  switch (format) {
+    case xenos::TextureFormat::k_DXT1:
+      four_cc = FourCC("DXT1");
+      break;
+    case xenos::TextureFormat::k_DXT2_3:
+      four_cc = FourCC("DXT3");
+      break;
+    case xenos::TextureFormat::k_DXT4_5:
+      four_cc = FourCC("DXT5");
+      break;
+    case xenos::TextureFormat::k_DXN:
+      four_cc = FourCC("ATI2");  // BC5, as the pack's DDS files and the ripper name it
+      break;
+    case xenos::TextureFormat::k_8_8_8_8:
+      break;
+    default:
+      return std::string();
+  }
+  std::string out(128, '\0');
+  std::memcpy(out.data(), "DDS ", 4);
+  PutU32(out, 4, 124);  // dwSize
+  if (four_cc) {
+    PutU32(out, 8, kCaps | kHeight | kWidth | kPixelFormat | kLinearSize);
+    PutU32(out, 20, uint32_t(data_size));  // dwPitchOrLinearSize: the level's bytes
+  } else {
+    PutU32(out, 8, kCaps | kHeight | kWidth | kPixelFormat | kPitch);
+    PutU32(out, 20, width * 4);  // dwPitchOrLinearSize: one row's bytes
+  }
+  PutU32(out, 12, height);
+  PutU32(out, 16, width);
+  PutU32(out, 28, 1);  // dwMipMapCount: the base level only
+  // DDS_PIXELFORMAT at 76.
+  PutU32(out, 76, 32);
+  if (four_cc) {
+    PutU32(out, 80, kPfFourCC);
+    PutU32(out, 84, four_cc);
+  } else {
+    // B, G, R, A in memory (replacement.h: the order the guest data has after
+    // the GPU's byte swap), which is what these masks describe.
+    PutU32(out, 80, kPfRgb | kPfAlphaPixels);
+    PutU32(out, 88, 32);
+    PutU32(out, 92, 0x00FF0000);
+    PutU32(out, 96, 0x0000FF00);
+    PutU32(out, 100, 0x000000FF);
+    PutU32(out, 104, 0xFF000000);
+  }
+  PutU32(out, 108, kCapsTexture);
+  return out;
+}
+
+bool Enabled() {
+  State& s = GetState();
+  if (!s.started) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (!s.started) {
+      s.enabled = Start(s);
+    }
+  }
+  return s.enabled;
+}
+
+void Capture(uint64_t key, xenos::TextureFormat format, uint32_t width, uint32_t height,
+             const uint8_t* blocks, size_t size) {
+  State& s = GetState();
+  if (!Enabled() || !blocks || !size) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (!s.enabled || s.saved.count(key)) {
+    return;
+  }
+  const std::string header = MakeDdsHeader(format, width, height, size);
+  if (header.empty()) {
+    return;  // not a format a pack can hold (IsReplacementCandidate already checks this)
+  }
+  if (s.bytes + header.size() + size > s.limit) {
+    if (!s.limit_logged) {
+      s.limit_logged = true;
+      REXGPU_WARN("Texture capture: the folder has reached texture_capture_limit_mb ({} MB); no "
+                  "more textures are saved",
+                  s.limit >> 20);
+    }
+    return;
+  }
+  const std::string file = fmt::format("{:016x}.dds", key);
+  // Written under another name and renamed, so a crash never leaves a short
+  // file under the real name (the setup tool would reject it, but then the key
+  // would never be saved again).
+  const std::filesystem::path final_path = s.folder / file;
+  const std::filesystem::path temp_path = s.folder / (file + ".part");
+  {
+    std::ofstream out(temp_path, std::ios::binary | std::ios::trunc);
+    out.write(header.data(), std::streamsize(header.size()));
+    out.write(reinterpret_cast<const char*>(blocks), std::streamsize(size));
+    if (!out) {
+      Stop(s, "can't write " + rex::path_to_utf8(temp_path));
+      return;
+    }
+  }
+  std::error_code ec;
+  std::filesystem::rename(temp_path, final_path, ec);
+  if (ec) {
+    std::filesystem::remove(temp_path, ec);
+    Stop(s, "can't rename " + rex::path_to_utf8(temp_path));
+    return;
+  }
+  // The list line goes last: a key is listed only once its file is complete.
+  std::ofstream list(s.folder / std::string(kListName), std::ios::binary | std::ios::app);
+  list << fmt::format("{:016x}\t{}\t{}\t{}\t{}\n", key, width, height, uint32_t(format), file);
+  if (!list) {
+    Stop(s, "can't add to " + std::string(kListName));
+    return;
+  }
+  s.saved.insert(key);
+  s.bytes += header.size() + size;
+  ++s.saved_this_session;
+}
+
+}  // namespace rex::graphics::texture_capture
