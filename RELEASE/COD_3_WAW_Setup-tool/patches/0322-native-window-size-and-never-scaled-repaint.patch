+// [cod3 0322]
+bool Window::SetClientPhysicalSize(uint32_t width, uint32_t height) {
+  if (!width || !height || fullscreen_ || !CanApplyState()) {
+    return false;
+  }
+  WindowDestructionReceiver destruction_receiver(this);
+  const bool asked = ApplyNewClientPhysicalSize(width, height);
+  if (destruction_receiver.IsWindowDestroyedOrStateInapplicable()) {
+    return false;
+  }
+  return asked;
+}
