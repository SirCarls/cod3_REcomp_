+// [cod3 0322] SDL window coordinates are physical pixels on Windows and X11 and points on macOS (as in OpenImpl).
+bool WindowSDL::ApplyNewClientPhysicalSize(uint32_t width, uint32_t height) {
+  if (!sdl_window_) {
+    return false;
+  }
+  if (SDL_GetWindowFlags(sdl_window_) &
+      (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MAXIMIZED | SDL_WINDOW_MINIMIZED)) {
+    return false;
+  }
+#if REX_PLATFORM_MAC
+  width = SizeToLogical(width);
+  height = SizeToLogical(height);
+#endif
+  if (!SDL_SetWindowSize(sdl_window_, int(width), int(height))) {
+    REXLOG_WARN("window: the client size {}x{} couldn't be asked for: {}", width, height, SDL_GetError());
+    return false;
+  }
+  return true;
+}
