+      e.shown = true;
+      e.at_ns = now_ns;
+      e.window_ns = kSeenHeldNs;
+    } else if (now_ns >= e.at_ns + e.window_ns) {
+      e.on = false;
+    }
+  }
+
   // Whether a read at `now_ns` shows the press; ends it once it has been
-  // shown and its hold has passed.
+  // shown and its hold has passed. [cod3 0323] The hold runs from the first
+  // read that shows it (at_ns is set there), not from the press.
   static bool Show(Entry& e, uint64_t now_ns) {
-    const bool within = now_ns < e.at_ns + kHoldNs;
-    const bool show = !e.shown || within;
-    e.shown = true;
+    if (!e.shown) {
+      e.shown = true;
+      e.at_ns = now_ns;
+      e.window_ns = kHoldNs;
