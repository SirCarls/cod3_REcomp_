diff --git a/src/system/CMakeLists.txt b/src/system/CMakeLists.txt
index fc46d86..5e241f9 100644
--- a/src/system/CMakeLists.txt
+++ b/src/system/CMakeLists.txt
@@ -54,6 +54,22 @@ add_library(rex::system ALIAS rexruntime)
 add_library(rex::kernel ALIAS rexruntime)
 
 set_target_properties(rexruntime PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS TRUE)
+# MinGW: lld exports every symbol of the DLL automatically except names that
+# start with __imp_, and the kernel exports are named exactly that
+# (__imp__NtClose ...). List those in a .def file, read from the objects just
+# before linking, and keep the automatic export for everything else.
+if(MINGW)
+    if(NOT CMAKE_NM)
+        message(FATAL_ERROR "MinGW build: no nm found (CMAKE_NM); it lists the kernel exports")
+    endif()
+    set(_rex_kernel_def "${CMAKE_CURRENT_BINARY_DIR}/rexruntime_kernel_exports.def")
+    add_custom_command(TARGET rexruntime PRE_LINK
+        COMMAND ${CMAKE_COMMAND} "-DNM=${CMAKE_NM}" "-DOUT=${_rex_kernel_def}"
+                "-DOBJECTS=$<JOIN:$<TARGET_OBJECTS:rexruntime>,|>"
+                -P "${CMAKE_CURRENT_SOURCE_DIR}/mingw_kernel_exports.cmake"
+        VERBATIM)
+    target_link_options(rexruntime PRIVATE "-Wl,--export-all-symbols" "${_rex_kernel_def}")
+endif()
 
 rex_target_pch(rexruntime
     <mutex>
diff --git a/src/system/mingw_kernel_exports.cmake b/src/system/mingw_kernel_exports.cmake
new file mode 100644
index 0000000..b1171b0
--- /dev/null
+++ b/src/system/mingw_kernel_exports.cmake
@@ -0,0 +1,32 @@
+# Writes OUT, a module-definition (.def) file exporting every kernel export
+# (__imp__*) that the object files in OBJECTS ("|"-separated) define.
+# Used by the MinGW build of rexruntime; see CMakeLists.txt.
+string(REPLACE "|" ";" objects "${OBJECTS}")
+# Object files only (TARGET_OBJECTS also lists the precompiled header).
+list(FILTER objects INCLUDE REGEX "\\.(obj|o)$")
+execute_process(COMMAND "${NM}" --extern-only --defined-only ${objects}
+                OUTPUT_VARIABLE listing RESULT_VARIABLE rc ERROR_VARIABLE err)
+if(NOT rc EQUAL 0)
+    message(FATAL_ERROR "nm failed (${rc}): ${err}")
+endif()
+string(REGEX MATCHALL "[0-9a-fA-F]+ [TtDdRrBb] __imp__[A-Za-z0-9_]+" found "${listing}")
+set(names "")
+foreach(line IN LISTS found)
+    string(REGEX REPLACE "^.* " "" name "${line}")
+    list(APPEND names "${name}")
+endforeach()
+list(REMOVE_DUPLICATES names)
+list(SORT names)
+list(LENGTH names count)
+if(count EQUAL 0)
+    message(FATAL_ERROR "No kernel exports (__imp__*) found in the rexruntime objects")
+endif()
+string(REPLACE ";" "\n    " body "${names}")
+set(content "EXPORTS\n    ${body}\n")
+if(EXISTS "${OUT}")
+    file(READ "${OUT}" old)
+endif()
+if(NOT content STREQUAL old)
+    file(WRITE "${OUT}" "${content}")
+endif()
+message(STATUS "rexruntime: ${count} kernel exports listed in ${OUT}")
