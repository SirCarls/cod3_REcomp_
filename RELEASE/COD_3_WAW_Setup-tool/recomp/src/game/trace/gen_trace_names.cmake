# cod3 - decomp trace build: one module's function table for the trace.
#
#   cmake -DIN=generated/<module>/cod3_init.cpp -DOUT=<build>/trace/trace_names_<module>.cpp
#         -P gen_trace_names.cmake
#
# Reads the codegen's PPCFuncMappings lines ("{ 0x820A0098, Broc_Abs },") and
# writes them with the name as text, so the trace knows the guest address and
# name of every function of the module (src/game/trace/trace_abi.h).

if(NOT IN OR NOT OUT)
    message(FATAL_ERROR "usage: cmake -DIN=<cod3_init.cpp> -DOUT=<names.cpp> -P gen_trace_names.cmake")
endif()

set(_entry "^[ \t]*{ (0x[0-9A-Fa-f]+), ([A-Za-z_][A-Za-z0-9_]*) },")
file(STRINGS "${IN}" _lines REGEX "${_entry}")
list(LENGTH _lines _count)
if(_count EQUAL 0)
    message(FATAL_ERROR "gen_trace_names: no function table in ${IN}")
endif()

string(REPLACE ";" "\n" _text "${_lines}")
string(REGEX REPLACE "[ \t]*{ (0x[0-9A-Fa-f]+), ([A-Za-z_][A-Za-z0-9_]*) },[^\n]*" "    {\\1u, \"\\2\"},"
       _text "${_text}")

file(WRITE "${OUT}.tmp"
"// Generated by src/game/trace/gen_trace_names.cmake from the codegen's function table. Do not edit.
#include \"src/game/trace/trace_abi.h\"

namespace cod3::trace {
extern const FunctionName kModuleFunctions[];
extern const uint32_t kModuleFunctionCount;

const FunctionName kModuleFunctions[] = {
${_text}
};
const uint32_t kModuleFunctionCount = ${_count};
}  // namespace cod3::trace
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
