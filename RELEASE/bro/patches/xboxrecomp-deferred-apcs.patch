diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -4516,6 +4516,19 @@ static int bridge_run_io_apcs(uint32_t alertable, uint32_t wait_mode)
     return 1;
 }

+/* [acct2-bro] For a port whose own frame loop stands in for the game's waits: run this thread's deferred file-I/O
+ * APCs now, as an alertable wait would, and leave eax as it was. Returns how many ran. */
+int xbox_RunDeferredIoApcs(void)
+{
+    int n = g_io_apc_count;
+    uint32_t eax = g_eax;
+
+    if (!bridge_run_io_apcs(1, 1))
+        return 0;
+    g_eax = eax;
+    return n;
+}
