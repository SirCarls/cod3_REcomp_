diff --git a/tools/lazy_decode.py b/tools/lazy_decode.py
new file mode 100644
--- /dev/null
+++ b/tools/lazy_decode.py
@@ -0,0 +1,33 @@
+"""Capstone's disasm(), a few instructions at a time.
+
+[Big Red One port, bro/patches/xboxrecomp-lazy-decode.patch, 2026-11-08] Cs.disasm(code, address) decodes every
+instruction in `code`, each with its details, before it hands back the first one. The disassembler's callers that stop
+after a few (a block ends at its jump; a probe stops at the first call) paid for the whole rest of the section or gap
+each time: on Big Red One's default.xbe that was 98 of the disassembly's 99 minutes. lazy_disasm hands back the same
+instructions in the same order, decoded LAZY_CHUNK at a time, so a caller that stops early pays only for what it read.
+"""
+
+LAZY_CHUNK = 32
+MAX_INSTRUCTION = 15    # bytes: the longest x86 instruction
+
+
+def lazy_disasm(cs, code, address, start=0, end=None):
+    """What cs.disasm(code[start:end], address) gives, in order; `address` is code[start]'s.
+
+    Each window holds room for LAZY_CHUNK instructions and one more, so when a window gives fewer than LAZY_CHUNK
+    the next instruction had all of its bytes there and still didn't decode (or the end was reached): where a
+    single cs.disasm call stops too.
+    """
+    end = len(code) if end is None else min(end, len(code))
+    offset = start
+    while offset < end:
+        window = code[offset:min(end, offset + (LAZY_CHUNK + 1) * MAX_INSTRUCTION)]
+        count = 0
+        last = None
+        for insn in cs.disasm(window, address + (offset - start), LAZY_CHUNK):
+            count += 1
+            last = insn
+            yield insn
+        if count < LAZY_CHUNK:
+            return
+        offset = start + (last.address + last.size - address)
